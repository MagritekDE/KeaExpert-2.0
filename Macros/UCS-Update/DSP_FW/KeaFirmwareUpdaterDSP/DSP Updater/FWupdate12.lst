815                        ;---------------------------------------------------------------------------
816                        ; delay_20m --
817                        ; 20.15 ms of delay guarantees that the write cycle has finished.
818                        ;
819                        ; For Write Pulse Width High to extend 150 us requires a minimum of
Freescale Semiconductor DSP56300 Assembler  Version 6.3.28   19-10-17  08:15:42  FWupdate12.asm  Page 6



820                        ; 5100 Icycles for a 33.868 MHz clock.  (29.5 ns/Icycle)
821                        ;
822                        ; the tWC is 20ms, so we just wait long enough here for the
823                        ; write cycle to have started AND finished...
824                        ;
825                        ;---------------------------------------------------------------------------
826                        delay_20m
827       P:00207F 066E90            dor     #110,_l1                          ;110 x 207us = 22.7 ms
                   000006
828       P:002081 44F400            move              #21000,x0
                   005208
829       P:002083 06C420            rep     x0                                ; 207us delay
830       P:002084 000000            nop
831       P:002085 000000            nop
832                        _l1
833       P:002086 00000C            rts
