# Add inputs and outputs from these tool invocations to the build variables 
C_SRCS += \
../lib/DSP.c \
../lib/FPGA.c 

ASM_SRCS += \
../lib/DSPio.asm 

ASM_UPPER_SRCS += \
../lib/IOEQU.ASM 

OBJS += \
./lib/DSP.cln \
./lib/DSPio.cln \
./lib/FPGA.cln \
./lib/IOEQU.cln 


# Each subdirectory must supply rules for building sources it contributes
lib/%.cln: ../lib/%.c
	@echo 'Building file: $<'
	@echo 'Invoking: 56K GCC Compiler'
	g563c -I"C:\Work\DSP\PP_JTAG" -mp-mem-switchtable -mx-memory -c -o  "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

lib/%.cln: ../lib/%.asm
	@echo 'Building file: $<'
	@echo 'Invoking: 56K GCC Assembler'
	g563c -mp-mem-switchtable -mx-memory -c -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

lib/%.cln: ../lib/%.ASM
	@echo 'Building file: $<'
	@echo 'Invoking: 56K GCC Assembler'
	g563c -mp-mem-switchtable -mx-memory -c -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '


