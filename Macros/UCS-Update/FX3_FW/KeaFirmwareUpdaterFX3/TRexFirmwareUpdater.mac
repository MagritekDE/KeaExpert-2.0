################################################################
# Update the FX3 TRex Firmware. Supports both V4 and V5 
################################################################
procedure(TReXFirmwareUpdater, fwFolder, fwName, statusCtrl)
   
   HWver = fx3read("E",0x82,1)

   tStart = time()

   if(HWver[0] == 4)
      :updateTRexFirmwareV4(fwFolder, fwName, statusCtrl)
   elseif(HWver[0] == 5)
      :updateTRexFirmwareV5(fwFolder, fwName, statusCtrl)
   else
      print("Invalid hardware version ($HWver[0]$) - aborting\n")
      return
   endif

   tEnd = time()
   pr ("   Time taken = $tEnd-tStart$\n")
   pr ("\n=== Please restart your Kea now ===\n")
   
endproc()

################################################################
# Update TRex V4
################################################################
procedure(updateTRexFirmwareV4, fwFolder, fwName, statusCtrl)

   # This program will only work with the new FX3 Controller 
   FX3memsize8 = 22000   # actual buffersize is 1024*22 = 22528
   FX3memsize32 = floor(FX3memsize8/4)
   USBTIMEOUT = 6000 #milliseconds

   w = guiwinnr()

   pr "\n   Flashing TRex firmware with file $fwName$."


   fx3timeout(USBTIMEOUT)
   pr "\n   USB timeout increased to $USBTIMEOUT/1000$ s.\n"

    cd(fwFolder)

   # Run Update 
   if(isfile(fwName))

      statusCtrl->text("Reading file ...")

      # TODO check for hardware compatibility
      import1dpar("ab","binary","xyrc","real","fls","short","machine","bigend")
      fwData16 = import1d(fwName) 
      fwSize16 = size(fwData16)
      
      statusCtrl->text("Initialising ...")

      fwData32 = dmatrix(ceil(fwSize16/2))
      fwSize32 = size(fwData32)  # size in 32bit words (long)
      fwSize8 = fwSize32 * 4   # size in no. of bytes
      for(k=0 to size(fwData32)-1)
          fwData32[k] = double(fwData16[k*2])*2^16 + (double(fwData16[k*2+1])&0x0000FFFF)
      next(k)

      fwSize8 = fwSize32 * 4   # size in no. of bytes
      bytesProcessed = 0

      if (fwSize32 > FX3memsize32)
         # Firmware needs to be split in multiple blocks
         oversizeFactor = ceil(fwSize32/FX3memsize32)
         pr "   File size too big. Splitting it in at least $oversizeFactor$ parts.\n"
         fwBlock = :prepareFWblock(fwData32,bytesProcessed,FX3memsize32,fwSize32)
      else
         # FX3 buffer is pretty small so this path is probably not needed
         pr "   WARNING: filesize is smaller than FX3 buffer size. File might be corrupted.\n"
         fwBlock = fwData32
      endif

      blockCount = 1
      
      pr "   Transfering first block to Kea.\n"

      fx3write("i",0,fwBlock)
      #rbtest = fx3read("i",4,1,"double")
      #pr hex(rbtest[0])

      pr "   TReX chipselect low.\n"
      fx3write("u",0x30,[0])
      pr "   Starting FW update with first block.\n   Erasing flash memory\n"
      fx3write("u",0x100,[0])   # start update procedure with first block 
      #pause(0.2)
      updateState = 0
      eraseCnt = 1
      while(updateState < 2)
         pause(.6)
         retval = fx3read("u",0,1)
         #pr "Readback from FX3: update state=$retval[0]$\n"
         updateState = retval[0]

         if(updateState == 0)   # current block not finished yet, wait and request state again
            pause(.05)
            if(eraseCnt == 1)
               statusCtrl->text("Erasing flash .")
               eraseCnt = eraseCnt + 1
            elseif(eraseCnt == 2)
               statusCtrl->text("Erasing flash ..")
               eraseCnt = eraseCnt + 1
            elseif(eraseCnt == 3)
               statusCtrl->text("Erasing flash ...")
               eraseCnt = 1
            endif
          #  pr "." 
         elseif(updateState == 1) # updateState=1: current block done
            blockCount = blockCount + 1
            retval = fx3read("u",1,1)
            #pr retval
            bytesProcessed = bytesProcessed + retval[0] # add processed bytes from last block to total
            #pr bytesProcessed
            # prepare next block
            #nextByte = bytesProcessed+1
            #pr nextByte
            fwBlock = :prepareFWblock(fwData32,bytesProcessed,FX3memsize32,fwSize32)            
            #pr "Transfering block #$blockCount$ to Kea.\n"
            #pr hex(fwBlock[0:4])
            fx3write("i",0,fwBlock)
            #pr "Processing update of block #$blockCount$.\n"

            byteShift = bytesProcessed%4      # data of fwBlock 32bit aligned, processing happens 8bit aligned.
            #pr byteShift
            fx3write("u",0x100,[byteShift])   # start update procedure with current block 
            updateState = 0
            progress = bytesProcessed/fwSize8
            statusCtrl->text("Flashing: $round(progress*100)$% done")
          #  pr "$round(progress*100)$% done.\n"            
         endif
      endwhile
      retval = fx3read("u",1,1)
      #pr retval
      bytesProcessed = bytesProcessed + retval[0] - 1 # add processed bytes from last block to total
      pr "   Update Done after $blockCount$ blocks. $bytesProcessed$ bytes processed.\n"

      TDOdebug = fx3read("u",0xd,1,"double")
      #pr hex(TDOdebug[0])

   endif

   statusCtrl->text("Please restart spectrometer to finalised firmware update")


   fx3timeout(3000)
   pr "   USB timeout set back to 3 s.\n"
    
endproc()



procedure(prepareFWblock, inputData, startAddr8, numWords, fwSize32)

   lastAddr = fwSize32-1
   # inputData word size is 32 bits, outputData word size is 32 bits
   outputData = dmatrix(numWords)
   
   startAddr32 = floor(startAddr8/4)
   #pr startAddr32
   endAddr32 = startAddr32 + numWords - 1
   
   if (endAddr32 > lastAddr)
      pr "   Last block found. Setting endAddr to lastAddr.\n"
      numWords = lastAddr - startAddr32 + 1
      #pr lastAddr
      #pr endAddr32
      #pr numWords
   endif
   
   if(numWords==1)
      outputData = inputData[startAddr32]
      pr "numWords=1\n"
   else
      outputData = inputData[startAddr32:(startAddr32+numWords-1)]
   endif     

endproc(outputData)


################################################################
# Update TRex V5
################################################################

procedure(updateTRexFirmwareV5, fwFolder, fwName, statusCtrl)

   USBTIMEOUT = 6000 #milliseconds
   PAGESIZE = 256 #bytes

   w = guiwinnr()

   pr "\n   Flashing TRex firmware with file $fwName$."

   fx3timeout(USBTIMEOUT)
   pr "\n   USB timeout increased to $USBTIMEOUT/1000$ s.\n"

   cd(fwFolder)

   ext = getext(fwName)
   if(ext != "bin")
      message("Warning!","The filename should be of type '.bin' you have chosen type '$ext$' - abort","warning")
      return
   endif

   # Run Update 
   if(isfile(fwName))

      ## set up Quad-SPI
      :initQuadSpi()
      ## bulk erase
      :bulkErase(statusCtrl)

      # Select data type as binary, big-endian, short integer
      import1dpar("ab","binary","xyrc","real","fls","short","machine","bigend")

      # Read in the data
      fwData16 = import1d(fwName) 
      fwSize16 = size(fwData16)

      fwSize8 = fwSize16 * 2   # size in no. of bytes
      numOfFullBlocks = floor(fwSize8 / PAGESIZE)   # FPGA data fifo size is 256 bytes wide
      #pr numOfFullBlocks
      residualBytes = fwSize8-(numOfFullBlocks*PAGESIZE)
      #pr residualBytes
      currentBlock = matrix(PAGESIZE)
      addr = 0
      for(k=0 to numOfFullBlocks-1)
         for(n=0 to PAGESIZE/2-1)
            currentBlock[2*n]   = (fwData16[k*PAGESIZE/2+n]&0xFF00) / (2^8)
            currentBlock[2*n+1] = (fwData16[k*PAGESIZE/2+n]&0x00FF)
         next(n)
         if(k%1000==0)
            statusCtrl->text("Writing page #$k$ of $numOfFullBlocks$ to addr 0x$hex(addr)$.\n")
         endif
         :writeBlock(addr,currentBlock,PAGESIZE)
         addr = addr + PAGESIZE

      next(k)
      if(residualBytes > 0)
         residualWords = floor(residualBytes/2)-1
         for(n=0 to residualWords-1)
            currentBlock[2*n]   = (fwData16[numOfFullBlocks*PAGESIZE/2+n]&0xFF00) / (2^8)
            currentBlock[2*n+1] = (fwData16[numOfFullBlocks*PAGESIZE/2+n]&0x0000FF)
         next(n)
         if(residualBytes%2 != 0) # if number of bytes is uneven, add last byte
            currentBlock[residualBytes-1] = fwData16[numOfFullBlocks*PAGESIZE/2+residualWords]&0xFF00 / 2^8
         endif
         #pr residualBytes
         #pr hex(currentBlock[0:residualBytes-1])
         :writeBlock(addr,currentBlock,residualBytes)
      endif
   else   
      pr "File $fwName$ not found. Abort.\n"
   endif

   fx3timeout(3000)
   pr "   USB timeout set back to 3 s.\n"
   message("Information","Please restart spectrometer to finalised firmware update","info")

endproc()

######################################################################################
# This procedure initialises the Quad-SPI mode of the flash memory chip and the FPGA.
# After a reset everything is set to single SPI mode. So this has to be called once
# before any other command, since those assume the use of Quad-SPI.
######################################################################################

procedure(initQuadSpi)

   ADDR_CTRLREG    = 0x7000
   CMD_ENABLE_QUAD = 0x0200
   fx3write("e",ADDR_CTRLREG,[CMD_ENABLE_QUAD])   # enable Quad-SPI mode

endproc()

######################################################################################
# This procedure sets the byteCount register of the SPI state machine.
# It has to match the number of bytes loaded in the command FIFO to be send to
# the flash memory over SPI.
######################################################################################

procedure(setByteCount,numOfBytes)

   ADDR_BYTECOUNT  = 0x7002
   fx3write("e",ADDR_BYTECOUNT,[numOfBytes])

endproc()

######################################################################################
# The flash memory need a WRITE_ENABLE command before every write to memory,
# registers or any erase command.
# This procedure has the setByteCount() and startSpiTransfer() included.
######################################################################################

procedure(writeEnable)

   ADDR_FIFO       = 0x7001
   WRITE_ENABLE    = 0x06

   fx3write("e",ADDR_FIFO,[WRITE_ENABLE])
   :setByteCount(1)
   :startSpiTransfer()
endproc()

######################################################################################
# This procedure starts the bulk erase command. The data sheet gives a typical duration
# of 38s and a maximum duration of 114s. It is recommended to poll the flag status register
# to detect the end of the erase progress. For now it is waiting for a fixed amount of time.
######################################################################################

procedure(bulkErase, statusCtrl)

   ADDR_FIFO       = 0x7001
   BULK_ERASE      = 0xC7
   ERASETIME       = 80   #in seconds

   :writeEnable()
   fx3write("e",ADDR_FIFO,[BULK_ERASE])
   :setByteCount(1)
   :startSpiTransfer()
   pr "\nClearing flash memory...\n"
  
   for(k = 1 to 4)
      pause(ERASETIME/5)
      statusCtrl->text("$k*20$% done.")
   next(k)
   
endproc()

######################################################################################
# This procedure starts the SPI transmission to ne Flash memory.
# Before running this a valid command needs to be loaded into the FIFO and
# the correct number of bytes needs to be set in the byteCount register.
######################################################################################

procedure(startSpiTransfer)

   ADDR_CTRLREG    = 0x7000
   CMD_START_TX    = 0x100

   #pr "Run command...\n"
   fx3write("e",ADDR_CTRLREG,[CMD_START_TX])

endproc()

######################################################################################
# This procedure writes the PROGRAM_PAGE command byte to the FIFO, followed by a
# 24 bit starting address and a full page of data (256 bytes).
# Includes setByteCount() and startSpiTransfer().
######################################################################################

procedure(writeBlock,addr,block,numOfBytes)

   ADDR_FIFO         = 0x7001
   CMD_PAGE_PROGRAM  = 0x02
   HEADERSIZE        = 4

   addrByte1 = (addr&0xFF0000) / (2^16)
   addrByte2 = (addr&0x00FF00) / (2^8)
   addrByte3 = (addr&0x0000FF)
   
   :writeEnable()
   fx3write("d",ADDR_FIFO,[CMD_PAGE_PROGRAM])
   fx3write("d",ADDR_FIFO,[addrByte1])   # write adress byte 1 (MSB)
   fx3write("d",ADDR_FIFO,[addrByte2])   # write adress byte 2
   fx3write("d",ADDR_FIFO,[addrByte3])   # write adress byte 3 (LSB)
   fx3write("d",ADDR_FIFO,block)         # write full page of data to FIFO
   :setByteCount(numOfBytes+HEADERSIZE)
   :startSpiTransfer()
   pause(0.001)
   
endproc()

