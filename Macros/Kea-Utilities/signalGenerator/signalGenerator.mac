#########################################################
# 
# signalGenerator
#
# Generates an continuous RF signal on the Ch1 transceiver output
# WARNING: does not work with the internal RF amplifier since
# the internal amplifier is pulse only. 
# When using external amplifier make sure it can take
# CW signals of the supplied amplitude. (Otherwise it will overheat).
#
# Copyright (c) Magritek Ltd 2026
#
# U.I. V5
#########################################################

#########################################################
# 
# The is the entry point for the KeaExpert 
# interface. It will add the experiment to the parameter
# list or with the shift key pressed open the
# relevant macros in the pulse program compiler.
#
# Autogenerated 
#
#########################################################

procedure(signalGenerator, parameters=null)

   macroLocation = getmacropath()
   parentPath = getbasepath(macroLocation)

   if(iskeypressed("shift"))
      PulseProgramCompiler(guiwinnr(),null,parentPath,"signalGenerator")
   elseif(iskeypressed("control"))
      gView->showExperimentHelp("signalGenerator")
   else
      gExpt->addExperiment(parentPath,"signalGenerator",parameters)
   endif

endproc()

#########################################################
# 
# Provide a backdoor interface to this macro. This 
# adds [""] to the user interface list (guipar)
# and also generates the pulse program lists required 
# by execpp. Finally is calls execpp, returning any
# results in the structure 'r'.
#
# Autogenerated 
#
#########################################################

procedure(backdoor, guipar)

   seqInfo = :getseqpar()  
   r = gSeq->initAndRunPP(getmacropath(), getmacroname(), guipar, seqInfo)

endproc(r)

#########################################################
# 
# Returns important pulse sequence parameter lists
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
# Autogenerated 
#
#########################################################

procedure(getseqpar)

   rel = ["b1FreqCh1 = b1Freq",
          "a1 = amplitude",
          "repTime = 100",
          "totPnts = nrPnts",
          "totTime = acqTime",
          "specialMode = \"siggen\""]
   var = [""]
   pp_list = ["a1","p1"]
   pp_name = "signalGenerator.p"
   phase_list = [0;0]

   seqInfo = struct(rel,var,pp_list,pp_name,phase_list)

endproc(seqInfo)


#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)

 # Set the phase
   (ppList,pAcq) = ucsRun:setPPPhase(ppList,0,pcList,pcIndex)

 # Set the parameters
    ucsRun:updatePPParameters(ppList,guipar)

 # Run the experiment
    status = ucsRun:runExperiment(guipar)

# Leave the RF on (since experiment switches it off at the end)
   :startGenerator()

   if(status == "abort")
     return(0)
   endif

endproc("execpp")


########################################################
# Get the name of a plot file given the region name
# or return the whole list
########################################################

procedure(getPlotInfo,plotRegion)

   info = ["pt1","null.pt1"]

   if(plotRegion == "all")
      return(info)
   endif

   idx = getlistindex(info,plotRegion)
   if(idx != -1)
      return(info[idx+1])
   endif

endproc(null)

########################################################
# This procedure is called when you wish to stop
# the generator output.
########################################################
procedure(stopGenerator)

   if(gData->procType == "DSP")
      cd("$getmacropath()$")
      pp = dspreadpp("signalGeneratorOff.p")
      dspwrite("p",0x2000,pp)
      dsprunpp(0x2000)
   elseif(gData->procType == "FX3")
      fx3write("E", 0x00, [0])
   endif

endproc()

########################################################
# The main program just produces a pulse because
# when the experiment is finished it resets the output.
# This command will switch on the output again after a new ms delay.
########################################################
procedure(startGenerator)

   if(gData->procType == "DSP")
      cd("$getmacropath()$")
      pp = dspreadpp("signalGeneratorOn.p")
      dspwrite("p",0x2000,pp)
      dsprunpp(0x2000)
   elseif(gData->procType == "FX3")
      fx3write("E", 0x00, [8])
   endif

endproc()

########################################################
# This procedure modifies the frequency parameter and
# then runs the program again.
########################################################
procedure(updateFreq,sign)

   n1 = findobj(0,"name","b1Freq")
   n2 = findobj(0,"name","delFreq")
   b1Freq = getpar(0,n1,"value")
   delFreq = getpar(0,n2,"value")
   setpar(0,n1,"text",b1Freq+sign*delFreq/1e3)

   if(b1Freq+sign*delFreq/1e3 <= 0)
      return
   endif

   guipar = getctrlvalues(0)
   :backdoor(guipar)

endproc()

########################################################
# This procedure modifies the amplitude parameter and
# then runs the program again.
########################################################
procedure(updateAmp,sign)

   n1 = findobj(0,"name","amplitude")
   n2 = findobj(0,"name","delAmp")
   amplitude = getpar(0,n1,"value")
   delAmp = getpar(0,n2,"value")

   if(amplitude+sign*delAmp > 0)
      return
   endif

   setpar(0,n1,"text",amplitude+sign*delAmp)

   guipar = getctrlvalues(0)
   :backdoor(guipar)

endproc()
