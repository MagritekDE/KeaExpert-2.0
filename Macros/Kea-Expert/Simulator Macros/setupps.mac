procedure(setupps, name, vec)

   if(not(isvar("SimulationInfo")))
      info = struct()
   else
      info = SimulationInfo
   endif

   if(name == "1pulse" | name == "monitornoise")
      info->name = name
      info->pulseAmpIndex    = vec[0]
      info->pulsePhaseIndex  = vec[1]
      info->pulseLengthIndex = vec[2]
      info->acquDelayIndex   = vec[3]
   elseif(name == "t1ir")
      info->name = name
      info->pulse180AmpIndex    = vec[0]
      info->pulse180PhaseIndex  = vec[1]
      info->pulse180LengthIndex = vec[2]
      info->T1DelayIndex        = vec[3]  
      info->pulse90AmpIndex     = vec[4]
      info->pulse90PhaseIndex   = vec[5]
      info->pulse90LengthIndex  = vec[6]
      info->acquDelayIndex      = vec[7]  
   endif

   assign("SimulationInfo",info,"window")

endproc()