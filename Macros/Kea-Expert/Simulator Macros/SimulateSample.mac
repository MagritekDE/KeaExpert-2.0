# Called by simulated dspread - all parameters are stored in SimulationInfo
procedure(SimulateSample,dataSize)

   assignstruct(SimulationInfo)

# Non-experiment specific parameters
    DW = dwellTime*1e-6 # <= This is the dwell time
    off = single(1e6*(b1Freq-b0Freq)) # <= This is the offset (b1Freq - f0)
    sigAmp = signalAmplitude*receiverGain
    ph = receiverPhase - pulsePhase 
    pulseInt = pulseIntegral
    pulse90Int = pulse90Integral
    sigAmp = sigAmp *sin(pulseInt*pi/(2*pulse90Int))
    nl = noiseAmplitude*receiverGain*sqrt(1.0/dwellTime)
    acqDelay = acquisitionDelay*1e-6
    startDelay = acqDelay + DW # Simulate the delay on Proton channel

# Generate simulated data for each experiment - result is a structure
# containing a peakList with multiple amplitudes and splitting as well
# as relaxation times T1 and T2.
   if(name == "1pulse")

      cd(getmacropath())
      cd("Simulated Samples")

      result = sample()
      assignstruct(result)

      nrPeaks = size(peakList)
      nrSplits = size(splittingAmpList)
      
      t = linspace(startDelay,(dataSize/2-1)*DW+startDelay, dataSize/2)
      cmat = cmatrix(dataSize/2)

      for(p = 0 to nrPeaks-1) # Loop over main peaks
         freq0 = peakList[p]*b0Freq
         for(s = 0 to nrSplits-1) # Loop over multiplets
            amp = splittingAmpList[s,p]     
            if(amp > 0)
               freq = off - freq0 + splittingFreqList[s,p]
               cmat = cmat + amp*exp(i*(2*pi*freq*t + ph)).*exp(-t/T2-t/T2Star)  
            endif       
         next(s)
      next(p)      
      mat = ctor(cmat)
      mat = sigAmp*mat/max(mag(mat))
      mat = mat + nl*noise(dataSize)

   elseif(name == "monitornoise")

      mat = nl*noise(dataSize)
    
   elseif(name == "t1ir")

      cd(getmacropath())
      cd("Simulated Samples")

      result = sample()
      assignstruct(result)

      nrPeaks = size(peakList)
      nrSplits = size(splittingAmpList)
      t = linspace(startDelay,(dataSize/2-1)*DW+startDelay, dataSize/2)
      cmat = cmatrix(dataSize/2)

      for(p = 0 to nrPeaks-1) # Loop over main peaks
         freq0 = peakList[p]*b0Freq
         for(s = 0 to nrSplits-1) # Loop over multiplets
            amp = splittingAmpList[s,p]     
            if(amp > 0)
               freq = off - freq0 + splittingFreqList[s,p]
               cmat = cmat + amp*exp(i*(2*pi*freq*t + ph)).*exp(-t/T2-t/T2Star)  
            endif       
         next(s)
      next(p)      
      mat = ctor(cmat)

      mat = (1-2*exp(-1e-6*t1Delay/T1))*sigAmp*mat/max(mag(mat))
      mat = mat + nl*noise(dataSize)

   elseif(name == "t2")

      cd(getmacropath())
      cd("Simulated Samples")

      result = sample()
      assignstruct(result)

      nrPeaks = size(peakList)
      nrSplits = size(splittingAmpList)
      t = linspace(startDelay,(dataSize/2-1)*DW+startDelay, dataSize/2)
      cmat = cmatrix(dataSize/2)

      for(p = 0 to nrPeaks-1) # Loop over main peaks
         freq0 = peakList[p]*b0Freq
         for(s = 0 to nrSplits-1) # Loop over multiplets
            amp = splittingAmpList[s,p]     
            if(amp > 0)
               freq = off - freq0 + splittingFreqList[s,p]
               cmat = cmat + amp*exp(i*(2*pi*freq*t + ph)).*exp(-t/T2-t/T2Star)  
            endif       
         next(s)
      next(p)      
      mat = ctor(cmat)

      mat = sigAmp*mat/max(mag(mat))
      mat = mat + nl*noise(dataSize)

   endif

endproc(mat)
