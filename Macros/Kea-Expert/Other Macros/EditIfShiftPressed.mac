procedure(EditIfShiftPressed, macPath ,macName)

   if(iskeypressed("shift"))
      if(gData->permissions->canEditScripts == "yes")
         bak = getcwd()
         EditorWin()
         cd(macPath)
         ed(macName)
         cd(bak)
      else
         print("\n   Script editing not enabled - see preferences->general\n")
      endif
      return(1)
   endif

endproc(0)