#####################################################
# Define an interface where a fitting function and
# its derivatives can be defined as well as allow
# the core fitting macro to be viewed and edited. 
#####################################################

procedure(fittingUI, fitName=null)

   n = :windowdefinition()
   windowvar(wvNrPar,wvNr)
   setwindowpar(n,"sizelimits",[457,1000,265,265])
   wvNr = n
   wvNrPar = 0
   :init(fitName)
   showwindow(n)

endproc()

#####################################################
# Save the current parameter values to a 
# preferences file and write the macro called
# by the nonlinear L&M fit code and the fitting
# procedures in integrateClass.mac
#####################################################

procedure(generateMacro)

   bak = getcwd()

# Save the current parameters to preferences
   cd("$prefdir$\Core Macros")
   par = getctrlvalues(0)
   assignlist(par)
   save("fitFunctions.par",par)


# The fitting macros and par files are stored here
   cd("$appdir$\\Macros\\Spinsolve-Expert\\Processing Macros\\1DPlotAnalyser\\Fitting Functions")

# Check for file
   if(isfile("$funcName$.mac"))
      if(query("Warning!","The file '$funcName$.mac' already exists. Do you want to overwrite it? Preprocess and postprocess procedures will lose manually added information.") == "no")
         return
      endif
   endif

# Make a backup just in case
   copyfile("$funcName$.mac","$funcName$.mac.bak")

# Save the final fitting file
   printtofile("$funcName$.mac")

# Print the basic fitting procedure with derivatives
   pr "# Auto-generated procedure called by L-M nonlinear fit.\n"
   pr "# Evaluates function and derivatives given x and fitting parameters.\n"
   pr "procedure($funcName$, x, "
   for(k = 0 to nrPar-2)
      print("p$k$, ")
   next(k)
   print("p$nrPar-1$)\n\n")

   pr ("   if(vartype(x) == \"float\" | vartype(x) == \"double\")\n")
   print("      $function$\n")
   for(k = 0 to nrPar-1)
      temp = "dydp$k$"
      print("      $eval(temp)$\n")
   next(k)

   pr "      return(y, "
   for(k = 0 to nrPar-2)
      temp = "dydp$k$"
      print("$temp$, ")
   next(k)
   temp = "dydp$nrPar-1$"
   pr "$temp$)\n"
   print("   else\n")
   print("      assignstruct(p0)\n")
   print("      $function$\n")
   print("   endif")
   pr "\n\nendproc(y)\n"


# Print the default preprocess procedure
   init = matrix(nrPar)
   pr "\n# Procedure to set the initial guess for the parameters and\n"
   pr "# any required changes to the x-axis, x and y label and y mapping."
   print("\nprocedure(preprocess, xOrig, y, info)\n\n")
   print("   init = $init$\n")
   print("   xMod = xOrig\n")
   print("   xLabel = null\n")
   print("   yLabel = null\n")
   print("   yMapping = \"linear\"\n\n")
   print("endproc(init, xMod, xLabel, yLabel, yMapping)\n\n")

# Print the default postprocess procedure
   pr "# Procedure to modify any of the parameters after the fitting.\n"
   print("procedure(postprocess, parIn)\n\n")
   print("   parOut = parIn\n\n")
   print("endproc(parOut)\n\n")

# Print the parameter procedure
   pr "# Stores the parameters displayed in the fitting design interface (autogenerated).\n"
   print("procedure(uiParameters)\n\n")
   print("   oldNr = guiwinnr()\n")
   print("   guiwinnr(-1)\n")

   for(k = 0 to size(par)-1)
      print("   $par[k]$\n")
   next(k)
   print("   par = mkparlist()\n")
   print("   try; guiwinnr(oldNr); catch; endtry;\n")

   print("\nendproc(par)\n\n")

# Finished printing so save to file
   closeprint()

   print("\n   File $funcName$.mac generated\n")
   cd(bak)

endproc()

#####################################################
# Display help for the fitting process
#####################################################

procedure(helpProc)

   help("Macros\\Spinsolve-Expert","curveFittingInterface.htm")

endproc()

#####################################################
# Initialise the UI from the last saved data or
# some default values
#####################################################

procedure(init, fitName)

   if(fitName == null)
      cd("$prefdir$\Core Macros")
      if(isfile("fitFunctions.par"))
         par = load("fitFunctions.par")
         assignlist(par)
         wvNrPar = 0
         nrParCtrl->value(nrPar)
         nrParTxtCtrl->text(nrPar) 
         :nrParCallBack()    
         setctrlvalues(0,par)
      else
         funcNameCtrl->text("Exponential")
         wvNrPar = 0
         nrParCtrl->value(2)
         nrParTxtCtrl->text(2)
         :nrParCallBack()
         funcCtrl->text("y = p0*exp(-p1*x)")
         eval("dydp0")->text("dydp0 = p0")
         eval("dydp1")->text("dydp1 = -p0*x*exp(-p1*x)")
      endif
   elseif(fitName == "Add Fit")
         funcNameCtrl->text("New Fit")
         wvNrPar = 0
         nrParCtrl->value(2)
         nrParTxtCtrl->text(2)
         :nrParCallBack()
         funcCtrl->text("y = p0*exp(-p1*x)")
         eval("dydp0")->text("dydp0 = p0")
         eval("dydp1")->text("dydp1 = -p0*x*exp(-p1*x)")
   else
   # The fitting macros and par files are stored here
      cd("$appdir$\\Macros\\Spinsolve-Expert\\Processing Macros\\1DPlotAnalyser\\Fitting Functions")
      proc = "$fitName$:uiParameters"
      par = proc() # Read the parameters
      assignlist(par)
      :nrParCallBack(wvNrPar,nrPar) # Change the UI to match nr of parameters
      setctrlvalues(0,par) # Update parameters

   endif

endproc()

#####################################################
# Load parameter values from a file
#####################################################

procedure(loadFromFile)

# The fitting macros and par files are stored here
   cd("$appdir$\\Macros\\Spinsolve-Expert\\Processing Macros\\1DPlotAnalyser\\Fitting Functions")

   fileName = getfilename("open","Select fitting file","Parameter files","mac")
   if(fileName == "cancel")
      return
   endif
   proc = "$fileName$:uiParameters"
   par = proc() # Read the parameters
   assignlist(par)
   :nrParCallBack(wvNrPar,nrPar) # Change the UI to match nr of parameters
   setctrlvalues(0,par) # Update parameters

endproc()

#####################################################
# The number of fitting parameters has been modified
# so update the UI accordingly
#####################################################

procedure(nrParCallBack, oldNrVar=null, newNrVar=null)

   if(oldNrVar == null)
      oldNrVar = wvNrPar
      newNrVar = nrParCtrl->value
   endif

# Remove old parameter controls outside new range
   if(newNrVar < oldNrVar)
      for(k = newNrVar*2+1 to oldNrVar*2-1 step 2)
         if(isobj(wvNr,k) & isobj(wvNr,k+1))
            rmobj(wvNr,k)
            rmobj(wvNr,k+1)
         endif
      next(k)
   endif

# Update the number of new parameters
   wvNrPar = newNrVar
   nrParTxtCtrl->text(wvNrPar)
   seteditwin(wvNr,"fast")

# Add the new parameter controls
   dy = 40 # Control spacing
   y = 155 + oldNrVar*dy
   for(k = oldNrVar*2+1 to newNrVar*2-1 step 2)
      statictext(k, 92, y+4, "right", "dy/dp$(k-1)/2$:")
      div = textbox(k+1, 100, y, "ww-200")
      setpar(wvNr,k+1,"name","dydp$(k-1)/2$")
      assign("dydp$(k-1)/2$",div,"window")
      y = y + dy
   next(k)

   seteditwin(-wvNr,"fast")

# Make the new parameter controls visible
   for(k = oldNrVar*2+1 to wvNrPar*2-1 step 2)
      getobj(wvNr,k)->visible("true")
      getobj(wvNr,k+1)->visible("true")
   next(k)

# Adjust the window height
   newHeight = 180+wvNrPar*40
   setwindowpar(wvNr,"height", newHeight)
   setwindowpar(wvNr,"sizelimits",[457,1000,newHeight-4,newHeight-4])

endproc()

#####################################################
# Open the macro fit file for manual editing
#####################################################

procedure(openFitMacro)

# The fitting macros and par files are stored here
   fileName = funcNameCtrl->text + ".mac"
   pathName = "$appdir$\\Macros\\Spinsolve-Expert\\Processing Macros\\1DPlotAnalyser\\Fitting Functions"
   cd(pathName)
   if(isfile(fileName))
      n = editorwin()
      txt = load(fileName)
      setpar(n,1,"text",txt)
      setpar(n,1,"filename",fileName)
      setpar(n,1,"pathname",pathName)
      setwindowpar(n,"title",fileName)
   else
      message("Information","File $fileName$ does not exist. Press Generate first.","info")
   endif

endproc()

#####################################################
# Save current parameter values to a file
#####################################################
procedure(saveToFile)

# The fitting macros and par files are stored here
   cd("$appdir$\\Macros\\Spinsolve-Expert\\Processing Macros\\1DPlotAnalyser\\Fitting Functions")
   fileName = funcNameCtrl->text
   par = getctrlvalues(0)
   save(fileName,par)

endproc()


#####################################################
# Define the UI
#####################################################

procedure(windowdefinition)

   # Automatically generated window definition procedure.
   # Any code added manually will be removed if layout modified interactively
   n = window("Add or modify fit function", -1, -1, 457, 262, "resizable")

      statictext(101, 92, 25, "right", "Function name:")
      funcNameCtrl = textbox(102, 100, 21, "ww-280")
      setpar(n,102,"name","funcName")

      nrParCtrl = updown(103, 150, 63, 16, 30, "vertical",:nrParCallBack())
      setpar(n,103,"base",1,"value",1,"stepSize",1,"nrSteps",9)
      statictext(104, 92, 65, 60,25,"right", "Number of parameters:")
      nrParTxtCtrl = textbox(105, 100, 68, 40)
      setpar(n,105,"name","nrPar")

      statictext(105, 92, 119, "right", "Function:")
      funcCtrl = textbox(106, 100, 115, "ww-200")
      setpar(n,106,"name","function")

      groupbox(107,"",10,5,"ww-100","wh-16")

      button(200, "ww-75", 10, 65, 33, "Generate",:generateMacro();)
      setpar(n,200,"mode","default","tooltip","Generate a fitting macro.")

      button(201, "ww-75", 170, 65, 33, "Cancel", closewindow(0);)
      setpar(n,201,"tooltip","Close the interface.")

      button(202, "ww-75", 90, 65, 33, "Load fit",:loadFromFile();)
      setpar(n,202,"tooltip","Load parameters for a fit.")

      button(203, "ww-75", 50, 65, 33, "Open macro",:openFitMacro();)
      setpar(n,203,"tooltip","Display the macro generated for further editing.")

      button(204, "ww-75", 130, 65, 33, "Help",:helpProc();)
      setpar(n,204,"tooltip","Display help for this interface.")


endproc(n)
