# Auto-generated procedure called by L-M nonlinear fit.
# Evaluates function and derivatives given x and fitting parameters.
procedure(T1IR, x, p0, p1)

   if(vartype(x) == "float" | vartype(x) == "double")
      y =  p0*(1-2*exp(-x/p1))
      dydp0 = (1-2*exp(-x/p1))
      dydp1 = -2*p0*x*exp(-x/p1)/p1^2
      return(y, dydp0, dydp1)
   else
      assignstruct(p0)
      y =  p0*(1-2*exp(-x/p1))
   endif

endproc(y)

# Procedure to set the initial guess for the parameters and
# any required changes to the x-axis, x and y label and y mapping.
procedure(preprocess, x, y, info)

   idx2 = findindex2(y,0,"right",0)
   sz = size(x)
   if(idx2 >= 0 & idx2 < sz)
       init = [(y[-1]-y[0])/2,x[idx2]/0.693]
   else
      print("Can't find zero crossing - invalid model for fit")
      return(null, null, null, null, null)
   endif
   xMod = x
   xLabel = null
   yLabel = null
   yMapping = "linear"

endproc(init, xMod, xLabel, yLabel, yMapping)

# Procedure to modify any of the parameters after the fitting.
procedure(postprocess, parIn)

   parOut = parIn

endproc(parOut)

# Stores the parameters displayed in the fitting design interface (autogenerated).
procedure(uiParameters)

   oldNr = guiwinnr()
   guiwinnr(-1)
   dydp1 = "dydp1 = -2*p0*x*exp(-x/p1)/p1^2"
   dydp0 = "dydp0 = (1-2*exp(-x/p1))"
   function = "y =  p0*(1-2*exp(-x/p1))"
   nrPar = 2
   funcName = "T1IR" 
   par = mkparlist()
   try; guiwinnr(oldNr); catch; endtry;

endproc(par)



