# Auto-generated procedure called by L-M nonlinear fit.
# Evaluates function and derivatives given x and fitting parameters.
procedure(PGSEBiExpPos, x, p0, p1, p2, p3)

   if(vartype(x) == "float" | vartype(x) == "double")
      y = p0*exp(-p1^2*x)+p2*exp(-p3^2*x)
      dydp0 = exp(-p1^2*x)
      dydp1 = -2*x*p0*p1*exp(-p1^2*x)
      dydp2 = exp(-p3^2*x)
      dydp3 = -2*x*p2*p3*exp(-p3^2*x)
      return(y, dydp0, dydp1, dydp2, dydp3)
   else
      assignstruct(p0)
      y = p0*exp(-p1^2*x)+p2*exp(-p3^2*x)
   endif

endproc(y)

# Procedure to set the initial guess for the parameters and
# any required changes to the x-axis, x and y label and y mapping.
procedure(preprocess, xOrig, y, info)

   delta   = info->smDelta
   DELTA   = info->bgDelta
   gamma   = info->gammaX

# Read the qAxis
   bak = getcwd()
   dir = gData->curExpt->dataPath 
   cd(dir)
   import1dpar("ab", "ascii", "xyrc", "real")
   if(isfile("gradients.par"))
      gAxis = import1d("gradients.par")
      qAxis = (gAxis*delta*1e-3*gamma)^2*(DELTA-delta/3)*1e-3
   elseif(isfile("delayTimes.txt"))
      qAxis = import1d("delayTimes.txt")
   elseif(isfile("qAxis.par"))
      qAxis = import1d("qAxis.par")
   else
      print("Gradient or q-axis file not found")
      return(null,null,null,null,null)
   endif
   cd(bak)
   qAxis = qAxis*1e-9
   sz = size(qAxis)

# Estimate the diffusion coefficents
   pos1 = round(sz*0.1) 
   pos2 = round(sz*0.2) 
   if(pos2 == pos1)
      pos2 = pos1+1
   endif 
   Dpred1 = abs(-loge(y[pos2]/y[0])+loge(y[pos1]/y[0]))/(qAxis[pos2]-qAxis[pos1])

   pos1 = round(sz*0.8) 
   pos2 = round(sz*0.9) 
   if(pos2 == pos1)
      pos2 = pos1+1
   endif 
   Dpred2 = abs(-loge(y[pos2]/y[0])+loge(y[pos1]/y[0]))/(qAxis[pos2]-qAxis[pos1])

# Check for NaN or Inf
   if(isinf(Dpred1) | isinf(Dpred2))
      Dpred1 = abs(loge(y[0]/y[0])-loge(y[-1]/y[0]))/(qAxis[-1]-qAxis[0])
      Dpred2 = 0.8*Dpred1
      Dpred1 = 0.2*Dpred1
   endif

# Set the initial parameter guess
   init = [max(y)/2,sqrt(Dpred1),max(y)/2,sqrt(Dpred2)]

# Some axis labels and mapping
   xLabel = "\G(g)^(2)g^(2)\G(d)^(2)(\G(D)-\G(d)/3) 10^(9) sm^(-2)"
   yMapping = "log"
   yLabel = "loge(integral)"


endproc(init, qAxis, xLabel, yLabel, yMapping)

# Procedure to modify any of the parameters after the fitting.
procedure(postprocess, par)

   par->p1err = (2*par->p1*par->p1err)*1e-9
   par->p1    = (par->p1)^2*1e-9
   par->p3err = (2*par->p3*par->p3err)*1e-9
   par->p3    = (par->p3)^2*1e-9

endproc(par)

# Stores the parameters displayed in the fitting design interface (autogenerated).
procedure(uiParameters)

   oldNr = guiwinnr()
   guiwinnr(-1)
   dydp3 = "dydp3 = -2*x*p2*p3*exp(-p3^2*x)"
   dydp2 = "dydp2 = exp(-p3^2*x)"
   dydp1 = "dydp1 = -2*x*p0*p1*exp(-p1^2*x)"
   dydp0 = "dydp0 = exp(-p1^2*x)"
   function = "y = p0*exp(-p1^2*x)+p2*exp(-p3^2*x)"
   nrPar = 4
   funcName = "PGSEBiExpPos"
   par = mkparlist()
   try; guiwinnr(oldNr); catch; endtry;

endproc(par)

