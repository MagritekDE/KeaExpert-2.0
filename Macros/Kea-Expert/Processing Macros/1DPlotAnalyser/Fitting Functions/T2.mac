# Auto-generated procedure called by L-M nonlinear fit.
# Evaluates function and derivatives given x and fitting parameters.
procedure(T2, x, p0, p1)

   if(vartype(x) == "float" | vartype(x) == "double")
      y =  p0*exp(-x/p1)
      dydp0 = exp(-x/p1)
      dydp1 = p0*x*exp(-x/p1)/(p1^2)
      return(y, dydp0, dydp1)
   else
      assignstruct(p0)
      y =  p0*exp(-x/p1)
   endif

endproc(y)

# Procedure to set the initial guess for the parameters and
# any required changes to the x-axis, x and y label and y mapping.
procedure(preprocess, xOrig, y, info)

   idx2 = findindex2(y,0,"right",y[0]*0.37)
   init = [y[0],idx2]
   xMod = xOrig
   xLabel = null
   yLabel = null
   yMapping = "log"

endproc(init, xMod, xLabel, yLabel, yMapping)

# Procedure to modify any of the parameters after the fitting.
procedure(postprocess, parIn)

   parOut = parIn

endproc(parOut)

# Stores the parameters displayed in the fitting design interface (autogenerated).
procedure(uiParameters)

   oldNr = guiwinnr()
   guiwinnr(-1)
   dydp1 = "dydp1 = p0*x*exp(-x/p1)/(p1^2)"
   dydp0 = "dydp0 = exp(-x/p1)"
   function = "y =  p0*exp(-x/p1)"
   nrPar = 2
   funcName = "T2"
   par = mkparlist()
   try; guiwinnr(oldNr); catch; endtry;

endproc(par)




