# Auto-generated procedure called by L-M nonlinear fit.
# Evaluates function and derivatives given x and fitting parameters.
procedure(PGSETriExp, x, p0, p1, p2, p3, p4, p5)

    if(vartype(x) == "float" | vartype(x) == "double")
      y = p0*exp(-p1*x)+p2*exp(-p3*x)+p4*exp(-p5*x)
      dydp0 = exp(-p1*x)
      dydp1 = -x*p0*exp(-p1*x)
      dydp2 = exp(-p3*x)
      dydp3 = -x*p2*exp(-p3*x)
      dydp4 = exp(-p5*x)
      dydp5 = -x*p4*exp(-p5*x)
      return(y, dydp0, dydp1, dydp2, dydp3, dydp4, dydp5)
   else
      assignstruct(p0)
      y = p0*exp(-p1*x)+p2*exp(-p3*x)+p4*exp(-p5*x)
   endif

endproc(y)

# Procedure to set the initial guess for the parameters and
# any required changes to the x-axis, x and y label and y mapping.
procedure(preprocess, xOrig, y, info)

   delta   = info->smDelta
   DELTA   = info->bgDelta
   gamma   = info->gammaX

# Read the qAxis
   bak = getcwd()
   dir = gData->curExpt->dataPath 
   cd(dir)
   import1dpar("ab", "ascii", "xyrc", "real")
   if(isfile("gradients.par"))
      gAxis = import1d("gradients.par")
      qAxis = (gAxis*delta*1e-3*gamma)^2*(DELTA-delta/3)*1e-3
   elseif(isfile("delayTimes.txt"))
      qAxis = import1d("delayTimes.txt")
   elseif(isfile("qAxis.par"))
      qAxis = import1d("qAxis.par")
   else
      print("Gradient or q-axis file not found")
      return(null,null,null,null,null)
   endif
   cd(bak)
   qAxis = qAxis*1e-9

# Estimate the diffusion coefficent
   midIdx = round(size(qAxis)/2) 
   pos1 = round(size(qAxis)*0.1) 
   pos2 = round(size(qAxis)*0.2) 
   if(pos2 == pos1)
      pos2 = pos1+1
   endif
   Dpred1 = (-loge(y[pos2]/y[0])+loge(y[pos1]/y[0]))/(qAxis[pos2]-qAxis[pos1])


   pos1 = round(size(qAxis)*0.45) 
   pos2 = round(size(qAxis)*0.55)
   if(pos2 == pos1)
      pos2 = pos1+1
   endif 
   Dpred2 = (-loge(y[pos2]/y[0])+loge(y[pos1]/y[0]))/(qAxis[pos2]-qAxis[pos1])

   pos1 = round(size(qAxis)*0.8) 
   pos2 = round(size(qAxis)*0.9) 
   if(pos2 == pos1)
      pos2 = pos1+1
   endif
   Dpred3 = (-loge(y[pos2]/y[0])+loge(y[pos1]/y[0]))/(qAxis[pos2]-qAxis[pos1])
# Set the initial parameter guess
   init = [max(y)/3,Dpred1,max(y)/3,Dpred2,max(y)/3,Dpred3]

# Some axis labels and mapping
   xLabel = "\G(g)^(2)g^(2)\G(d)^(2)(\G(D)-\G(d)/3) 10^(9) sm^(-2)"
   yMapping = "log"
   yLabel = "loge(integral)"

endproc(init, qAxis, xLabel, yLabel, yMapping)

# Procedure to modify any of the parameters after the fitting.
procedure(postprocess, par)

   par->p1    = par->p1*1e-9
   par->p1err = par->p1err*1e-9
   par->p3    = par->p3*1e-9
   par->p3err = par->p3err*1e-9
   par->p5    = par->p5*1e-9
   par->p5err = par->p5err*1e-9

endproc(par)

# Stores the parameters displayed in the fitting design interface (autogenerated).
procedure(uiParameters)

   oldNr = guiwinnr()
   guiwinnr(-1)
   dydp5 = "dydp5 = -x*p4*exp(-p5*x)"
   dydp4 = "dydp4= exp(-p5*x)"
   dydp3 = "dydp3 = -x*p2*exp(-p3*x)"
   dydp2 = "dydp2 = exp(-p3*x)"
   dydp1 = "dydp1 = -x*p0*exp(-p1*x)"
   dydp0 = "dydp0 = exp(-p1*x)"
   function = "y = p0*exp(-p1*x)+p2*exp(-p3*x)+p4*exp(-p5*x)"
   nrPar = 6
   funcName = "PGSETriExp"
   par = mkparlist()
   try; guiwinnr(oldNr); catch; endtry;

endproc(par)

