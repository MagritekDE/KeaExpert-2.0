##########################################################
# 
##########################################################
procedure(graphBuildUp,t,data,prn,m,nrScans,guipar)

   assignlist(guipar)
   
   if(accumulate == "yes")
      sf = 1/nrScans
   else
      sf = 1
   endif
   
   # Select units
   if(wvUnits == "uV")
      ampUnits = "\G(m)V"
   elseif(wvUnits == "uV")
      ampUnits = "mV"
      sf = sf *0.001
   else
      ampUnits = "raw"
   endif
   
   prn->draw("false") 
   
   prn->plot(t,data*sf,
           "tracetype", "lines",
       "tracecolor",wvDataSymbolColor,
       "symbolshape","opensquare",
       "symbolcolor",wvDataSymbolColor)
   prn->xlabel("Recovering time (ms)") 
   prn->ylabel("Signal amplitude($ampUnits$)")
   prn->axes("fontsize",11)
   prn->title("Mz Build Up $nrPntsT1-m$/$nrPntsT1$")     
   prn->hold("off")
   prn->draw("true")

endproc("graphBuildUp")

##########################################################
# 
##########################################################
procedure(T1Sat-ieFitOffset,t,data,prn,nrScans,guipar)

   assignlist(guipar)
   
   if(accumulate == "yes")
      sf = 1/nrScans
   else
      sf = 1
   endif

# Select units
   if(wvUnits == "uV")
      sf = sf 
      ampUnits = "\G(m)V"
   elseif(wvUnits == "uV")
      ampUnits = "mV"
   else
      ampUnits = "raw"
   endif

   np = size(data)
   tZero = matrix(np+1)
   fZero = matrix(np+1)
   tZero = insert(tZero,t,1)
   fZero = insert(fZero,data,1)
   
   offset0 = -(data[np-1]+data[0])/2
   offsetRange = (data[np-1]-data[0])
   npChi = 32
   chi = matrix(npChi)
   offset = matrix(npChi)
   for(k = 0 to npChi-1)
      offset[k] = offset0 + offsetRange/(npChi-1)*(k-npChi/2)
      newdata = data+offset[k]
      try
        (fit,E0,T1,E0err,T1err) = t1fit(t,newdata,"ir")
         chi[k] = :chiSqr(newdata,fit)
      catch
         chi[k] = 100000
      endtry
   next(k)
   
   (a,bestk) = min(chi)
   
   offset0 = offset[bestk]
   offsetRange = (offset[bestk+1]-offset[bestk-1])
   npChi = 32
   chi = matrix(npChi)
   offset = matrix(npChi)
   for(k = 0 to npChi-1)
      offset[k] = offset0 + offsetRange/(npChi-1)*(k-npChi/2)
      newdata = data+offset[k]
      try
        (fit,E0,T1,E0err,T1err) = t1fit(t,newdata,"ir")
         chi[k] = :chiSqr(newdata,fit)
      catch
         chi[k] = 100000
      endtry
   next(k)
   
   (a,bestk) = min(chi)
   newdata = data+offset[bestk]
   try        
      (fit,E0,T1,E0err,T1err) = t1fit(t,newdata,"ir")
      fit = fit - offset[bestk]
      result = errorstr(T1,T1err,1)
      pr "\n\n   T1 = $result$ ms\n"  
   catch
      result = ""
   endtry

   if(result != "")
      prn->draw("false") 
      prn->plot(t,fit*sf,
              "tracetype", "lines",
              "tracewidth",1,
              "tracecolor",[0,128,0],
              "symbolshape","none")
      prn->xlabel("Recovering time (ms)") 
      prn->ylabel("Signal amplitude($ampUnits$)")
      prn->axes("fontsize",11)

      prn->hold("on")
      
      prn->plot(tZero,fZero*sf,
              "tracetype", "none",
              "tracecolor",[0,128,0],
              "symbolshape","opensquare",
              "symbolcolor",[255,0,0])
      prn->xlabel("Recovering time (ms)") 
      prn->ylabel("Signal amplitude($ampUnits$)")
      prn->axes("fontsize",11)
      prn->hold("off")
      
      
      prn->title("T_(1) = $result$ ms")
      prn->title("size",14)
      #  title("text","Mz recovering curve","size",14)
      
      prn->hold("off")
      prn->draw("true")
   endif 

endproc(fit,E0,T1,E0err,T1err)

##########################################################
# 
##########################################################
procedure(chiSqr,a,b)
 
    np = size(a)
    if(np!=size(b)); pr("\nvectors have different sizes\n"); return(-1); endif
    chi = sum((a[~]-b[~])^2)

endproc(chi)

##########################################################
# Check the dxValues in the dxNames list. Make sure the 
# values are greater than the limits
##########################################################

procedure(checkDelays, dxNames, dxValues, dxLimits)
 
   for(k = 0 to size(dxNames)-1)
      if (dxValues[k] <= dxLimits[k])
         message("Error","Pulse sequence timing error. Delay $dxNames[k]$ is <= $dxLimits[k]$","error")
         return(1)
      endif 
   next(k)

endproc(0)


########################################################
# Return expected experiment duration
########################################################

procedure(expectedDuration, guipar)

   assignstruct(guipar)

# Generate the t1 axis to work out the total delay
   amax   = 0.95
   amin   = exp(-tMax/t1Est)
   astep  = (amax-amin)/(nrPntsT1-1)
   t1Axis = matrix(nrPntsT1)

   for(m = 0 to nrPntsT1-1)
    # Linear time increment
      if(index == "lin")
        t1Axis[m] = (m+1)*tMax/(nrPntsT1) 
      endif 
    # Logarithmic time increment
      if(index == "exp")
         t1Axis[m] = t1Est*(-loge(amax-astep*(m)))^(1/1)
      endif
   next(m)

   dArray = t1Axis*1000
   totDelayTime = sum(dArray) 
   psTime = GetPulseProgramDuration("T1Sat-ie",1,guipar)*1000
   psTime = psTime - t1Axis[-1]*1000 # Base ps duration
   psTime = psTime + nrPnts*10 # Data collection time estimate
   totScans = nrPntsT1*nrScans
   duration = (totScans*(psTime+ieTime*1000) + nrScans*totDelayTime)/1e6


endproc(duration)

