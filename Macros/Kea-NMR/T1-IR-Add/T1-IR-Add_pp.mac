########################################################
#
# T1 inversion recovery pulse sequence with additional
# CPMG pulse sequence in which the echoes are coadded 
# to improve the signal to noise ratio.
#
# 180 - delay - 90 - delay - {180 - delay - acq}
#
# The peak amplitude is plotted as a function of
# the first delay. If manual phasing is used then the
# phase should be adjusted so that the first displayed echo
# is positive.
#
########################################################

procedure(pulse_program,dir,mode,pars)

# Expose parameters for FX3 implementation
   if(nrArgs == 3)
      assignlist(pars)
   endif

# Interface description (name, label, ctrlType, varType)
  interface = ["b1FreqCh1",       "B1 Frequency (MHz)",   "tb",     "freq";
               "90AmplitudeCh1",  "90 amplitude (dB)",    "tb",     "pulseamp";
               "180AmplitudeCh1", "180 amplitude (dB)",   "tb",     "pulseamp";
               "pulseLengthCh1",  "Pulse length (us)",    "tb",     "pulselength";
               "minDelay",        "Min. delay (ms)",      "tb",     "ldelayms";
               "maxDelay",        "Max. delay (ms)",      "tb",     "ldelayms";
               "nrSteps",         "Number of steps",      "tb",     "integer";
               "echoTime",        "Echo-time (us)",       "tb",     "sdelay";
               "nrEchoes",        "Number of echoes",     "tb",     "integer";
               "delaySpacing",    "Log. spacing",         "cb",     "lin,log";
               "ieTime",          "Inter-expt time (ms)", "tb",     "reptime"]


  tabs = ["Pulse_sequence","Acquisition","Processing_Autophase","File_Settings"]

# Relationships to determine remaining variable values
   relationships = ["n2 = 0", # x shim value
                    "n3 = 0", # y shim value
                    "n4 = 0", # z shim value
                    "n5 = 0", # o shim value
                    "a1 = 90AmplitudeCh1",
                    "a2 = 180AmplitudeCh1",
                    "d1 = pulseLengthCh1",
                    "d3 = echoTime/2-d1-pgo",
                    "d4 = echoTime/2-acqTime*500-d1/2+rxLat",
                    "d5 = echoTime-d1-pgo-d4",
                    "w1 = minDelay*1000-d1",
                    "n6 = nrPnts",
                    "totPnts = nrPnts",
                    "totTime = acqTime"]

# These parameters will be changed between experiments
   variables = ["a1","a2","w1"]

# Pulse sequence
   initpp(dir) # Reset internal parameter list

   gradon(x,n2)             # Set x shim
   gradon(y,n3)             # Set y shim
   gradon(z,n4)             # Set z shim 
   gradon(o,n5)             # Set o shim 

   cleardata(n6)
   pulse(mode,a2,p1,d1)     # 180 RF pulse
   wait(w1)                 # 180 - 90 delay
   pulse(mode,a1,p2,d1)     # 90 RF pulse
   delay(d3)                # 90 - 180 delay

   loop(l1,nrEchoes)
      pulse(mode,a2,p3,d1)  # 180 RF pulse
      delay(d4)             # 180 - acq delay
      acquire("sum",n6,d5)  # Acquire echo and wait
   endloop("l1")

   lst = endpp() # Return parameter list

# Phase cycle
  phaseList = [0,0,0,0; # +x,+x,+x,+x : 180 phase
               2,0,2,0; # -x,+x,-x,+x : 90 phase
               3,1,1,3; # -y,+y,+y,-y : 180 phase
               2,0,2,0] # -x,+x,-x,+x : Acquire phase

endproc(lst,tabs,interface,relationships,variables,null,phaseList)

#####################################################
# Assign those parameters which should take their 
# values from the factory defaults when making a 
# new experiment
#####################################################

procedure(getFactoryBasedParameters, par)

   specPar = gData->specParameters
   if(specPar == null)
      return(null)
   endif
   assignlist(specPar)

   par = ["rxGain           = $rxOptGaindB$",
          "pulseLengthCh1   = $pulseLengthCh1*2$",
          "90AmplitudeCh1   = $pulseAmplitudeCh1$",
          "180AmplitudeCh1  = $pulseAmplitudeCh1$",
          "b1FreqCh1        = $frequencyCh1$"]

endproc(par)

#####################################################
# Generate some simulated T1-IR data based on the
# values stored in SimulationInfo
#
# SimulationInfo->ppValues ... current pp values
# SimulationInfo->exptPar .... experiment parameters
#
#####################################################

procedure(simulateNMR, dataSize)

   assignstruct(SimulationInfo)

   pulse90Amp       = ppValues->a1
   pulse90Length    = ppValues->d1
   pulseIntegral    = pulse90Amp*pulse90Length
   acquisitionDelay = ppValues->d4
   t1Delay          = ppValues->w1

   p1 = round(ppValues->p1/(2*pi)*4)
   p2 = round(ppValues->p2/(2*pi)*4)
   p3 = round(ppValues->p3/(2*pi)*4)

   nrPnts    = exptPar->nrPnts
   nrEchoes  = exptPar->nrEchoes
   echoTime  = exptPar->echoTime
   dwellTime = exptPar->dwellTime

# Better to just have the current list and have in sensible linear units.

# Non-experiment specific parameters
   DW = dwellTime*1e-6 # <= This is the dwell time
   offFreq = 1e6*(single(b1Freq)-b0Freq) 
   sigAmp = signalAmplitude*receiverGain
   ph = receiverPhase 
   pulseInt = pulseIntegral
   pulse90Int = pulse90Integral
   sigAmp = sigAmp *sin(pulseInt*pi/(2*pulse90Int))
   nl = noiseAmplitude*receiverGain*sqrt(1.0/dwellTime)
   acqDelay = acquisitionDelay*1e-6
   startDelay = acqDelay + DW # Simulate the delay on Proton channel

   if(p2 == 2) # Phase cycling changes the detected phase
      ph = ph - 180
   endif

   cd(getmacropath())
   cd("$appdir$\\Macros\\KeaExpert\\SimulatorMacros\\Simulated Samples")
   
   result = sample()
   assignstruct(result)

   result = sample() # Get sample T2
   T2 = result->T2

   # Central echo times
   te = linspace(echoTime,echoTime*nrEchoes,nrEchoes)*1e-6
   sumEnhancement = sum(exp(-te/T2))

   # Time axis for phase offset
   t1 = ([0:1:nrPnts-1])*dwellTime*1e-6

   # Time axis for calculating echo shape
   t2 = ([0:1:nrPnts-1]-nrPnts/2)*dwellTime*1e-6
   cmat = cmatrix(nrPnts)

   cmat = (1-2*exp(-1e-6*t1Delay/T1))*sigAmp*sumEnhancement*exp(-(t2/T2+t2/T2Star)^2).*exp(i*(2*pi*offFreq*t1 + ph/180*pi))

   mat = ctor(cmat)

   # Add in some noise
   mat = mat + nl*noise(nrPnts*2)*sqrt(sumEnhancement)

endproc(mat)