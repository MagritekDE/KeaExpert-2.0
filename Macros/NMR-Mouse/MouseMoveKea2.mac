                "nrScans =1",
                "repTime = 10",
                "noHPA = \"true\"",
                "usePhaseCycle = \"no\"",
                "TTL1 = ttltranslate(6)", 
                "TTL2 = ttltranslate(5)", 
                "d1 = 1000",
                "d2 = 1000"]
   endif

   guipar=setlistvalue(guipar,"steps","$steps$")
