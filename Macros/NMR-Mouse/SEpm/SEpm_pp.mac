########################################################
#
# Spin echo + CPMG detection.
#
########################################################



procedure(pulse_program,dir,mode,pars)


# Expose parameters for FX3 implementation
   if(nrArgs == 3)
      assignlist(pars)
   endif

# Interface description (name, label, x, y, ctrlType, varType)
   interface = ["b1FreqCh1",      "B1 Frequency (MHz)",       "tb",   "freq";
               "repTime",      "Repetition time (ms)",    "tb",   "float,[20,1e8]";

               "90AmplitudeCh1",  "90 amplitude (dB)",         "tb",     "float,[-72,-6]";
               "180AmplitudeCh1", "180 amplitude (dB)",        "tb",     "pulseamp";
               "pulseLengthCh1",  "Pulse length (us)",       "tb",     "float,[1,500]";

               "echoTime",     "Echotime (us)",           "tb",     "sdelay";
               "nrEchoes",     "Number of echoes",         "tb",     "integer,[1,16000]";
               "echoShift",    "Echo shift (us)",         "tb",     "float,[-20,20]";
               "gradient",     "Gradient (kHz/mm)",        "tb",    "float";

               "DEst",         "D (10-9 m^2/s)",          "tb",     "float";
               "tauMin",       "tau min (ms)",              "tb",     "float,[0.001,100]";
               "tauMax",       "tau max (ms)",             "tb",     "float,[0.001,100]";
               "nrPntsTau",    "Number of tau incr.",    "tb",     "integer,[1,1000]";
               "index",        "Time increment",          "tm",     "string,[\"lin\",\"exp\"]"]

  tabs = ["Pulse sequence","Acquisition","File Settings"]

# Relationships between pulse-sequence and GUI parameters
   relationships = ["a1 = 90AmplitudeCh1",
                    "a2 = 180AmplitudeCh1",
                    "d1 = pulseLengthCh1",
                    "d2 = 1000*tauMin+echoTime/2-d1-pgo-1",
                    "d3 = echoTime/2-acqTime*500-d1/2-1+rxLat+echoShift",
                    "d4 = echoTime-d1-pgo-1-d3",
                    "d5 = 1000*tauMin-d1-pgo-1",
                    "n1 = nrEchoes",
                    "n2 = nrPnts",
                    "totPnts = nrPnts",
                    "totTime = acqTime"]

# These parameters will be changed between experiments
   variables = ["d5","d2"]


# Pulse sequence
   initpp(dir) # Reset internal parameter list

   cleardata(64000)

   pulse(mode,a1,p1,d1)    # 90 pulse
   delay(d5)               # tau
   pulse(mode,a2,p2,d1)    # 90 pulse
   delay(d2)               # tau+ TE/2

   loop(l1,n1)
      pulse(mode,a2,p3,d1)        # 180 internal pulse
      delay(d3)                   # 180 - acq delay
      acquire("sum",n2,d4)     # Acquire echo and wait
   endloop(l1)

   lst = endpp() # Return parameter list

# Phase cycle
   phaseList = [0,2,0,2;
               1,1,3,3;
               1,1,1,1;
               0,2,0,2]

endproc(lst,tabs,interface,relationships,variables,null,phaseList)

#####################################################
# Assign those parameters which should take their 
# values from the factory defaults when making a 
# new experiment
#####################################################

procedure(getFactoryBasedParameters, par)

   probeHeadPars = SEpm:loadProbeHeadPars()
   assignlist(probeHeadPars)

   specPar = gData->specParameters
   if(specPar == null)
      return(null)
   endif
 
   par = ["rxGain          = 31",
          "dwellTime       = 0.5",
          "pulseLengthCh1  = $pulseLength$",
          "90AmplitudeCh1  = $90Amplitude$",
          "180AmplitudeCh1 = $180Amplitude$",
          "echoShift       = $echoShift$",
          "rxPhase         = $rxPhase$",
          "b1FreqCh1       = $b1Freq$",
          "gradient        = $gradient$"]

endproc(par)
