#########################################################
# 
# The is the entry point for the KeaExpert 
# interface. It will add the experiment to the parameter
# list or with the shift key pressed open the
# relevant macros in the pulse program compiler.
#
# Autogenerated 
#
#########################################################

procedure(SEpm, parameters=null)

   macroLocation = getmacropath()
   parentPath = getbasepath(macroLocation)

   if(iskeypressed("shift"))
      PulseProgramCompiler(guiwinnr(),null,parentPath,"SEpm")
   elseif(iskeypressed("control"))
      gView->showExperimentHelp("SEpm")
   else
      gExpt->addExperiment(parentPath,"SEpm",parameters)
   endif

endproc()

#########################################################
# 
# Provide a backdoor interface to this macro. This 
# adds ["d5","d2"] to the user interface list (guipar)
# and also generates the pulse program lists required 
# by execpp. Finally is calls execpp, returning any
# results in the structure 'r'.
#
# Autogenerated 
#
#########################################################

procedure(backdoor, guipar)

   seqInfo = :getseqpar()  
   r = gSeq->initAndRunPP(getmacropath(), getmacroname(), guipar, seqInfo)

endproc(r)

#########################################################
# 
# Returns important pulse sequence parameter lists
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
# Autogenerated 
#
#########################################################

procedure(getseqpar)

   rel = ["a1 = 90AmplitudeCh1",
          "a2 = 180AmplitudeCh1",
          "d1 = pulseLengthCh1",
          "d2 = 1000*tauMin+echoTime/2-d1-pgo-1",
          "d3 = echoTime/2-acqTime*500-d1/2-1+rxLat+echoShift",
          "d4 = echoTime-d1-pgo-1-d3",
          "d5 = 1000*tauMin-d1-pgo-1",
          "n1 = nrEchoes",
          "n2 = nrPnts",
          "totPnts = nrPnts",
          "totTime = acqTime"]
   var = ["d5","d2"]
   pp_list = ["a1","p1","d1","d5","a2","p2","d2","n1","l1","p3","d3","n2","d4"]
   pp_name = "SEpm.p"
   phase_list = [0,2,0,2;1,1,3,3;1,1,1,1;0,2,0,2]

   seqInfo = struct(rel,var,pp_list,pp_name,phase_list)

endproc(seqInfo)
 # :printOptTauMaxSSEpm();


#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex,ext)


# Make all gui parameters available
   assignlist(guipar)

   probeHeadPars = SEpm:loadProbeHeadPars()

   Sensor = getlistvalue(probeHeadPars,"Sensor")

# Save parameter 
   gParam->saveToDefaults(queries = "no")


############ Check for total RF duty cycle################################################################################################
   TDC=pulseLengthCh1*nrEchoes/repTime
#pr Sensor
# for PM25----------------------------------------------
    if ((TDC>1.6)&(Sensor == "PM25")) 
       message("Error","RF duty cycle is too high, reduce nrEchoes or increase repTime. Total duty cycle is currently $TDC$. Maximum allowed is 1.6","error") 
       return(0)
# for PM5----------------------------------------------
    elseif ((TDC>3) & ((Sensor == "PM5")|(Sensor == "PM10"))) 
       message("Error","RF duty cycle is too high, reduce nrEchoes or increase repTime. Total duty cycle is currently $TDC$. Maximum allowed is 3","error") 
       return(0)
    endif


# Check for p.s. duty cycle should be < 20%
  if(d1/(echoTime) > 0.25)
      message("Error","Duty cycle is too high in pulse sequence!\rshould be < 25%\rIncrease echo time\ror reduce pulse length.","error")
      return
   endif

   if(0==:checkDelay(d1,1)); return; endif
   if(0==:checkDelay(d2,1)); return; endif
   if(0==:checkDelay(d3,1)); return; endif
   if(d4-ucsRun:getAcqTime(guipar) < 1)
      message("Error","Pulse sequence timing error!\rReduce acquisition time or increase echotime.","error")
      abort("")
   endif

   if(0==:checkDelay(d5,1)); return; endif

   sumData = cmatrix(totPnts)

# calculate the time axis 
   totalTime = matrix(totPnts)
   totalTime = ([0:1:totPnts-1]/totPnts)*totTime*1000

   tauAxis  = matrix(nrPntsTau)
   tauAxis3 = matrix(nrPntsTau)
   
   gradientTperMeter= gradient/42.57
# the factor 1000 is to change from seconds to ms 
   t2Diff = 1000*(DEst*1e-9*(2/3)*(gamma*gradientTperMeter)^2)^(-1/3)

   amax = exp(-(tauMin/t2Diff)^3)
   amin = exp(-(tauMax/t2Diff)^3)
   astep= (amax-amin)/(nrPntsTau-1)

   for(m = 0 to nrPntsTau-1)
    #lineal time increment
      if(index=="lin")
        tauAxis[m] = tauMin+ m*(tauMax-tauMin)/(nrPntsTau-1) 
      endif 
   #exponetial time increment
      if(index=="exp") 
        tauAxis[m] = t2Diff*(-loge(amax-astep*(m)))^(1/3)
      endif
   next(m)

   if (tauMax >3*t2Diff)
      tauAxis[nrPntsTau-1]= tauMax
   endif

   tauAxis3[~] = 1e-9*(2/3)*(gamma*gradientTperMeter)^2*(tauAxis[~]/1000)^3

   try
      if(excecutedBackdoor == "yes")
     # pr "SEpmE excuted via backdoor\n"
      endif 
   catch
      executedBackdoor = "no"
      refSignal = 1
      (prFID,prLin,prLog) = ucsPlot:getPlotReferences()
   endtry

   # Reset the timer
  # time(0)  

   ampAxis    = matrix(nrPntsTau)
   noiseAxis = matrix(nrPntsTau)

   #loop for the 2D experiment
   for(m = 0 to nrPntsTau-1)
      
      tauD = 1000*tauAxis[m]
  
      d5 = tauD -d1-pgo
      d2 = tauD +echoTime/2-d1-pgo

      if((d2<0.5)|(d2>25000))
         pr "\n delay (d2 = $d2$ us) is out of range \n" 
         return
      endif

      if((d5<0.5)|(d5>25000))
         pr "\n delay (d5 = $d5$ us) is out of range \n"
         return
      endif
    
      ppList = ucsRun:setPPDelay(ppList,varIndex[0],d5)
      ppList = ucsRun:setPPDelay(ppList,varIndex[1],d2)


  # reset sumData
      sumData = cmatrix(totPnts)
   
   # Accumulate scan
      for(scan = 0 to nrScans-1)
     
       # Note the time at scan start
         t1 = time()   
   
       # Set phases for this scan
         (ppList,pAcq) = ucsRun:setPPPhase(ppList,scan,pcList,pcIndex)
   
       # Send all parameter values to spectrometer (DSP)/generate event table (FX3)
         ucsRun:updatePPParameters(ppList,guipar)
   
       # Wait for the repetition time to complete
         check = ucsRun:checkTiming(guipar,scan,pcList)
         if(check == "abort")
            return(0)
         endif

       # Collect the data
         (status,data) = ucsRun:getData(totPnts,guipar)
         data = data/nrEchoes

       # See if stop button/escape key pressed
         if(status != "ok")
            return(0)
         endif
   
       # Accumlate the data
         sumData = ucsRun:accumulate(accumulate,pAcq,sumData,data)
   
#        :graphTime2(sumData/refSignal,scan,totalTime,m,guipar)

       # Plot the FID 
         ucsPlot:graphTime(prFID,totalTime,sumData/refSignal,scan,guipar)
    
       # Check if complete button pressed
         if(check == "finish")
            exitfor()
         endif 

      next(scan)
 

    # Scale the data and save in amplitude axis array
      sumData = sumData/(nrScans*refSignal)
      ampAxis[m] = sum(real(sumData))/nrPnts
      noiseAxis[m] = sum(imag(sumData))/nrPnts

    # Linear amplitude vs. tau plot
      prLin->draw("false")  
      prLin->plot(tauAxis,ampAxis + i*noiseAxis,
          "tracetype", "lines",
          "tracecolor",wvDataSymbolColor,
          "symbolshape","opensquare",
          "symbolcolor",wvDataSymbolColor)
      prLin->xlabel("\G(d) [ms]") 
      prLin->ylabel("Probe output amplitude (raw)")
      prLin->title("Echo decay")
      prLin->draw("true")  

    # Normalised amplitude vs. log tau^2 plot
      prLog->draw("false")
      prLog->plot(tauAxis3,ampAxis/ampAxis[0],
          "tracetype", "lines",
          "tracecolor",wvDataSymbolColor,
          "symbolshape","opensquare",
          "symbolcolor",wvDataSymbolColor)
      prLog->xlabel(" 2/3 \G(g)^(2) G_(0)^(2) \G(t)^(3) (10^(9) m^(-2)s)") 
      prLog->ylabel("Signal amplitude")
      prLog->title("Spin Echo decay")
      prLog->draw("true")
      
    # Check if complete button pressed
      if(check == "finish")
         exitfor()
      endif


   next(m)

#   if(excecutedBackdoor=="yes")
#
#       return(tauAxis,ampAxis)
#
#   else
#
#       :SEpmFit(tauAxis3,ampAxis,guipar)
#   endif


   if(executedBackdoor == "no")
      (stats,results) = :SEpmFit(prLog,tauAxis3,ampAxis,noiseAxis,guipar)
      ucsFiles:saveToNotes(stats, guipar)
   endif

   ucsFiles:savePlot(prLin,:getPlotInfo("pt2"),guipar,"noReport")
   ucsFiles:savePlot(prLog,:getPlotInfo("pt3"),guipar,"noReport")

#   if(executedBackdoor == "yes")
#      return(tauAxis,ampAxis)
#   endif

# Pack the data into a structure  
   result = struct()
   result->qAxis = tauAxis3
   result->tauArray = tauAxis
   result->ampAxis = ampAxis
#   result->E0 = E0
#   result->T1 = T1
   result->stats = stats
   result->results = results
   return(result)

## Increment the experiment number
#   keaNMR:incrementExperiment(incExpNr)
#        
#   keaNMR:titleReset()

endproc("execpp")


########################################################
# Get the name of a plot file given the region name
# or return the whole list
########################################################

procedure(getPlotInfo,plotRegion)

   info = ["pt2","linData.pt1","pt3","logData.pt1"]

   if(plotRegion == "all")
      return(info)
   endif

   idx = getlistindex(info,plotRegion)
   if(idx != -1)
      return(info[idx+1])
   endif

endproc(null)

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,tauAxis,tauAxis2,ampAxis)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")

   save("data.1d",ampAxis)    # Save data in Prospa format
   save("data.pt1")                     # Save plot
   save("data.emf","emf1d")             # Save plot as picture
   n = size(ampAxis)
   m = matrix(3,n)
   m[0,~] = tauAxis'
   m[1,~] = tauAxis2'
   m[2,~] = real(ampAxis)'

   export2dpar("ab","ascii","xyrc","real","delimiter","tab")
   export2d(m,"data.dat")  # Save data for origin

# Restore cwd
   cd(bak)


endproc("saveData")


##########################################################
# 
##########################################################
procedure(graphTime2,fidData,n,t,ne,guipar)

   assignlist(guipar)

# Allow for accumulations
   if(accumulate == "yes")
      sf = 1/(n+1)
   else
      sf = 1
   endif

# Select units
   if(wvUnits == "uV")
     
      ampUnits = "\G(m)V"
   else
      ampUnits = "mV"
      sf = sf * 0.001
   endif

   drawplot("false")
   
   curplot("1d",1,1) 
   plot(t,fidData*sf)
   xlabel("time(us)") 
   ylabel("Probe output amplitude ($ampUnits$)")
   title("Scan ($(n+1)$/$nrScans$)")
   drawplot("true")

endproc()


##########################################################
# 
##########################################################

procedure(SEpmFit,plt,tauAxis2,ampAxis,noiseAxis,guipar)

   assignlist(guipar)

   (x,y,nrPntsNew) = :removeNegativeValues(tauAxis2,ampAxis/ampAxis[0],nrPntsTau)
   
   yln = loge(y)

   (a,b,aErr,bErr) = linfit:fit(x,yln)
    aStr = errorstr(-a,aErr,1,3)
    bStr = errorstr(b,bErr,1,3)
  
   # Print out results
   pr("\n\n   D = $aStr$ m^-2s\n")
  # pr("\n   intercept .. $bStr$\n")

   yfit = matrix(nrPntsNew)
   yfit[~] = b + a*x[~]

   plt->draw("false")

   plt->plot(x,yfit,
         "tracetype","lines",
         "tracewidth",1,
         "symbolshape","none",
         "tracecolor",[0,128,0])
  
   plt->hold("on")

   plt->plot(x,yln,
          "tracetype", "none",
          "tracecolor",[0,128,0],
          "symbolshape","opensquare",
          "symbolcolor",[255,0,0])
   plt->xlabel("(\G(D)-2/3\G(d)) \G(g)^(2) G_(0)^(2) \G(d)^(2) (10^(9) m^(-2)s)") 
   plt->ylabel("ln (amplitude)")
   plt->title("D = $aStr$ 10^(-9) m^(2)/s")
   plt->hold("off")
   plt->draw("true") 

   # Save some statistics
   printtostring()
   pr("\n   Number of points: $nrPntsTau$\n")
   pr("      Fit residuals sd = $sd(y-exp(yfit))$\n")
   pr("      Data noise sd = $sd(noiseAxis/ampAxis[0])$\n")
   pr("\n\n   D = $aStr$ m^-2s\n")

   
   stats = closeprint()
   print("$stats$")
   results = aStr
endproc(stats,results)


##########################################################
# 
##########################################################

procedure(removeNegativeValues,t,data,nrPnts) 
  
  countNeg = nrPnts

  for (x = 0 to nrPnts-1 step 1)
     if (data[x]< 0.001)
         countNeg=x
     endif
  next(x)

  if (countNeg<nrPnts)
     pr "\n Some negative data points were removed before fitting\n"
  endif

  tNew = submatrix(t   ,0,countNeg-1) 
  dadaNew = submatrix(data,0,countNeg-1) 
  
endproc(tNew,dadaNew,countNeg)


##########################################################
# 
##########################################################
procedure(printOptTauMaxSEpm,nada)

    guipar = getctrlvalues(0)
    assignlist(guipar)

    try
      gradientTperMeter = gradient/42.57
      # the factor 1000 is to change from seconds to ms 
      t2Diff = 1000*(DEst*1e-9*(2/3)*(gamma*gradientTperMeter)^2)^(-1/3)
      if(nrArgs==0)
        pr "\n Optimum tauMax ~ $t2Diff,3.2g$ ms  \n" 
      endif
   catch
      return -1 
   endtry  

endproc(t2Diff)

##########################################################
# Check the dxValues in the dxNames list. Make sure the 
# values are greater than the limits
##########################################################


procedure(checkDelay,dx,limit)
 
   if (dx<= limit)
      message("error","Pulse sequence timing error","error")
      return (0)
   endif 
endproc(1)



########################################################
# Load selected Probe Head parameters
########################################################
procedure(loadProbeHeadPars)

   cd(getparentpath(getmacropath()))
   cd(".ProbeHeads")
   probeHeadPars = load("selectedProbeHead.par")

endproc(probeHeadPars)
