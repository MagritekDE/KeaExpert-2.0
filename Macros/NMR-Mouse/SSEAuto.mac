procedure(SSEAuto, parameters=null) 
 
   if(EditIfShiftPressed(getmacropath(),getmacroname()))
      return
   else # Add the experiment with interface


   cd(getmacropath())
   cd(".ProbeHeads")

    if(isfile("selectedProbeHead.par"))   
      selectedProbeHead = load("selectedProbeHead.par")
    else
      message("Error!","File with selected probe head parameters is not found!\rPlease run SelectProbeHead first!","info")
      return()
    endif

      if(parameters == null)
         parameters = ["Sensor      =\"PM25\"",
                       "Probe       =\"1H-L\"",
                       "Spacer   =\"PM25-20mm\"",
                       "nrScans     =4",
                       "nrEchoes    =16", 
                       "repTime     =500", 
                       "resolution  =90", 
                       "refSignal   =5",
                       "depths      =4500",
                       "maxDepth    =5500",
               #        "position = """,
                       "DEst = 2",
                       "tauMin = 0.02",
                       "tauMax = 0.2", 
                       "DELTA = 10",
                       "nrPntsTau = 8", 
                       "index       = \"exp\"",

# parametesr for processing tab of CPMGFast
                      "alpha          = 1",
                      "autoPhase      = \"no\"",
                      "fitMode        = \"manual\"",
                      "fitType        = \"exp\"",
                      "ignoreFirstPnt = \"yes\"",
                      "enableLift = \"yes\"",
                      "normalize      = \"yes\"",
                      "phaseMethod    = \"maxreal\"",
                      "x_maximum      = 100",
                      "x_minimum      = 1"
                     ] 

      loadedPars = :loadLastPar()
#      pr loadedPars
#
#      loadedPars = rmfromlist(loadedPars,"expName")
#      loadedPars = rmfromlist(loadedPars,"softwareVersion")
#      pr loadedPars

#pr "1\n"
      parameters = sortlist(mergelists(loadedPars,parameters))
#
#pr "2\n"

      parameters = sortlist(mergelists(selectedProbeHead,parameters))

#pr "3\n"
#pr parameters
      endif
      
      gExpt->addExperiment(getmacropath(),rmext(getmacroname()),parameters)
   endif


   #:updateDepths()

endproc()

