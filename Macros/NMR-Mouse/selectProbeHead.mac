#####################################################################
# Update information about current probehead, spacer, etc.
#
# Based on corresponding macro from PMXX MOUSE Prospa folder
#
# Initial version
#
# - added callback to set up the lists in the interface
# - it uses the "selectedProbeHEad.par" file to fill in parameters
#
# Bulat Gizatullin
# August 2026
#
# Copyright (c) Magritek Ltd 2025
#####################################################################

procedure(selectProbeHead, parameters=null) 
 
   if(EditIfShiftPressed(getmacropath(),getmacroname()))
      return
   else # Add the experiment with interface


   (selectedProbeHead,error) = :checkSelectedProbeHeadFile()

      if (error)
         return()
      elseif ((parameters == null)&(selectedProbeHead != null))

         assignlist(selectedProbeHead)
         spacerName = rmsubstr(Spacer,".par")
         print ("The current selected probe configuration is:\n Sensor: $Sensor$\n Probe:  $Probe$\n Spacer: $spacerName$\n")

         sensorList = :getParList("Sensor")

         selectText = "select.."

         if (size(sensorList) == 1)

            probeList = :getParList("Probe",sensorList[0])
         else
            Sensor  = selectText
            probeList = ""
         endif


         if ((size(probeList) == 1) & (size(sensorList) == 1))
            Probe = probeList[0]
         else
            Probe  = selectText
         endif

         parameters = [
                       "Sensor  = \"$Sensor$\"",
                       "Probe   = \"$Probe$\"",
                       "Spacer  = \"$selectText$\""
                      ] 

      elseif ((parameters == null)&(selectedProbeHead == null))

         print ("The current selected probe configuration is not set up! Run selectProbeHead protocol!\n")
         selectText = "select.."
         selectText1 = "select previous.."
         parameters = [
                       "Sensor  = \"$selectText$\"",
                       "Probe   = \"$selectText1$\"",
                       "Spacer  = \"$selectText1$\""
                      ] 
      endif

      gExpt->addExperiment(getmacropath(),rmext(getmacroname()),parameters)
   endif

#pr "end of start\n"

endproc()

###########################################################
# The interface control(s) required by Expert when loading
# data from a experimental result
###########################################################

procedure(interface)

#pr "in INTERFACE \n"
#   parameters = getctrlvalues(0)
#pr parameters
#
#   try
##     (sensorList, probeList, spacerList) = :getHardwareLists() # lists are for the menus, values from that list are in updateUI procedure
#           (sensorList, probeList, spacerList) = :getProbeHeadsList() # just get any possible configuration to set up interface
#   catch
#         pr lasterror()
#     (sensorList, probeList, spacerList) = :getSelectedHardwareLists() # if selected from the menu and there is another protocol in the gui
#
#   endtry

   sensorList = :getParList("Sensor")
   
   
   if ((size(sensorList)) == 1)
      probeList = :getParList("Probe",sensorList[0])
   
   else
      probeList = ""
   endif
   
   
   if ((size(probeList) == 1) & (size(sensorList) == 1))
      spacerList = :getParList("Spacer",sensorList[0],probeList[0])
   else
      spacerList = ""
   endif


   ctrlLayout = ["",             "Hardware configuration","dv",            "",                   "",
#                 "Sensor",       "Sensor",               "tm_wide,proc",   "readonly_string",    "$sensorList$", 
#                 "Probe",        "Probe",                "tm_wide,proc",   "readonly_string",    "", 
#                 "Spacer",       "Spacer",               "tm_wide",   "readonly_string",    "", 
