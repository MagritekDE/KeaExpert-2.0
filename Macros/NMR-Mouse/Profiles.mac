###########################################
# Check depths parameters
##########################################

procedure(checkDepthPars,parameters)

   assignlist(parameters)
   
  # checking measuring depth range
    if((initDepth < -200)|(initDepth>maxDepth))
      message("Warning !!!","Initial depth out of range","info")
      return(1)
    endif

    if((finalDepth < -1000)|(finalDepth>maxDepth))
      message("Warning !!!","Final depth out of range","info")
      return(1)
    endif

    if((initDepth < finalDepth))
      message("Warning !!!","Initial depth has to be larger than final depth","info")
      return(1)
    endif

    if(   (  ((initDepth-finalDepth)/stepSize) ^2^0.5) - (trunc(((initDepth-finalDepth)/stepSize))^2^0.5) > 0)
      message("Warning !!!","Depth Range has to be a mulitple of the step size","info")
      return(1)
    endif

endproc()



###############################################
# Check the contrast parameters
###############################################

procedure(setParContrast, contrastNum, parameters)

#     if(nrArgs==0);  n=0; endif
#     if (n==-1); return;  endif

      assignlist(parameters)

      parContrast = eval("parContrast$contrastNum$")

      echoTokens  = parse(parContrast, ",") # extract initial and final echoes according to contrast
      echoIni= eval(echoTokens[0])
      echoFin= eval(echoTokens[1])



     if((echoIni==-1)|(echoFin==-1))
        message("Error!!!","Wrong value for contrast parameters $contrastNum$.","error")
        return(1)
     endif

     obj = findobj(0,"name",parContrast)
    
     if(echoIni > nrEchoes)
       message("Error!!!","Initial echo > total number of echoes.","error")
       echoIni = 1 
       templist = ["parContrast$contrastNum$ = 1,$echoFin$"]
       setctrlvalues(0,templist)
       return(1)
     endif

     if(echoFin > nrEchoes)
       message("Error!!!","Final echo > total number of echoes.","error")
       echoFin = nrEchoes
       templist = ["parContrast$contrastNum$  = $echoIni$,$nrEchoes$"]
       setctrlvalues(0,templist)
       return(1)
     endif

     if(echoIni > echoFin)
       message("Error!!!","Final echo < initial echo.","error")
       echoIni = 1
       templist = ["parContrast$contrastNum$  = 1,$echoFin$"]
       setctrlvalues(0,templist)
       return(1)
     endif
   
endproc(0)


###############################################
# Check the weightning parameters
###############################################

procedure(setParW, weightStr, parameters) # Ini or Fin for weightStr

#     if(nrArgs==0);  n=0; endif
#     if (n==-1); return;  endif

      assignlist(parameters)

      parWeight = eval("parAmp$weightStr$")

      echoTokens  = parse(parWeight, ",") # extract initial and final echoes according to contrast
      echoIni= eval(echoTokens[0])
      echoFin= eval(echoTokens[1])



     if((echoIni==-1)|(echoFin==-1))
        message("Error with Amp.$weightStr$!!!","Wrong value for weight function.","error")
        return(1)
     endif

     obj = findobj(0,"name",parWeight)
    
     if(echoIni > nrEchoes)
       message("Error with Amp.$weightStr$!!!","Initial echo > total number of echoes.","error")
       echoIni = 1 
       templist = ["parAmp$weightStr$ = 1,$echoFin$"]
       setctrlvalues(0,templist)
       return(1)
     endif

     if(echoFin > nrEchoes)
       message("Error with Amp.$weightStr$!!!","Final echo > total number of echoes.","error")
       echoFin = nrEchoes
       templist = ["parAmp$weightStr$  = $echoIni$,$nrEchoes$"]
       setctrlvalues(0,templist)
       return(1)
     endif

     if(echoIni > echoFin)
       message("Error with Amp.$weightStr$!!!","Final echo < initial echo.","error")
       echoIni = 1
       templist = ["parAmp$weightStr$  = 1,$echoFin$"]
       setctrlvalues(0,templist)
       return(1)
     endif


######### if it is Ini par
   if (weightStr == "Ini")
      
      parWeightOpp = eval("parAmpFin")

      echoTokensOpp  = parse(parWeightOpp, ",") # extract initial and final echoes according to contrast

      echoIniOpp= eval(echoTokensOpp[0])
      echoFinOpp= eval(echoTokensOpp[1])

      if(echoFin>echoIniOpp)
         message("Error with Amp.$weightStr$!!!","Wrong range for weight function.\n Amp. ini. final > Amp. fin. initial","error")

         echoFin = echoIniOpp
         templist = ["parAmp$weightStr$ = $echoIni$,$echoFin$"]
         setctrlvalues(0,templist)

         return(1)
      endif

   elseif(weightStr == "Fin")


      obj = findobj(0,"name","parAmpIni")    
      parAmpIni = getpar(0,obj,"text") # update parAmpIni after prevoius check

      parWeightOpp = eval("parAmpIni")
      echoTokensOpp  = parse(parWeightOpp, ",") # extract initial and final echoes according to contrast
      echoIniOpp= eval(echoTokensOpp[0])
      echoFinOpp= eval(echoTokensOpp[1])

      if(echoIni<echoFinOpp)
         message("Error with Amp.$weightStr$!!!","Wrong range for weight function.\n Amp. ini. final > Amp. fin. initial","error")

         echoIni = echoFinOpp
         templist = ["parAmp$weightStr$ = $echoIni$,$echoFin$"]
         setctrlvalues(0,templist)

         return(1)
      endif

   else

      message("Error!!!","Wrong code for Amp parameters.","error")
      return(1)

   endif


   
endproc(0)


##########################################################
# Fills in temporary data with existing data sets
# for further saving
#########################################################



procedure(fillDataForExport,depthAxis,contrast1Axis,contrast2Axis,contrast3Axis,wAxis,parameters,nrSteps)
  
        assignlist(parameters)

        if((enableContrast2=="no")&((enableContrast3=="no"))&(enableW=="no")) # only Contrast 1, C1
           tempData = matrix(2,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
        endif

        if((enableContrast2=="yes")&((enableContrast3=="no"))&(enableW=="no"))# C1 and C2
           tempData = matrix(3,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = contrast2Axis'
        endif

        if((enableContrast2=="no")&((enableContrast3=="yes"))&(enableW=="no"))# C1 and C3
           tempData = matrix(3,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = contrast3Axis'
        endif

        if((enableContrast2=="yes")&((enableContrast3=="yes"))&(enableW=="no")) # C1,C2, and C3
           tempData = matrix(4,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = contrast2Axis'
           tempData[3,~] = contrast3Axis'
        endif

        if((enableContrast2=="no")&((enableContrast3=="no"))&(enableW=="yes")) # C1 and W
           tempData = matrix(3,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = wAxis'
        endif

        if((enableContrast2=="yes")&((enableContrast3=="no"))&(enableW=="yes")) #C1 C2 W
           tempData = matrix(4,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = contrast2Axis'
           tempData[3,~] = wAxis'
        endif

        if((enableContrast2=="no")&((enableContrast3=="yes"))&(enableW=="yes"))# C1 C3 W
           tempData = matrix(4,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = contrast3Axis'
           tempData[3,~] = wAxis'
        endif

        if((enableContrast2=="yes")&((enableContrast3=="yes"))&(enableW=="yes")) #C1 c2 C3 W
           tempData = matrix(5,nrSteps)
           tempData[0,~] = depthAxis'
           tempData[1,~] = contrast1Axis'
           tempData[2,~] = contrast2Axis'
           tempData[3,~] = contrast3Axis'
           tempData[4,~] = wAxis'
        endif

endproc(tempData)

