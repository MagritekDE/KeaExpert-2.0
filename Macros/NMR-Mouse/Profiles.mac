########################################################
# Load Last parameters from the file
########################################################

procedure(loadLastPar)

    back =  getcwd()
   
    name = getmacroname()
    name = rmext(name)
    cd(getmacropath())

    if(isfile("$name$LastExp.par"))
      pars = load("$name$LastExp.par")

      pars = rmfromlist(pars,"expName")
      pars = rmfromlist(pars,"softwareVersion")

    else
      message("Warning!!!","File with initital parameters not found!\rPlease set up correct parameters in the interface and run it!","info")
      pars = null
    endif
    

   setcwd(back)



endproc(pars)


##################################
# Compare hardware parameters in teh interface with selected ones
##################################

procedure(checkInterfaceHardwareConfig,parameters)

   assignlist(parameters)

   cd(getmacropath())
   cd("ProbeHeads")
   selectedProbeHead = load("selectedProbeHead.par")

   if ((Sensor!=(getlistvalue(selectedProbeHead,"Sensor")))|(Probe!=(getlistvalue(selectedProbeHead,"Probe")))|(Spacer!=(getlistvalue(selectedProbeHead,"Spacer"))))
      message("Error","Sensor-Probe-Spacer do not match selected ones!\r Check the selectProbeHead macro! ","error")
      return(1)
   endif

endproc(0)



