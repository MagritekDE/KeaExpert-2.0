procedure(5compPi_gui)

   n = :windowdefinition()
   :loadPix()
   if(:loadParameters()) 
      :updateValues(); 
   endif 
   showwindow(n)

   multiplot("1d",2,1)
   curplot("1d",1,1)
   title("Transmit")
   curplot("1d",2,1)
   title("Receive")

endproc()

