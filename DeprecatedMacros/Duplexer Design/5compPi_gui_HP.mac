###########################
# Receive mode
#
# >---- L1 -------L2--->
#   |        |       |
#   C1      C2       C3
#   |        |       |
#  Gnd      Gnd     Gnd
###########################

procedure(receive)
   
   guipar = getctrlvalues(0)
   assignlist(guipar)
   
   
   # Set up values
   if(l1units = "uH")
      L1 = (l1min+(l1max-l1min)/100*L1slide)*1e-6
      L2 = (l2min+(l2max-l2min)/100*L2slide)*1e-6
   endif
   if(l1units = "nH")
      L1 = (l1min+(l1max-l1min)/100*L1slide)*1e-9
      L2 = (l2min+(l2max-l2min)/100*L2slide)*1e-9
   endif
   
   if(funits = "kHz")
      fmin = fmin*1e3
      fmax = fmax*1e3
   endif
   if(funits = "MHz")
      fmin = fmin*1e6
      fmax = fmax*1e6
   endif
   
   if(CapUnits = "nF")
   c1 = (c1min+(c1max-c1min)/100*c1slide)*1e-9
   c2 = (c2min+(c2max-c2min)/100*c2slide)*1e-9
   c3 = (c3min+(c3max-c3min)/100*c3slide)*1e-9
   endif
   if(CapUnits = "pF")
   c1 = (c1min+(c1max-c1min)/100*c1slide)*1e-12
   c2 = (c2min+(c2max-c2min)/100*c2slide)*1e-12
   c3 = (c3min+(c3max-c3min)/100*c3slide)*1e-12
   endif
   
   x = [fmin :.001*(fmax-fmin):fmax] 
   
   omega = 2*pi*x

   c1 = c1 + 20e-12
   c2 = c2 + 5e-12
   c3 = c3 + 5e-12
   c4 = 1e-9
   
   R = 50
   Xc1 = 1/(i*omega*c1)
   Xc2 = 1/(i*omega*c2)
   Xc3 = 1/(i*omega*c3)
   Xc4 = 1/(i*omega*c4)
   XL1 = i*omega*L1
   XL2 = i*omega*L2
   
   z4 = R*Xc3/(R+Xc3)
   z2 = z4+XL2
   z3 = z2.*Xc2/(z2+Xc2)
   z1 = (XL1 + z3).*Xc1/(Xc1+XL1+z3)
   
   v2 = z1/(R+z1)
   v3 = v2.*z3/(z3+XL1)
   v4 = v3.*z4/(XL2+z4)
  # v4 = v4*50/(Xc4+50)
   

   curplot("1d",2,1)
   draw1d("false")
   plot(x/1e6,mag(v4))
   #plot(x/1e6,mag(v3)) # Voltage across cap 2
   #plot(x/1e6,mag(v2)) # Voltage across cap 1
   zoom1d(fmin/1e6,fmax/1e6,0,0.55)
   title("Receive")
   xlabel("Frequency (MHz)")
   ylabel("Gain")
   draw1d("true")
   

endproc()

#####################################
# Transmit mode
#
# Model used
#     >-C1---L1-RD----- RD--L2------>
#                  |            |
#                C2  R1       C2 RL
#                  |            |
#                 Gnd          Gnd
#
#    >---- L3 -------
#      |        |   |
#      C3      C4   L4
#      |        |   |
#     Gnd      Gnd Gnd
#
# C1 is the input capacitance which 
# determines the response time.
# C2 is stray board capacitiance.
# RD is diode resistance
# L1 and L2 are stray board inductance
# C3, C4, L3 ans L4 are the filter
# components. C3 and C4 also include
# stray capacitance of 10 and 5 pF.
#####################################

procedure(transmit)

   guipar = getctrlvalues(0)
   assignlist(guipar)
   
   # Set up values
   if(l1units = "uH")
      L3 = (l1min+(l1max-l1min)/100*L1slide)*1e-6
      L4 = (l2min+(l2max-l2min)/100*L2slide)*1e-6
   endif
   if(l1units = "nH")
      L3 = (l1min+(l1max-l1min)/100*L1slide)*1e-9
      L4 = (l2min+(l2max-l2min)/100*L2slide)*1e-9
   endif
   
   if(funits = "kHz")
      fmin = fmin*1e3
      fmax = fmax*1e3
   endif
   if(funits = "MHz")
      fmin = fmin*1e6
      fmax = fmax*1e6
   endif
   
   if(CapUnits = "nF")
   C4 = (c1min+(c1max-c1min)/100*c1slide)*1e-9
   C5 = (c2min+(c2max-c2min)/100*c2slide)*1e-9
   C6 = (c3min+(c3max-c3min)/100*c3slide)*1e-9
   endif
   if(CapUnits = "pF")
   C4 = (c1min+(c1max-c1min)/100*c1slide)*1e-12
   C5 = (c2min+(c2max-c2min)/100*c2slide)*1e-12
   C6 = (c3min+(c3max-c3min)/100*c3slide)*1e-12
   endif
   
   x = [fmin :.001*(fmax-fmin):fmax] 
   
   omega = 2*pi*x
   
   C1 = 1e-9 
   RS = 50
   R2 = 50
   R1 = 2350.0

# Stray C, L and R
   L1 = 15e-9
   L2 = 15e-9
   C2 = 20e-12
   C3 = 10e-12
   RD = 1

   C4 = C4 + 10e-12 # Add stray cap
   C5 = C5 + 5e-12 # Add stray cap
 #  C4 = 10e-12
 #  C5 = 44e-12
  # L3 = 800e-9
  # L4 = L3



#   C4 = 20e-16
#   C5 = 50e-16
#   L3 = 0.8e-1
#   L4 = 0.8e-1

   Xc1 = 1/(i*omega*C1)
   Xc2 = 1/(i*omega*C2)
   Xc3 = 1/(i*omega*C3)
   XL1 = i*omega*L1 + RD
   XL2 = i*omega*L2 + RD

   Xc4 = 1/(i*omega*C4)
   Xc5 = 1/(i*omega*C5)
   XL3 = i*omega*L3
   XL4 = i*omega*L4
   
   z1 = Xc1+XL1
   z2 = Xc2.*R1/(Xc2+R1)
   z3 = XL2 
   z4 = Xc3.*R2/(Xc3+R2)
   z5 = XL3 
   z6 = Xc5.*XL4/(Xc5+XL4)
   z7 = z5+z6
   z8 = z7.*Xc4/(z7+Xc4)
   z9 = z8.*z4/(z8+z4)
   z10 = z9+z3
   z11 = z2.*z10/(z2+z10)
   zt = z11+z1

   P_r = (zt-RS)/(zt+RS)
   
  multiplot("1d",2,1)
   draw1d("false")
   curplot("1d",1,1)

   if(TransDisplay = "a")
      P_ref = P_r^2
      plot(x/1e6,mag(P_ref))
      title("Transmit: Reflected Power")
      xlabel("Frequency (MHz)")
      ylabel("Fraction Reflected Power")
   elseif(TransDisplay = "b")
      v2 = z1/(R+z1)
      plot(x/1e6,mag(v2))
      title("Transmit: Voltage Divider")
      xlabel("Frequency (MHz)")
      ylabel("Vout/Vin")
   elseif(TransDisplay = "c")
      VSWR = (1+mag(P_r))/(1-mag(P_r))
      plot(x/1e6,mag(VSWR))
      title("Transmit: VSWR")
      xlabel("Frequency (MHz)")
      ylabel("VSWR")
      zoom1d(min(x)/1e6,max(x)/1e6,0,10)
   endif

#   curplot("1d",3,1)
#   plot(x/1e6,mag(v2/XL2))
#   title("Voltage across L2")
# #  title("Diode current")
#   xlabel("Frequency (MHz)")
# #  ylabel("Current (RMS A)")
#   ylabel("Voltage (RMS V)")
   draw1d("true")
endproc()


######################################################
# Prints the component values
######################################################
procedure(printValues)

   guipar = getctrlvalues(0)
   assignlist(guipar)
   
   L1 = getpar(0, 6, "value")
   L2 = getpar(0, 7, "value")
   c1 = getpar(0, 8, "value")
   c2 = getpar(0, 9, "value")
   c3 = getpar(0, 10, "value")
   
   
   # Set up values
   if(l1units = "uH")
      L1 = (l1min+(l1max-l1min)/100*L1)*1e-6
      L2 = (l2min+(l2max-l2min)/100*L2)*1e-6
   endif
   if(l1units = "nH")
      L1 = (l1min+(l1max-l1min)/100*L1)*1e-9
      L2 = (l2min+(l2max-l2min)/100*L2)*1e-9
   endif
   
   if(funits = "kHz")
      fmin = fmin*1e3
      fmax = fmax*1e3
   endif
   if(funits = "MHz")
      fmin = fmin*1e6
      fmax = fmax*1e6
   endif
   
   if(CapUnits = "nF")
   c1 = (c1min+(c1max-c1min)/100*c1)*1e-9
   c2 = (c2min+(c2max-c2min)/100*c2)*1e-9
   c3 = (c3min+(c3max-c3min)/100*c3)*1e-9
   endif
   if(CapUnits = "pF")
   c1 = (c1min+(c1max-c1min)/100*c1)*1e-12
   c2 = (c2min+(c2max-c2min)/100*c2)*1e-12
   c3 = (c3min+(c3max-c3min)/100*c3)*1e-12
   endif
   
   pr "\r L1 = $L1$ H \r L2 = $L2$ H \r C1 = $c1$ F \r C2 = $c2$ F \r C3 = $c3$ F" 


endproc

###########################################
#
#  Saves the Current parameters
#
###########################################

procedure(saveParameters)

   bakdir = getcwd()
   lst = getctrlvalues(0)
   cd(prefdir)
   mkdir("Other Macros")
   cd("Other Macros")
   save("5comppi_gui.par",lst)
   cd(bakdir)

endproc()

procedure(loadPix)

   bak = getcwd()
   cd(getmacropath())
   setpar(0,49,"file","filter.jpg")
   cd(bak)

endproc()

###########################################
#
#  Loads the Current parameters
#
###########################################

procedure(loadParameters)

   bakdir = getcwd()
   cd(prefdir)
   cd("Other Macros")
   fnd = 0
   if(isfile("5comppi_gui.par"))
     par = load("5comppi_gui.par")
     setctrlvalues(0,par)
     fnd = 1
   endif
   cd(bakdir)
 
endproc(fnd)

procedure(updateValues)

   guipar = getctrlvalues(0)
   assignlist(guipar)

   L1 = (l1min+(l1max-l1min)/100*L1slide)
   L2 = (l2min+(l2max-l2min)/100*L2slide)

   C1 = (c1min+(c1max-c1min)/100*c1slide)
   C2 = (c2min+(c2max-c2min)/100*c2slide)
   C3 = (c3min+(c3max-c3min)/100*c3slide)

   setpar(0,44,"text",L1)
   setpar(0,43,"text",L2)
   setpar(0,42,"text",C1)
   setpar(0,41,"text",C2)
   setpar(0,45,"text",C3)

endproc()

procedure(savePar)

   guipar = getctrlvalues(0)
   bakdir = getcwd()
   cd(workdir)
   name = getfilename("save","Save duplexer parameters","Parameter file","par")
   if(name != "cancel")
     save(name,guipar)
   endif
   assign("workdir",getcwd(),"global")
   cd(bakdir)

endproc()

procedure(loadPar)

   bakdir = getcwd()
   cd(workdir)
   name = getfilename("open","Load duplexer parameters","Parameter file","par")
   if(name != "cancel")
     lst = load(name)
     setctrlvalues(0,lst)
     :updateValues()
   endif
   assign("workdir",getcwd(),"global")
   cd(bakdir)
  

endproc()