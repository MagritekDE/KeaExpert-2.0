#################################################################
#
# NMR Probe calculations
#
#      ------ C2 ---- 
#     |    |          R50
#     L1   C1         |
#     R1   |          2.Vin
#     |    |          |
#     ----------------
#          |
#         ---
# Given the coil inductance L1, resistance R1 and resonant
# frequency this program finds matching C1 
# and C2 values and the probe Q
#
# Given the above parameters and the coil B1/I and the
# desired 180 pulse time it also works out the probe voltages
# and coil current required and from this the input voltage
# Vin.
#
# Given the above parameters sample temperature and volume
# the program can also determine the expected signal level.
#
#
# Copyright : Magritek 2011
# Author : Craig Eccles
# Last modified : 19 June 2011
#
###############################################################

procedure(CalculateProbeInfo)

   n = :windowdefinition()
   setpar(n,3,"enable","false")
   setpar(n,4,"enable","false")
   setpar(n,36,"enable","false")
   setpar(n,35,"enable","false")
   setpar(n,29,"enable","false")
   setpar(n,31,"enable","false")
   setpar(n,40,"enable","false")
   assignctrls(n)
   :loadPar()
   showwindow(n)

endproc()


