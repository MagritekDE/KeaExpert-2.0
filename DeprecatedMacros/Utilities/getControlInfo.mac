procedure(getControlInfo)

   n = :windowdefinition()
   showwindow(n)

endproc()

procedure(windowdefinition)

   # Automatically generated window definition procedure.
   # Any code added manually will be removed if layout modified interactively
   n = window("Get control information", -1, -1, 218, 104, "resizable")

      # Define all controls with basic parameters
       button(1, 62, 57, 85, 31, "Close",closewindow(0))
       button(2, 62, 15, 85, 31, "Select control",:doit())

     # Set other control parameters
endproc(n)

procedure(doit)

   (winNr,objNr) = selectobj()

   pr getobj(winNr,objNr)

endproc()