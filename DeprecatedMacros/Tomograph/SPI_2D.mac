procedure(SPI_2D, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","File settings"] # Tab names
   wv_ctrls = [2,46,47,70,71,91,92,101] # Control groups
   wv_shift = [-14,226,466,469] # Amount to shift control groups
   wv_other = [100,308,771]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"SPI_2D",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d1 = PulseLength90",
          "d500 = 2",
          "n500 = round(PulseLength90/d500)",
          "(t1,t2,gfac) = B1NutSoft:getRFPulse(SPType,a1,n500)",
          "d2 = PulseLength180",
          "dT2StarContrast = t2StarContrast",
          "rampDur = 50",
          "d300 = 2.5",
          "n300 = round(rampDur/d300)",
          "d100 = 50",
          "(del9,del99)   = SPI_2D:getRewindSliceDelay(PulseLength90,sliceComp,rampDur)",
          "d99=del99",
          "d9=del9",
          "d3   = phDur-2*rampDur",
          "d4   = echoTime/2-PulseLength90/2-d9-d99-PulseLength180/2-pgo-3*rampDur",
          "d5   = echoTime/2-d3-4*rampDur+1000*acqTime/2-PulseLength180/2+rxLat+acqShift+dT2StarContrast",
          "n20  = SPI_2D:convertDirToChannel(dirPhase1)",
          "n30  = SPI_2D:convertDirToChannel(dirSlice)",
          "n40  = SPI_2D:convertDirToChannel(dirPhase2)",
          "(gPhaseAmp1,gPhaseAmpShim1,gPhaseAmp2,gPhaseAmpShim2,gSliceAmp,gSliceAmpShim,sliceOffSet) = SPI_2D:setImageGradients(dirPhase1,dirPhase2,dirSlice,FoVPhase1,FoVPhase2,phDur,sliceTickness,sliceShift,gfac,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n31 =  gSliceAmp+gSliceAmpShim",
          "n31a = gSliceAmpShim",
          "n32 = -gSliceAmp+gSliceAmpShim",
          "n21  =  gPhaseAmp1+gPhaseAmpShim1",
          "n21a =  gPhaseAmpShim1",
          "n41  =  gPhaseAmp2+gPhaseAmpShim2",
          "n41a =  gPhaseAmpShim2",
          "f1  =  b1Freq+O1/1e6+sliceOffSet",
          "f2  =  b1Freq+O1/1e6",
          "n1  = nrPnts",
          "totPnts = nrPnts",
          "totTime = acqTime"]
   var = ["n21","n41"]
   pp_list = ["f1","n30","n31a","n31","n300","d300","d100","t1","t2","p1","n500","d500","d99","f2","n32","d9","d4","a2","p2","d2","n20","n21a","n21","n40","n41a","n41","d3","d5","n1"]
   pp_name = "SPI_2D.p"
   phase_list = [0,2;1,1;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

