#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)

   wvPP->multiplot(1,1)
   wvPP2->multiplot(2,2)

#Checks
   :checkDelays(guipar)
   :checkGradPowerSPI_2D(guipar)
   :checkGradDir(guipar)


   sumData = cmatrix(totPnts)

# Calculate suitable time and frequency axes
   totalTime = ([0:1:totPnts-1]/totPnts)*totTime*1000
   f = ([0:1:totPnts-1]-totPnts/2+1)/totTime

# Reset the timer
   time(0)

   kSpace2D = cmatrix(nrStepsP1,nrStepsP2)  

   for(nPh2= 0 to nrStepsP2-1)

      pr nPh2

      grPh2 =  round(2*gPhaseAmp2/(nrStepsP2)*(-(nrStepsP2-1)/2+nPh2)) + gPhaseAmpShim2
      
      ppList = keaNMR:setPPNumber(ppList,varIndex[1],grPh2)
      
      for(nPh1= 0 to nrStepsP1-1)
      
         sumData = cmatrix(totPnts)
      
         grPh1 =  round(2*gPhaseAmp1/(nrStepsP1)*(-(nrStepsP1-1)/2+nPh1)) + gPhaseAmpShim1
      
         ppList = keaNMR:setPPNumber(ppList,varIndex[0],grPh1)
      
                     
      # Accumulate scan
            for(scan = 0 to nrScans-1)
           
             # Note the time at scan start
               t1 = time()   
         
             # Set phases for this scan
               (ppList,pAcq) = keaNMR:setPPPhase(ppList,scan,pcList,pcIndex)
         
             # Send phase parameters to DSP
               dspwrite("x",0x00,ppList)
         
             # Collect the data
               (status,data) = keaNMR:getData(totPnts,guipar)
               if(status != "ok")
                  keaNMR:enableButtons()
                  abort("")
               endif
         
             # Accumlate the data
               sumData = keaNMR:accumulate(accumulate,pAcq,sumData,data)

               if(accumulate=="yes")
                  sf = 1/(scan+1)
               else
                  sf = 1
               endif
         
               pd = wvPP->subplot(1,1)
               pd->draw("false")
               pd->plot(totalTime,sf*real(sumData),"tracecolor",black)
               pd->hold("on")
               pd->plot(totalTime,sf*imag(sumData),"tracecolor",red)
               pd->hold("off")
               pd->title("text","raw data")
               pd->xlabel("text","points")
               pd->ylabel("text","amplitude")
               pd->draw("true")
       
            # Check timing
               check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
               if(check == "abort")
                  return(0)
               elseif(check == "finish")
                  scan = scan+1
                  nPh1 = 10000000000
                  nPh2 = 10000000000
                  exitfor()
               endif
      
            next(scan)
      
            kSpace2D[nPh1,nPh2] = sum(sumData)/nrPnts/sf
            image(kSpace2D)
         
      
         next(nPh1)
    next(nPh2)


   npxPhase1 =2*:FFTsize(nrStepsP1)
   npxPhase2 =2*:FFTsize(nrStepsP2)

   assign("kSpace2D",kSpace2D,"global")

   idata = fft_local:2d(kSpace2D,npxPhase1,npxPhase2,"sinebell","sinebell","FTEcho","FTEcho","yes")
   curplot("2d",2,1)
   image(idata)


   if(saveData == "true")
      :saveData(guipar,kSpace2D,idata)
      keaFiles:incrementExperiment(guipar)
   endif

endproc("execpp")

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,kSpace2D,idata)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")

   export2dpar("ab","binary","xyrc","real","machine","littleend")
   export2d(idata,"rawimage2d.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","complex","machine","littleend")
   export2d(kSpace2D,"rawkSpace2d.2d")  # Save data as an Excel file

   (n1,n2) = size(idata)

   save("$n1$x$n2$.pixels_image","empty")

   (n1,n2) = size(kSpace2D)

   save("$n1$x$n2$.kspace_size","empty")

   temp = getcwd()

   pr "data saved to $temp$"


# Restore cwd
   cd(bak)


endproc("saveData")
#-----------------------------

procedure(getRewindSliceDelay,PulseLength90,sliceComp,rampDur)
   
   d99=2
   d9=PulseLength90/2+sliceComp+d99-0.5*rampDur
   if(d9<=0.25)
      d9=2
      d99=d9+0.5*rampDur-PulseLength90/2-sliceComp
   endif

endproc(d9,d99)
#------------------------------
procedure(setImageGradients,dirPhase1,dirPhase2,dirSlice,FoVPhase1,FoVPhase2,phDur,sliceTickness,sliceShift,gfac,xshim,yshim,zshim,xcal,ycal,zcal)

   guipar = getctrlvalues(0)
   lst = keaNMR:loadPref()
   guipar = guipar + lst
   assignlist(guipar)

   FoVPhase1 = FoVPhase1/1000           # change from mm to m
   FoVPhase2 = FoVPhase2/1000           # change from mm to m
   sliceTickness = sliceTickness/1000   # change from mm to m
   sliceShift = sliceShift/1000         # change from mm to m

   xshim = xshim/1000
   yshim = yshim/1000 
   zshim = zshim/1000  


# phase1
   bandwidthPhase1 =  1e6*0.5*nrStepsP1/(phDur)
   
   if(FoVPhase1==0)
      gPhaseAmpTperM1=0
   else
      gPhaseAmpTperM1 =  bandwidthPhase1/42.57e6/FoVPhase1
   endif
  
   if(dirPhase1 == "x"); ampPhase1 = gPhaseAmpTperM1*xcal; ampPhaseShim1 = xshim*xcal;  endif
   if(dirPhase1 == "y"); ampPhase1 = gPhaseAmpTperM1*ycal; ampPhaseShim1 = yshim*ycal; endif 
   if(dirPhase1 == "z"); ampPhase1 = gPhaseAmpTperM1*zcal; ampPhaseShim1 = zshim*zcal;  endif

# phase2
   bandwidthPhase2 =  1e6*0.5*nrStepsP2/(phDur)
   
   if(FoVPhase2==0)
      gPhaseAmpTperM2=0
   else
      gPhaseAmpTperM2 =  bandwidthPhase2/42.57e6/FoVPhase2
   endif
  
   if(dirPhase2 == "x"); ampPhase2 = gPhaseAmpTperM2*xcal; ampPhaseShim2 = xshim*xcal;  endif
   if(dirPhase2 == "y"); ampPhase2 = gPhaseAmpTperM2*ycal; ampPhaseShim2 = yshim*ycal;  endif 
   if(dirPhase2 == "z"); ampPhase2 = gPhaseAmpTperM2*zcal; ampPhaseShim2 = zshim*zcal;  endif

   bandwidthSlice =  gfac*1e6/(PulseLength90)

   if(sliceTickness == 0)
      gSliceTperM =0
   else
      gSliceTperM    =  bandwidthSlice/42.57e6/sliceTickness
   endif

   if(dirSlice == "x"); ampSlice = gSliceTperM*xcal; ampSliceShim = xshim*xcal; endif
   if(dirSlice == "y"); ampSlice = gSliceTperM*ycal; ampSliceShim = yshim*ycal; endif 
   if(dirSlice == "z"); ampSlice = gSliceTperM*zcal; ampSliceShim = zshim*zcal; endif

   sliceOffSet = gSliceTperM*42.57*sliceShift # in MHz
 
   if(abs(ampPhase1)>20800); ampPhase1 = 0; pr "Phase 1 gradient too high"; endif
   if(abs(ampPhase2)>20800); ampPhase2 = 0; pr "Phase 2 gradient too high"; endif
   if(abs(ampSlice)>20800);  ampSlice = 0; pr "Slice gradient too high"; endif

endproc(round(ampPhase1),round(ampPhaseShim1),round(ampPhase2),round(ampPhaseShim2),round(ampSlice),round(ampSliceShim),sliceOffSet)

procedure(convertDirToChannel,dir)

   if(dir == "x")
        return 3
   endif
   if(dir == "y")
        return 2
   endif
   if(dir == "z")
        return 1
   endif

   if(dir == 3)
        return 3
   endif
   if(dir == 2)
        return 2
   endif
   if(dir == 1)
        return 1
   endif
  
endproc(0)
#-----------------------------
procedure(checkGradPowerSPI_2D,guipar)

   assignlist(guipar)
   refPower=700
   
   #PHASE1 Channel
   p_P1=gPhaseAmp1*gPhaseAmp1*(d3+2*rampDur)*1e-6

   #PHASE2 Channel
   p_P2=gPhaseAmp2*gPhaseAmp2*(d3+2*rampDur)*1e-6

   #SLICE Channel
   p_S=gSliceAmp*gSliceAmp*((PulseLength90+d100+d99+rampDur)+(d9+rampDur))*1e-6
   
   p_mean=(p_P1+p_P2+p_S)/repTime  
   
   if (p_mean>refPower)
      pr "\n Power requirement too high. Increase repetition time. \n"; 
      message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)$ ms","warning")
      abort("")
   endif

endproc()
#-----------------------------
procedure(checkDelays,guipar)
   assignlist(guipar)
   for (k=1 to 1000)
      try
         d_temp=eval("d$k$")
         if(d_temp<=0); pr "\n d$k$<0 \n"; abort(""); endif;  
      catch
      endtry         
   next
endproc()
#-----------------------------
procedure(checkGradDir,guipar)
assignlist(guipar)
if(dirPhase1==dirPhase2)
      message("Waring","Phase dir. 1 should be \r different from Phase dir. 2.","warning")
      abort("")
endif
endproc()

#-----------------------------
procedure(FFTsize,nrPnts)

  m=1
  a = nrPnts
  while(a>1)
     a = nrPnts/2^m
     m = m+1
  endwhile
  r = 2^(m-1)

endproc(r)