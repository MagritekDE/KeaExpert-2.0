#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
# This version performs background subtraction
# when called in the RCA mode.
#
# 26-Nov-2013
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

   guipar = guipar + "timeMag = \"no\""

# Make all gui parameters available
   assignlist(guipar)

# Do some safety checks
   if(d3 <= 0)
     message("Error","Pulse sequence timing error!\rIncrease echo shift parameter.","error")
     wvExpStatus = "stop"
     return(0,0)
   endif
   if(d4 <= 0)
     message("Error","Pulse sequence timing error!\rIncrease echo time or reduce echo shift.","error")
     wvExpStatus = "stop" 
     return(0,0)
   endif
   
   if(d2 <= 0)
      message("Error","Pulse sequence timing error!\r90-180 time too short. Increase the echo time\ror reduce pulse length or damping time.","error")
      wvExpStatus = "stop"
      return(0,0)
   endif

   if(d4-keaRun:getAcqTime(guipar) < -1e-5)
      message("Error","Pulse sequence timing error!\rReduce number of points to $maxN$.","error")
      wvExpStatus = "stop"
      return(0,0)
   endif

 # Check RF duty cycle
   if(keaRun:highDutyCycle(d1*n1,nrEchoes*echoTime,guipar))
      wvExpStatus = "stop"
      return(0,0)
   endif

# Check phase cycling
  if(nrScans%4 != 0)
     if(query("Warning","For correct phase cycling this experiment\rrequires the number of scans be a mulitple of 4.\rDo you wish to proceed?") == "no")
        wvExpStatus = "stop"
        return(0,0)
     endif
  endif

# Calculate suitable time and frequency axes
   tAxis = ([0:1:totPnts-1]/totPnts)*totTime + echoTime

# Allocate data for outputs
   sumData = cmatrix(totPnts)

# Make subplots and define local variables
 
      windowvar(pdInt)
      prt = keaPlot:getPlotRegions(guipar,1,wvPP)
      wvExpStatus = "ok"
      assign("plotCtrl",wvPP,"window")
      autoPhaseMethod = phaseMethod
      bkgPhaseMethod = "useAutoPhase"
      eBak = null
      eqVolFac = 1
   

# Get background noise level if background exists
   if(eBak != null)
     sz = size(eBak)
     if(sz >= totPnts/2)
        ieBak = imag(eBak)
        ns = ieBak[round(size(ieBak)/2):]
        nsBak = keaRun:rmsValue(ns) # Noise is RMS of last half of data set
      else # Ignore background noise if shorter than half sample data
         nsBak = 0
      endif
   else # No background 
     nsBak = 0
   endif   

# Reset the timer
   time(0)  

   if(isvar("plotTab")) # From RCA interface
      targetSNR = t2Snr
      targetScans = t2Scans
      if(t2SnrModeCtrl->text == "minSNR")
         nrScans = 0
      endif
      mode = t2SnrModeCtrl->text
      assign("wvPP",plotCtrl,"global")
      nmrPorosityCtrl->text("--")
      fitMethodCtrl->text("")
      equivVolCtrl->text("--")
   else
      targetSNR = t2Snr
      targetScans = nrScans
      mode = t2SnrMode
   endif
   SNR = 0

# Intialise progress labels
   if(isvar("curScanCtrl"))
      curScanCtrl->text(0)
      progressCtrl->value(0)
      remTimeCtrl->text("00:00")
      curSNRCtrl->text("-")
   endif

# Intialise scan counter
   scan = -dummys

# Estimate repetition time
   repTime = ieTime + (nrEchoes*echoTime)/1000 + 40 # includes heater delay

# Accumulate scan
   while(1)

     if(scan == 0)
        time(0)
     endif

    # Note the time at scan start
      t1 = time()   

    # Set phases for this scan
      (ppList,pAcq) = keaRun:setPPPhase(ppList,scan,pcList,pcIndex)

    # Send phase parameters to DSP
      dspwrite("x",0x00,ppList,wvPort)

    # Collect the data
      (status,data) = keaRun:getData(totPnts,guipar)

      if(status != "ok")
         wvExpStatus = "stop"
         return(0,0)
      endif

      if(scan < 0)
         
         rg = plotCtrl->subplot(1,1) 
         rg->draw("false")
         rg->plot(matrix(totPnts))
         rg->xlabel("Points")
         rg->ylabel("Amplitude")
         rg->title("Dummy scan $-scan$")
         rg->draw("true")

      # Check timing
         check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
         if(check == "abort")
            return(0)
         elseif(check == "finish")
            exitwhile()
         endif

      else

      # Accumlate the data
         sumData = keaRun:accumulate(accumulate,pAcq,sumData,data)

      # Subtract unphased data sets and then autophase
         if(bkgPhaseMethod == "useRawPhase")
      
         # Subtract the background (if any from the data)
            if(eBak != null)
               difference = (scan+1)*RCA.pex:subtractBackgroundData(tAxis/1000,sumData/(nrPnts*(scan+1)),tBak,eBak)
            else
               difference = sumData/nrPnts
            endif
   
         # Phase the result
            if(autoPhase == "yes")
               (ph,sumDataAPDiff) = keaRun:autoPhase(difference,autoPhaseMethod)
            else
               sumDataAPDiff = difference
            endif

      # Autophase data and then subtract phased background
         else # Autophase method

         # Phase the result
            if(autoPhase == "yes")
               (ph,sumDataAP) = keaRun:autoPhase(sumData/nrPnts,autoPhaseMethod)
            else
               sumDataAP = sumData/nrPnts
            endif

         # Subtract the background (if any from the data)
            if(eBak != null)
               sumDataAPDiff = (scan+1)*RCA.pex:subtractBackgroundData(tAxis/1000,sumDataAP/(scan+1),tBak,eBak)
            else
               sumDataAPDiff = sumDataAP
            endif

         endif

       # Get correct labels
         (titleTxt,yTxt) = :getLabels(eBak,eqVolFac,mode,scan,nrScans)

       # Plot the integral data 
         if(isvar("wvT2Mapping"))
            prt->parent->draw("false")
            keaPlot:graphTime(prt,tAxis/1000,sumDataAPDiff*eqVolFac,scan,guipar,
                              titleTxt,"Time (ms)",yTxt)
            prt->axes->xmapping(wvT2Mapping)
            prt->parent->draw("true")
         else
            keaPlot:graphTime(prt,tAxis/1000,sumDataAPDiff*eqVolFac,scan,guipar,
                              titleTxt,"Time (ms)",yTxt)
         endif
       # Update GUI with scans and elapsed time
         if(isvar("curScanCtrl"))
            curScanCtrl->text(scan+1)
         endif

       # See if we are aborting
         if(wvExpStatus == "stop")
            return(0,0)
         endif
  
       # Check timing
         check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
         if(check == "abort")
            return(0)
         elseif(check == "finish")
            exitwhile()
         endif

       # Display current time
         if(isvar("expTimeCtrl"))
            et = time()
            tm = trunc(et/60)
            ts = trunc(frac(et/60)*60)
            expTimeCtrl->text("$tm,02.0f$:$ts,02.0f$")
         endif
   
       # Update GUI with SNR after each 4th scan
         if((scan+1)%4 == 0)
           # Calculate the SNR
            ns = imag(sumDataAPDiff)/(scan+1)
            ns = ns[round(size(ns)/2):-1]
            sd = keaRun:rmsValue(ns) # Noise is RMS of last half of data set
            sig = real(sumDataAPDiff)/(scan+1)
          #  sig = sum(sig[0:9])/10 # Signal is average of first 10 points
            sig = max(sig) # sig is the maximum

            if(sd != 0)
               SNR = sig/sd
            else
               SNR = 0
            endif
       
            if(isvar("curScanCtrl"))
               curSNRCtrl->text("$SNR,1.1f$")
               # See if target SNR has been reached
               if(mode == "minSNR")
                  f = :getTimeFactor(sig,sd,targetSNR,nsBak,scan)
                  if(f == -1)
                     message("Error","Target SNR will not be reached due to background noise.","error")
                     return(0,0)
                  endif
                  progressCtrl->value(round(100/f))
                  remainingTime = et*f-et
                  tm = trunc(remainingTime/60)
                  ts = trunc(frac(remainingTime/60)*60)
                  remTimeCtrl->text("$tm,02.0f$:$ts,02.0f$")
                  if(SNR >= targetSNR)
                     progressCtrl->value(100)
                     remTimeCtrl->text("00:00")
                     exitwhile()
                  endif
               endif
            endif # isvar("curScanCtrl")

         endif # (scan+1)%4
   
       # See if required number of scans has been reached
         if(mode == "fixedScans")
            if(scan+1 >= targetScans)
               exitwhile()
            endif
            if(isvar("remTimeCtrl"))
               if(scan == 0)
                  repTime = (time()-t1)*1000
               else # Keep a running average of repTime
                  repTime = ((time()-t1)*1000 + repTime*scan)/(scan+1)
               endif
               f = (scan+1)/targetScans
               progressCtrl->value(round(f*100))
               remainingTime = (1-f)*targetScans*repTime/1000
               tm = trunc(remainingTime/60)
               ts = trunc(frac(remainingTime/60)*60)
               remTimeCtrl->text("$tm,02.0f$:$ts,02.0f$")
            endif

         endif # mode == "fixedScans"

     endif # scan >= 0

     scan = scan+1

   endwhile() # Scan loop

# Total number of scans completed
   scan = scan+1

# Finalise labels
   if(isvar("curScanCtrl"))
      curScanCtrl->text(scan)
      progressCtrl->value(100)
      remTimeCtrl->text("00:00")
   endif

# Must have a multiple of 4 scan
#   if(scan%4 != 0)
#      message("Warning","Data not saved - multiple of 4 scans required","info")
#      return(0,0)
#   endif

# Make sure the uncorrected plot is saved 
# but the correct plot is visible
# and the phase correction used saved

# Get correct labels
   if(eBak != null)

      titleTxt = "T2 decay data for '$sampleName$'"
     # Phase the raw difference data
      if(bkgPhaseMethodCtrl->text == "useRawPhase")
         (ph,sumDataAP) = keaRun:autoPhase(sumData/nrPnts,autoPhaseMethod)
      endif

      prt->parent->draw("true")
      keaPlot:graphTime(prt,tAxis/1000,sumDataAP,scan-1,guipar,
                        titleTxt,"Time (ms)","Average echo amplitude (\G(m)V)")
      prt->axes->xmapping(wvT2Mapping)
      prt->parent->draw("true")
      keaFiles:save1DData(guipar,tAxis/1000,sumDataAP/scan)
     # Plot the phased corrected+calibrated data
     (titleTxt,yTxt) = :getLabels(eBak,eqVolFac,mode,scan-1,nrScans)

      prt->parent->draw("true")
      keaPlot:graphTime(prt,tAxis/1000,sumDataAPDiff*eqVolFac,scan-1,guipar,
                        titleTxt,"Time (ms)",yTxt)
      prt->axes->xmapping(wvT2Mapping)
      prt->parent->draw("true")
   else # Save the uncorrected data
      prt->title("T2 decay data")
      keaFiles:save1DData(guipar,tAxis/1000,sumDataAPDiff/scan)
   endif


 # Store the phase correction
   if(isvar("plotTab")) 
      t2PhaseValueCtrl->text(ph)
   endif

# Increment the experiment number
   keaFiles:incrementExperiment(guipar)

   return(0,0)

endproc("execpp")

#######################################################
# Get the plot labels based on display mode
#######################################################

procedure(getLabels,eBak,eqVolFac,mode,scan,nrScans)

   if(eBak != null) # We have a background to subtract
      if(eqVolFac != 1)  
         if(mode == "minSNR")
            titleTxt = "Calibrated & background corrected echo integrals (Acc: $scan+1$)"
            yTxt = "Equivalent volume (ml)"
         else
            titleTxt = "Calibrated & background corrected echo integrals (Acc: $scan+1$/$nrScans$)"
            yTxt = "Equivalent volume (ml)"
         endif
      else
         if(mode == "minSNR")
            titleTxt = "Background corrected echo integrals (Acc: $scan+1$)"
            yTxt = "Average echo amplitude (\G(m)V)"
         else
            titleTxt = "Background corrected echo integrals (Acc: $scan+1$/$nrScans$)"
            yTxt = "Average echo amplitude (\G(m)V)"
         endif
      endif

   else

      if(eqVolFac != 1)   # Calibration file present
         if(mode == "minSNR")
            titleTxt = "Calibrated echo integrals (Acc: $scan+1$)"
            yTxt = "Equivalent volume (ml)"
         else
            titleTxt = "Calibrated echo integrals (Acc: $scan+1$/$nrScans$)"
            yTxt = "Equivalent volume (ml)"
         endif
      else # No calibration file
         if(mode == "minSNR")
            titleTxt = "Echo integrals (Acc: $scan+1$)"
            yTxt = "Average echo amplitude (\G(m)V)"
         else
            titleTxt = "Echo integrals (Acc: $scan+1$/$nrScans$)"
            yTxt = "Average echo amplitude (\G(m)V)"
         endif
      endif

   endif

endproc(titleTxt,yTxt)


#######################################################
# Save the fitting information
#######################################################

procedure(saveFitList,guipar,fitlist)

# Extract GUI parameters
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)

   mkdir("Spectra")
   cd("Spectra")
   save("fitpars.lst",fitlist)

# Output information to the CLI
   pr "\n   Fit parameters saved to:"
   pr "\n     $dataDirectory$\\$expName$\\fitpars.lst\n"
# Restore cwd
   cd(bak)

endproc()

#######################################################
# Remove any T2 spectral information
#######################################################

procedure(deleteSpectrum,guipar)

# Extract GUI parameters
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)

   if(isdir("Spectra"))
      cd("Spectra")
      files = getfilelist(".")
      for(k = 0 to size(files)-1)
         rmfile(files[k])
      next(k)
      cd("..")
      rmdir("Spectra")
   endif

endproc()

##################################################################
# Get T2Analysis parameters (called from T2Analysis)
##################################################################

procedure(getT2AnalysisPar, winNr)

   keepfocus("true")
   winBak = guiwinnr()
   guiwinnr(winNr)
   guipar = getctrlvalues(0)
   assignlist(guipar)


   par = struct()
   par->src = "T2CPMG"
   if(expNr == "")
      par->dataDir = "$dataDirectory$\\$expName$"
   else
      par->dataDir = "$dataDirectory$\\$expName$\\$expNr$"
   endif
   par->sampleVolume = 0
   par->sampleName = ""
   par->project = getbasedir(getmacropath())
   par->porosityCtrl = null
   par->fitMethodCtrl = null
   par->win = null
   par->guiPar = null
   par->bkgPhaseMode = "autophase"
   par->autoPhaseMethod = "maxreal"
    
   guiwinnr(winBak)
   keepfocus("false")

endproc(par)


#####################################################
# Get a factor which determines how much longer to
# scan to get the desired SNR
#
# sig ......... current signal level
# sd .......... current noise level
# targetSNR ... target SNR
# nsBak ....... noise level of background signal
#####################################################

procedure(getTimeFactor,sig,sd,targetSNR,nsBak,scan)

  SNR = sig/sd
  fTarget = (targetSNR/SNR)^2 # Factor assuming no background 
  nsCur = sd
  nsSamp = sqrt(nsCur^2-nsBak^2)
  sqrNsTarg = (nsCur^2/fTarget - nsBak^2)

  if(sqrNsTarg <= 0) # We will never get to the target SNR
     return(-1)
  endif
  nsTarg = sqrt(sqrNsTarg)
  fRequired = (nsSamp/nsTarg)^2 # Factor with background included

# Work out the number of scans required (must be a multiple of 4)
   nrScans = fRequired*(scan+1)
   if(frac(nrScans/4) != 0)
      nrScans = (trunc(nrScans/4)+1)*4
      fRequired = nrScans/(scan+1)
   endif

endproc(fRequired)


