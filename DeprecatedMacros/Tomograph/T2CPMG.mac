#########################################################
# 
# T2CPMG
#
# CPMG pulse sequence in which each echo is summed to 
# return a single complex number per echo.
#
# 90 - delay - {180 - delay - acq}
#
# A parameter; "shift", is included to allow to allow
# data collection later in the echo, thereby reducing
# ringdown artefacts.
#
# Last modified : 13 March 2013
# Modified by : C Eccles, Magritek Ltd
# 
# Copyright (c) Magritek Ltd 2014
#
# U.I. V3
#########################################################

procedure(T2CPMG, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","Progress","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,26,27,36,37,60,61,68,69,89,90,99] # Control groups
   wv_shift = [-14,130,274,418,562,565] # Amount to shift control groups
   wv_other = [98,212,771]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"T2CPMG",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["ieTime = ieTime-40",
          "n3 = xcal*xshim/1000",
          "n4 = ycal*yshim/1000",
          "n5 = zcal*zshim/1000",
          "n6 = ocal*oshim/1000",
          "a1 = 90Amplitude",
          "a2 = 180Amplitude",
          "d1 = pulseLength",
          "d2 = echoTime/2-d1-pgo",
          "d3 = echoTime/2-acqTime*500-d1/2+rxLat+echoShift",
          "d4 = echoTime-d1-pgo-d3",
          "n1 = nrEchoes",
          "n2 = nrPnts",
          "totPnts = nrEchoes",
          "totTime = echoTime*nrEchoes"]
   var = [""]
   pp_list = ["n1","a1","p1","d1","d2","l1","a2","p2","d3","n2","d4"]
   pp_name = "T2CPMG.p"
   phase_list = [0,2,0,2;1,1,3,3;0,2,0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

