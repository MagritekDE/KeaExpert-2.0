# GRE_3D
# 
# Slice selective spin-echo imaging
#
# Copyright (c) Magritek Ltd 2014
#
# U.I. V3
#########################################################

procedure(GRE_3D, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,46,47,70,71,84,85,105,106,115] # Control groups
   wv_shift = [-14,200,414,628,631] # Amount to shift control groups
   wv_other = [114,282,907]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"GRE_3D",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d600 = 2",
          "n600 = round(pulseLength90/d600)",
          "(t1,t2,gfac) = B1NutSoft:getRFPulse(SPType,a1,n600)",
          "rampDur = 100",
          "d300 = 2.5",
          "n300 = round(rampDur/d300)",
          "d101 = 100",
          "(del9,del99) = GRE_3D:getRewindSliceDelay(pulseLength90,sliceComp,rampDur)",
          "d99=del99",
          "d9=del9",
          "d6   = estTimeR",
          "d3   = 100",
          "phDur = d3+2*rampDur+2*0.5*rampDur",
          "d4   = echoTime-1000*acqTime/2+rxLat+acqShift-d3-d6-d9-d99-10*rampDur",
          "n10  = GRE_3D:convertDirToChannel(dirRead)",
          "n20  = GRE_3D:convertDirToChannel(dirPhase1)",
          "n30  = GRE_3D:convertDirToChannel(dirSlice)",
          "n40  = GRE_3D:convertDirToChannel(dirPhase2)",
          "(gReadAmp,gReadAmpShim,gPhaseAmp1,gPhaseAmpShim1,gPhaseAmp2,gPhaseAmpShim2,gSliceAmp,gSliceAmpShim,sliceOffSet) = GRE_3D:setImageGradients(dirRead,dirPhase1,dirPhase2,dirSlice,FoVRead,FoVPhase1,FoVPhase2,phDur,sliceTickness,sliceShift,gfac,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n31 =  gSliceAmp+gSliceAmpShim",
          "n31a = gSliceAmpShim",
          "n32 = -gSliceAmp+gSliceAmpShim",
          "n11a =  gReadAmpShim",
          "readGradFac = (0.5*rampDur+d6+1000*acqTime/2-rxLat-acqShiftRead)/(d3+4*rampDur)",
          "n11  =  -readGradFac*gReadAmp+gReadAmpShim",
          "n12  =  gReadAmp+gReadAmpShim",
          "n12a =  gReadAmpShim",
          "n21  =  gPhaseAmp1+gPhaseAmpShim1",
          "n21a =  gPhaseAmpShim1",
          "n41  =  gPhaseAmp2+gPhaseAmpShim2",
          "n41a =  gPhaseAmpShim2",
          "f1  =  b1Freq+O1/1e6+sliceOffSet",
          "f2  =  b1Freq+O1/1e6",
          "n1  = nrPnts",
          "totPnts = nrPnts",
          "totTime = acqTime"]
   var = ["n21","n41"]
   pp_list = ["f1","n30","n31a","n31","n300","d300","d101","t1","t2","p1","n600","d600","d99","f2","n32","d9","n10","n11a","n11","n20","n21a","n21","n40","n41a","n41","d3","d4","n12a","n12","d6","n1"]
   pp_name = "GRE_3D.p"
   phase_list = [0,2;1,1;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

