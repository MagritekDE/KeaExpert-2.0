#########################################################
# 
# EPI_3D
# 
# Slice selective spin-echo imaging
#
# Copyright (c) Magritek Ltd 2014
#
# U.I. V3
#########################################################

procedure(EPI_3D, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,50,51,74,75,88,89,109,110,119] # Control groups
   wv_shift = [-14,226,466,706,709] # Amount to shift control groups
   wv_other = [118,308,1011]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"EPI_3D",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d600 = 2",
          "n600 = round(pulseLength90/d600)",
          "(t1,t2,gfac) = B1NutSoft:getRFPulse(SPType,a1,n600)",
          "(t3,t4,gfac) = B1NutSoft:getRFPulse(SPType,a2,n600)",
          "pulseLength180 = pulseLength90",
          "rampDur = 50",
          "d300 = 2.5",
          "d100 = 2",
          "d101 = 100",
          "d102 = 100",
          "n300 = round(rampDur/d300)",
          "d8 = estTimeR",
          "d7 = 2000",
          "phDur1 = rampDur*nrStepsP1/2",
          "phDur2 = d7+2*rampDur",
          "sliceComp = 0",
          "(del11,del19) = EPI_3D:getRewindSliceDelay(pulseLength90,sliceComp,rampDur)",
          "d19=del19",
          "d11=del11",
          "d3 = 1000*acqTime/2+rxLat+d8-rampDur/2-acqShiftRead",
          "d4 = echoTime/2-d3-2*rampDur-d7-2*rampDur-pulseLength90/2-3*rampDur-d11-d19-(pulseLength180+2*d102+2*rampDur)/2-pgo",
          "d9 = 2*d3 - d8 + rampDur",
          "d10 = d9+timeReadCPMG",
          "d5 = echoTime/2-(pulseLength180+2*d102+2*rampDur)/2-(2*d100+2*rampDur+rampDur+d8+d9+rampDur-4*2.5)*nrStepsP1/2",
          "n10  = EPI_3D:convertDirToChannel(dirRead)",
          "n20  = EPI_3D:convertDirToChannel(dirPhase1)",
          "n40  = EPI_3D:convertDirToChannel(dirPhase2)",
          "n30  = EPI_3D:convertDirToChannel(dirSlice)",
          "(gReadAmp,gReadAmpShim,gPhaseAmp1,gPhaseAmpShim1,gPhaseAmp2,gPhaseAmpShim2,gSliceAmp,gSliceAmpShim,sliceOffSet) = EPI_3D:setImageGradients(dirRead,dirPhase1,dirPhase2,dirSlice,FoVRead,FoVPhase1,FoVPhase2,phDur1,phDur2,sliceTickness,sliceShift,gfac,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n31 =  gSliceAmp+gSliceAmpShim",
          "n31a = gSliceAmpShim",
          "n32  = -gSliceAmp+gSliceAmpShim",
          "n1   = round(nrStepsP1/2)",
          "n11 = gReadAmp+gReadAmpShim",
          "n11a = gReadAmpShim",
          "n12  = -gReadAmp+gReadAmpShim",
          "n21a = gPhaseAmpShim1",
          "n21 =  gPhaseAmp1*(nrStepsP1/2)*(rampDur)/(2*rampDur+d7)+gPhaseAmpShim1",
          "n22 =  gPhaseAmp1+gPhaseAmpShim1",
          "n41a = gPhaseAmpShim2",
          "n41  = gPhaseAmpShim2",
          "f1  =  b1Freq+O1/1e6+sliceOffSet",
          "f2  =  b1Freq+O1/1e6",
          "n2 = nrPnts",
          "totPnts = nrPnts*nrStepsP1",
          "totTime = echoTime*nrStepsP1"]
   var = ["n41"]
   pp_list = ["f1","n30","n31a","n31","n300","d300","d101","t1","t2","p1","n600","d600","d19","f2","n32","d11","n10","n11a","n11","d3","n20","n21a","n21","n40","n41a","n41","d7","d4","d102","t3","t4","p2","d5","n1","l1","n22","d100","d8","n2","d9","n12","d10"]
   pp_name = "EPI_3D.p"
   phase_list = [0,2;1,1;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

