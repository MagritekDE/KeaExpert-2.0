#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)
   wvPP->multiplot(1,1)
   wvPP2->multiplot(2,2)

#Checks
   :checkDelays(guipar)
   acqTimeReal = keaNMR:getAcqTime(guipar)
   if (d9<acqTimeReal);  pr "d9 too short"; abort(""); endif;
   :checkGradPowerRARE3D(guipar)
   :checkGradDir(guipar)


   sumData = cmatrix(totPnts)

# Calculate suitable time and frequency axes
   totalTime = ([0:1:totPnts-1]/totPnts)*totTime*1000
   f = ([0:1:totPnts-1]-totPnts/2+1)/totTime


# Reset the timer
   time(0)
  
   kSpace3D = cmatrix(nrPnts,nrStepsP1,nrStepsP2)
   kSpace2D = cmatrix(nrPnts,nrStepsP1*nrStepsP2)
               
      
   for(nPh2= 0 to nrStepsP2-1)
      
     # pr nPh2
      grPh2a =   round(2*gPhaseAmp2/(nrStepsP2)*(-(nrStepsP2-1)/2+nPh2)) + gPhaseAmpShim2
      grPh2b =  -round(2*gPhaseAmp2/(nrStepsP2)*(-(nrStepsP2-1)/2+nPh2)) + gPhaseAmpShim2
      
      ppList = keaNMR:setPPNumber(ppList,varIndex[0],grPh2a)
      ppList = keaNMR:setPPNumber(ppList,varIndex[1],grPh2b)
            
      sumData = cmatrix(totPnts)
      
# Accumulate scan
      for(scan = 0 to nrScans-1)
     
       # Note the time at scan start
         t1 = time()   
   
       # Set phases for this scan
         (ppList,pAcq) = keaNMR:setPPPhase(ppList,scan,pcList,pcIndex)
   
       # Send phase parameters to DSP
         dspwrite("x",0x00,ppList)
   
       # Collect the data
         (status,data) = keaNMR:getData(totPnts,guipar)
         if(status != "ok")
            keaNMR:enableButtons()
            abort("")
         endif

       # Accumlate the data
         sumData = keaNMR:accumulate(accumulate,pAcq,sumData,data)

         if(accumulate=="yes")
            sf = 1/(scan+1)
         else
            sf = 1
         endif
   
         pd = wvPP->subplot(1,1)
         pd->draw("false")
         pd->plot(sf*real(sumData),"tracecolor",black)
         pd->hold("on")
         pd->plot(sf*imag(sumData),"tracecolor",red)
         pd->hold("off")
         pd->title("text","phase2 step ($nPh2+1$/$nrStepsP2$)")
         pd->xlabel("text","points")
         pd->ylabel("text","amplitude")
         pd->draw("true")
   
   
      # Check timing
         check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
         if(check == "abort")
            return(0)
         elseif(check == "finish")
            scan = scan+1
            nPh2 = 100000
            exitfor()
         endif

      next(scan)

      for(nPh1 = 0 to nrStepsP1-1)
         kSpace3D[~,nPh1,nPh2] = submatrix(sumData/nrScans,nPh1*nrPnts,(nPh1+1)*nrPnts-1)
         kSpace2D[~,nPh1+nPh2*nrStepsP1] = submatrix(sumData/nrScans,nPh1*nrPnts,(nPh1+1)*nrPnts-1)
      next(nPh1)
      image(kSpace2D)
   
   next(nPh2)

 
   npxRead  =2*:FFTsize(nrPnts)
  # npxPhase1 =2*:FFTsize(nrStepsP1)
   npxPhase1 = npxRead
   npxPhase2 =2*:FFTsize(nrStepsP2)
   
   assign("kSpace3D",kSpace3D,"global")

   idata = fft_local:3d(kSpace3D,npxRead,npxPhase1,npxPhase2,"sinebell","sinebell","sinebell","FTEcho","FTEcho","FTEcho","yes")
 
   assign("idata",idata,"global")

   idataRP1   = matrix(npxRead,npxPhase1)
   idataRP2   = matrix(npxRead,npxPhase2)
   idataP1P2  = matrix(npxPhase1,npxPhase2)

   idataRP1[~,~] = idata[~,~,round(npxPhase2/2)]  
   idataRP2[~,~] = idata[~,round(npxPhase1/2),~]   
   idataP1P2[~,~] = idata[round(npxRead/2),~,~]  

   curplot("2d",1,2)
   image(idataRP1)
   curplot("2d",2,2)
   image(idataRP2)
   curplot("2d",2,1)
   image(idataP1P2)

   if(saveData == "true")
      :saveData(guipar,kSpace3D,idata)
      keaFiles:incrementExperiment(guipar)
   endif


endproc("execpp")

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,kSpace3D,idata)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")

   export3dpar("ab","binary","xyrc","real","machine","littleend")
   export3d(idata,"rawimage3d.3d")  # Save data as an Excel file

   export3dpar("ab","binary","xyrc","complex","machine","littleend")
   export3d(kSpace3D,"rawkSpace3d.3d")  # Save data as an Excel file

   (n1,n2,n3,n4) = size(idata)

   save("$n1$x$n2$x$n3$.pixels_image","empty")

   (n1,n2,n3,n4) = size(kSpace3D)

   save("$n1$x$n2$X$n3$.kspace_size","empty")

   temp = getcwd()

   pr "data saved to $temp$"

# Restore cwd
   cd(bak)

endproc("saveData")


procedure(setImageGradients,dirRead,dirPhase1,dirPhase2,FoVRead,FoVPhase1,FoVPhase2,phDur,xshim,yshim,zshim,xcal,ycal,zcal)

   guipar = getctrlvalues(0)
   lst = keaNMR:loadPref()
   guipar = guipar + lst
   assignlist(guipar)

   FoVRead   = FoVRead/1000             # change from mm to m
   FoVPhase1 = FoVPhase1/1000           # change from mm to m
   FoVPhase2 = FoVPhase2/1000           # change from mm to m
#-------------------------------------------
   bandwidthRead =  bandwidth*1e3
   if(FoVRead==0)
      gReadAmpTperM=0
   else
      gReadAmpTperM =  bandwidthRead/42.57e6/FoVRead
   endif

   xshim = xshim/1000
   yshim = yshim/1000 
   zshim = zshim/1000

   if(dirRead == "x"); ampRead = gReadAmpTperM*xcal; ampReadShim = xshim*xcal;  endif
   if(dirRead == "y"); ampRead = gReadAmpTperM*ycal; ampReadShim = yshim*ycal; endif 
   if(dirRead == "z"); ampRead = gReadAmpTperM*zcal; ampReadShim = zshim*zcal; endif 

#-----------------------------------------
   bandwidthPhase1 =  1e6*0.5*nrStepsP1/(phDur)
   
   if(FoVPhase1==0)
      gPhaseAmpTperM1=0
   else
      gPhaseAmpTperM1 =  bandwidthPhase1/42.57e6/FoVPhase1
   endif
  
   if(dirPhase1 == "x"); ampPhase1 = gPhaseAmpTperM1*xcal; ampPhaseShim1 = xshim*xcal;  endif
   if(dirPhase1 == "y"); ampPhase1 = gPhaseAmpTperM1*ycal; ampPhaseShim1 = yshim*ycal;  endif 
   if(dirPhase1 == "z"); ampPhase1 = gPhaseAmpTperM1*zcal; ampPhaseShim1 = zshim*zcal;  endif

#-----------------------------------------
   bandwidthPhase2 =  1e6*0.5*nrStepsP2/(phDur)
   
   if(FoVPhase2==0)
      gPhaseAmpTperM2=0
   else
      gPhaseAmpTperM2 =  bandwidthPhase2/42.57e6/FoVPhase2
   endif
  
   if(dirPhase2 == "x"); ampPhase2 = gPhaseAmpTperM2*xcal; ampPhaseShim2 = xshim*xcal;  endif
   if(dirPhase2 == "y"); ampPhase2 = gPhaseAmpTperM2*ycal; ampPhaseShim2 = yshim*ycal; endif 
   if(dirPhase2 == "z"); ampPhase2 = gPhaseAmpTperM2*zcal; ampPhaseShim2 = zshim*zcal;  endif

# -----------------------------------------------
   if(abs(ampRead)>20800);   ampRead = 0; pr "Read gradient too high"; endif
   if(abs(ampPhase1)>20800); ampPhase1 = 0; pr "Phase1 gradient too high"; endif
   if(abs(ampPhase2)>20800); ampPhase2 = 0; pr "Phase2 gradient too high"; endif



endproc(round(ampRead),round(ampReadShim),round(ampPhase1),round(ampPhaseShim1),round(ampPhase2),round(ampPhaseShim2))

procedure(convertDirToChannel,dir)

   if(dir == "x")
        return 3
   endif
   if(dir == "y")
        return 2
   endif
   if(dir == "z")
        return 1
   endif

   if(dir == 3)
        return 3
   endif
   if(dir == 2)
        return 2
   endif
   if(dir == 1)
        return 1
   endif
  
endproc(0)
#-----------------------------
procedure(checkGradPowerRARE3D,guipar)

   assignlist(guipar)
   refPower=700
   
   #READ Channel
   p_R=gReadAmp*gReadAmp*(d8+d9+rampDur)*nrStepsP1*1e-6
   
   #PHASE1 Channel
   tP1=([0:1:nrStepsP1]-nrStepsP1/2+1/2)*gPhaseAmp1/((nrStepsP1-1)/2) + gPhaseAmpShim1  
   p_temp=tP1.*tP1 *2*(d6+2*rampDur)*1e-6
   p_P1=sum(p_temp)

   #PHASE2 Channel
   p_P2=gPhaseAmp2*gPhaseAmp2 *2*(d6+2*rampDur)*nrStepsP1*1e-6

   
   p_mean=(p_R+p_P1+p_P2)/repTime  


   if (p_mean>refPower)
      if(p_P2>p_P1+p_R)
         pr "Power requirement too high. Increase repetition time or reduce Nr. points along Phase 2 direction. \n"
         message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)+1$ ms \r or  reduce Nr. points along Phase 2 direction.","warning")
         abort("")         
      endif
      pr "Power requirement too high. Increase repetition time. \n"
      message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)+1$ ms","warning")
      abort("")
   endif

endproc()
#-----------------------------
procedure(checkDelays,guipar)
   assignlist(guipar)
   for (k=1 to 1000)
      try
         d_temp=eval("d$k$")
         if(d_temp<=0); pr "\n d$k$<0 \n"; abort(""); endif;  
      catch
      endtry         
   next
endproc()

#-----------------------------
procedure(checkGradDir,guipar)
assignlist(guipar)
if(dirPhase1==dirPhase2)
      message("Waring","Phase1 direction should be \r different from Phase2 direction.","warning")
      abort("")
endif
endproc()

#-----------------------------
procedure(FFTsize,nrPnts)

  m=1
  a = nrPnts
  while(a>1)
     a = nrPnts/2^m
     m = m+1
  endwhile
  r = 2^(m-1)

endproc(r)

