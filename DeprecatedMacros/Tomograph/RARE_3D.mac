#########################################################
# 
# RARE_3D
# 
# Slice selective spin-echo imaging
#
# Copyright (c) Magritek Ltd 2014
#
# U.I. V3
#########################################################

procedure(RARE_3D, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,42,43,66,67,80,81,101,102,111] # Control groups
   wv_shift = [-14,174,362,550,553] # Amount to shift control groups
   wv_other = [110,256,803]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"RARE_3D",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d1 = pulseLength90",
          "d2 = pulseLength180",
          "rampDur = 100",
          "d300 = 2.5",
          "n300 = round(rampDur/d300)",
          "d8 = estTimeR",
          "d3 = 1000*acqTime/2+rxLat+d8-rampDur/2-acqShiftRead",
          "d4 = echoTime/2-d3-2*rampDur-pulseLength90/2-pulseLength180/2-pgo",
          "d5 = 10",
          "d6 = phDur-rampDur",
          "d7 = echoTime/2-1000*acqTime/2+acqShift+rxLat-d5-d6-d8-pulseLength180/2-5*rampDur",
          "d9 = 2*d3 - d8 + rampDur + timeReadCPMG",
          "d10 = echoTime-pulseLength180-pgo-d5-2*d6-d7-d8-d9-10*rampDur",
          "n10  = RARE_3D:convertDirToChannel(dirRead)",
          "n20  = RARE_3D:convertDirToChannel(dirPhase1)",
          "n30  = RARE_3D:convertDirToChannel(dirPhase2)",
          "(gReadAmp,gReadAmpShim,gPhaseAmp1,gPhaseAmpShim1,gPhaseAmp2,gPhaseAmpShim2) = RARE_3D:setImageGradients(dirRead,dirPhase1,dirPhase2,FoVRead,FoVPhase1,FoVPhase2,phDur,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n1 = nrStepsP1",
          "n11 = gReadAmp+gReadAmpShim",
          "n11a = gReadAmpShim",
          "t21  =  ([0:1:nrStepsP1]-nrStepsP1/2+1/2)*gPhaseAmp1/((nrStepsP1-1)/2) + gPhaseAmpShim1 ",
          "t22  = -([0:1:nrStepsP1]-nrStepsP1/2+1/2)*gPhaseAmp1/((nrStepsP1-1)/2) + gPhaseAmpShim1 ",
          "n21a = gPhaseAmpShim1",
          "n31  =-gPhaseAmp2 + gPhaseAmpShim2",
          "n32  = gPhaseAmp2 + gPhaseAmpShim2",
          "n31a = gPhaseAmpShim2",
          "n2 = nrPnts-0",
          "n3 = 0",
          "totPnts = nrPnts*nrStepsP1",
          "totTime = echoTime*nrStepsP1"]
   var = ["n31","n32"]
   pp_list = ["a1","p1","d1","n10","n11a","n11","n300","d300","d3","d4","t21","t22","n1","l1","p2","d2","d5","n20","n21a","n30","n31a","n31","d6","d7","d8","n2","d9","n32","d10"]
   pp_name = "RARE_3D.p"
   phase_list = [0,2;1,1;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

