#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)
   wvPP->multiplot(1,1)
   wvPP2->multiplot(2,2)

#   acqTimeReal = keaNMR:getAcqTime(guipar)

#Checks
   :checkDelays(guipar)
   if (d9<dwellTime*(nrPnts-5)-rxLat+10);  pr "d9 too short"; abort(""); endif;
   :checkGradPowerRARE2D_MS(guipar)


   sumData = cmatrix(totPnts)

# Calculate suitable time and frequency axes
   totalTime = ([0:1:totPnts-1]/totPnts)*totTime*1000
   f = ([0:1:totPnts-1]-totPnts/2+1)/totTime


# Reset the timer
   time(0)

   kSpace2D1 = cmatrix(nrPnts,nrStepsP)
   kSpace2D2 = cmatrix(nrPnts,nrStepsP)
   kSpace2D3 = cmatrix(nrPnts,nrStepsP)        

               
# Accumulate scan
      for(scan = 0 to nrScans-1)
     
       # Note the time at scan start
         t1 = time()   
   
       # Set phases for this scan
         (ppList,pAcq) = keaNMR:setPPPhase(ppList,scan,pcList,pcIndex)
   
       # Send phase parameters to DSP
         dspwrite("x",0x00,ppList)
   
       # Collect the data
         (status,data) = keaNMR:getData(totPnts,guipar)

         if(status != "ok")
            keaNMR:enableButtons()
            abort("")
         endif
   
   
       # Accumlate the data
         sumData = keaNMR:accumulate(accumulate,pAcq,sumData,data)

         if(accumulate=="yes")
            sf = 1/(scan+1)
         else
            sf = 1
         endif

         pd = wvPP->subplot(1,1)
         pd->draw("false")
         pd->plot(sf*real(sumData),"tracecolor",black)
         pd->hold("on")
         pd->plot(sf*imag(sumData),"tracecolor",red)
         pd->hold("off")
         pd->title("text","raw data")
         pd->xlabel("text","points")
         pd->ylabel("text","amplitude")
         pd->draw("true")
   
 
      # Check timing
         check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
         if(check == "abort")
            return(0)
         elseif(check == "finish")
            scan = scan+1
            exitfor()
         endif

      next(scan)

      for(nPh = 0 to nrStepsP-1)
        kSpace2D1[~,nPh] = submatrix(sumData/nrScans,(0*nrStepsP+nPh)*nrPnts,(0*nrStepsP+nPh+1)*nrPnts-1)
      next(nPh)
      for(nPh = 0 to nrStepsP-1)
        kSpace2D2[~,nPh] = submatrix(sumData/nrScans,(1*nrStepsP+nPh)*nrPnts,(1*nrStepsP+nPh+1)*nrPnts-1)
      next(nPh)
      for(nPh = 0 to nrStepsP-1)
        kSpace2D3[~,nPh] = submatrix(sumData/nrScans,(2*nrStepsP+nPh)*nrPnts,(2*nrStepsP+nPh+1)*nrPnts-1)
      next(nPh)

  
      image(kSpace2D1)
  

     assign("kSpace2D1",kSpace2D1,"global")
     assign("kSpace2D2",kSpace2D2,"global")
     assign("kSpace2D3",kSpace2D3,"global")



   npxRead  =2*:FFTsize(nrPnts)
   npxPhase =2*:FFTsize(nrStepsP)
   
   idatas1 = fft_local:2d(kSpace2D1,npxRead,npxPhase,"sinebell","sinebell","FTEcho","FTEcho","yes")
   idatas2 = fft_local:2d(kSpace2D2,npxRead,npxPhase,"sinebell","sinebell","FTEcho","FTEcho","yes")
   idatas3 = fft_local:2d(kSpace2D3,npxRead,npxPhase,"sinebell","sinebell","FTEcho","FTEcho","yes")
 
   curplot("2d",2,2)
   image(idatas1) 

   curplot("2d",1,2)
   image(idatas2)

   curplot("2d",2,1)
   image(idatas3)

   if(saveData == "true")
      :saveData(guipar,kSpace2D1,idatas1,kSpace2D2,idatas2,kSpace2D3,idatas3)
      keaFiles:incrementExperiment(guipar)
   endif


endproc("execpp")

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,kSpace2D1,idata1,kSpace2D2,idata2,kSpace2D3,idata3)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")

   export2dpar("ab","binary","xyrc","real","machine","littleend")
   export2d(idata1,"rawimage2ds1.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","complex","machine","littleend")
   export2d(kSpace2D1,"rawkSpace2ds1.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","real","machine","littleend")
   export2d(idata2,"rawimage2ds2.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","complex","machine","littleend")
   export2d(kSpace2D2,"rawkSpace2ds2.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","real","machine","littleend")
   export2d(idata3,"rawimage2ds3.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","complex","machine","littleend")
   export2d(kSpace2D3,"rawkSpace2ds3.2d")  # Save data as an Excel file

   (n1,n2) = size(idata1)

   save("$n1$x$n2$.pixels_image","empty")

   (n1,n2) = size(kSpace2D1)

   save("$n1$x$n2$.kspace_size","empty")

   temp = getcwd()

   pr "data saved to $temp$"

# Restore cwd
   cd(bak)
endproc("saveData")


procedure(setImageGradients,dirRead,dirPhase,dirSlice,FoVRead,FoVPhase,phDur,sliceTickness,sliceShift1,sliceShift2,sliceShift3,gfac,xshim,yshim,zshim,xcal,ycal,zcal)

   guipar = getctrlvalues(0)
   lst = keaNMR:loadPref()
   guipar = guipar + lst
   assignlist(guipar)

   FoVRead = FoVRead/1000                     # change from mm to m
   FoVPhase = FoVPhase/1000                   # change from mm to m
   sliceTickness = sliceTickness/1000         # change from mm to m
   sliceShift1 = sliceShift1/1000               # change from mm to m
   sliceShift2 = sliceShift2/1000               # change from mm to m
   sliceShift3 = sliceShift3/1000               # change from mm to m


   bandwidthRead =  bandwidth*1e3
   if(FoVRead==0)
      gReadAmpTperM=0
   else
      gReadAmpTperM =  bandwidthRead/42.57e6/FoVRead
   endif

   xshim = xshim/1000
   yshim = yshim/1000 
   zshim = zshim/1000  

   if(dirRead == "x"); ampRead = gReadAmpTperM*xcal; ampReadShim = xshim*xcal;  endif
   if(dirRead == "y"); ampRead = gReadAmpTperM*ycal; ampReadShim = yshim*ycal; endif 
   if(dirRead == "z"); ampRead = gReadAmpTperM*zcal; ampReadShim = zshim*zcal; endif 

   bandwidthPhase =  1e6*0.5*nrStepsP/(phDur)
   
   if(FoVPhase==0)
      gPhaseAmpTperM=0
   else
      gPhaseAmpTperM =  bandwidthPhase/42.57e6/FoVPhase
   endif
  
   if(dirPhase == "x"); ampPhase = gPhaseAmpTperM*xcal; ampPhaseShim = xshim*xcal;  endif
   if(dirPhase == "y"); ampPhase = gPhaseAmpTperM*ycal; ampPhaseShim = yshim*ycal;  endif 
   if(dirPhase == "z"); ampPhase = gPhaseAmpTperM*zcal; ampPhaseShim = zshim*zcal;  endif

   bandwidthSlice =  gfac*1e6/(pulseLength90)

   if(sliceTickness == 0)
      gSliceTperM =0
   else
      gSliceTperM    =  bandwidthSlice/42.57e6/sliceTickness
   endif

   if(dirSlice == "x"); ampSlice = gSliceTperM*xcal; ampSliceShim = xshim*xcal; endif
   if(dirSlice == "y"); ampSlice = gSliceTperM*ycal; ampSliceShim = yshim*ycal; endif 
   if(dirSlice == "z"); ampSlice = gSliceTperM*zcal; ampSliceShim = zshim*zcal; endif

   sliceOffSet1 = gSliceTperM*42.57*sliceShift1 # in MHz
   sliceOffSet2 = gSliceTperM*42.57*sliceShift2 # in MHz
   sliceOffSet3 = gSliceTperM*42.57*sliceShift3 # in MHz
  
   if(abs(ampRead)>20800);   ampRead = 0; pr "Read gradient too high"; endif
   if(abs(ampPhase)>20800); ampPhase = 0; pr "Phase gradient too high"; endif
   if(abs(ampSlice)>20800); ampSlice = 0; pr "Slice gradient too high"; endif

 

endproc(round(ampRead),round(ampReadShim),round(ampPhase),round(ampPhaseShim),round(ampSlice),round(ampSliceShim),sliceOffSet1,sliceOffSet2,sliceOffSet3)

procedure(convertDirToChannel,dir)

   if(dir == "x")
        return 3
   endif
   if(dir == "y")
        return 2
   endif
   if(dir == "z")
        return 1
   endif

   if(dir == 3)
        return 3
   endif
   if(dir == 2)
        return 2
   endif
   if(dir == 1)
        return 1
   endif
  
endproc(0)
#-----------------------------
procedure(checkGradPowerRARE2D_MS,guipar)

   assignlist(guipar)
   refPower=700

   #READ Channel
   p_R=3*gReadAmp*gReadAmp*((d3+rampDur)+(d8+d9+rampDur)*nrStepsP)*1e-6
   
   #PHASE Channel
   t22=([0:1:nrStepsP]-nrStepsP/2+1/2)*gPhaseAmp/((nrStepsP-1)/2) + gPhaseAmpShim   
   p_temp=t22.*t22 *2*(d6+rampDur)*1e-6
   p_P=3*sum(p_temp)

   #SLICE Channel
   p_S=3*gSliceAmp*gSliceAmp*((pulseLength90+d101+rampDur)+(d11+rampDur)+(pulseLength180+2*d102+rampDur)*nrStepsP)*1e-6
   
   p_mean=(p_R+p_P+p_S)/repTime  
   
   if (p_mean>refPower)
      if(p_S>p_R+p_P)
         pr "Power requirement too high. Increase repetition time or slice thickness. \n"
         message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)+1$ ms \r or slice thickness.","warning")
         abort("")          
      endif
      pr "Power requirement too high. Increase repetition time. \n"
      message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)+1$ ms","warning")
      abort("")
   endif

endproc()

#-----------------------------
procedure(checkDelays,guipar)
   assignlist(guipar)
   for (k=1 to 1000)
      try
         d_temp=eval("d$k$")
         if(d_temp<=0); pr "\n d$k$<0 \n"; abort(""); endif;  
      catch
      endtry         
   next
endproc()

#-----------------------------
procedure(FFTsize,nrPnts)

  m=1
  a = nrPnts
  while(a>1)
     a = nrPnts/2^m
     m = m+1
  endwhile
  r = 2^(m-1)

endproc(r)
