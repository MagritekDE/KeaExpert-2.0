# 
# RARE_2D_Multislice
# 
# Slice selective spin-echo imaging
#
# Copyright (c) Magritek Ltd 2014
#
# U.I. V3
#########################################################

procedure(RARE_2D_Multislice, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,50,51,74,75,88,89,109,110,119] # Control groups
   wv_shift = [-14,226,466,706,709] # Amount to shift control groups
   wv_other = [118,308,1011]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"RARE_2D_Multislice",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d600 = 2",
          "n600 = round(pulseLength90/d600)",
          "(t1,t2,gfac) = B1NutSoft:getRFPulse(SPType,a1,n600)",
          "(t3,t4,gfac) = B1NutSoft:getRFPulse(SPType,a2,n600)",
          "pulseLength180 = pulseLength90",
          "rampDur = 200",
          "d300 = 2.5",
          "n300 = round(rampDur/d300)",
          "d8 = estTimeR",
          "d101 = 100",
          "d102= 100",
          "d3 = 1000*acqTime/2+rxLat+d8-rampDur/2-acqShiftRead",
          "d11 = pulseLength90/2-0.5*rampDur+sliceComp",
          "phDss90 = 28",
          "phDss180 = 90.2",
          "d44 = 2*rampDur+d101+pulseLength90 +pgo+phDss90",
          "d54 = 2*rampDur+d102+pulseLength180+pgo+phDss180",
          "d4 = -d44+echoTime/2-d3-5*rampDur-d11-pulseLength90/2-(rampDur+d102+pulseLength180)/2-pgo",
          "d5 = 10",
          "d6 = phDur-rampDur",
          "d7 = -d54+echoTime/2-1000*acqTime/2+acqShift+rxLat-d5-d6-d8-(rampDur+d102+pulseLength180)/2-3*rampDur",
          "d9 = 2*d3 - d8 + rampDur + timeReadCPMG",
          "d10 = -d54+echoTime-(rampDur+d102+pulseLength180)-pgo-d5-2*d6-d7-d8-d9-6*rampDur",
          "n10  = RARE_2D_Multislice:convertDirToChannel(dirRead)",
          "n20  = RARE_2D_Multislice:convertDirToChannel(dirPhase)",
          "n30  = RARE_2D_Multislice:convertDirToChannel(dirSlice)",
          "(gReadAmp,gReadAmpShim,gPhaseAmp,gPhaseAmpShim,gSliceAmp,gSliceAmpShim,sliceOffSet1,sliceOffSet2,sliceOffSet3) = RARE_2D_Multislice:setImageGradients(dirRead,dirPhase,dirSlice,FoVRead,FoVPhase,phDur,sliceTickness,sliceShift1,sliceShift2,sliceShift3,gfac,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n31a = gSliceAmpShim",
          "n31 =  gSliceAmp+gSliceAmpShim",
          "n32 = -gSliceAmp+gSliceAmpShim",
          "n11 =  gReadAmp+gReadAmpShim",
          "n11a = gReadAmpShim",
          "t21  =  ([0:1:nrStepsP]-nrStepsP/2+1/2)*gPhaseAmp/((nrStepsP-1)/2) + gPhaseAmpShim ",
          "t22  = -([0:1:nrStepsP]-nrStepsP/2+1/2)*gPhaseAmp/((nrStepsP-1)/2) + gPhaseAmpShim ",
          "n21a = gPhaseAmpShim",
          "n22a = gPhaseAmpShim",
          "n1 = nrStepsP",
          "n2 = nrPnts",
          "f11  =  b1Freq+O1/1e6+sliceOffSet1",
          "f12  =  b1Freq+O1/1e6",
          "f13  =  b1Freq+O1/1e6-sliceOffSet1",
          "f21  =  b1Freq+O1/1e6+sliceOffSet2",
          "f22  =  b1Freq+O1/1e6",
          "f23  =  b1Freq+O1/1e6-sliceOffSet2",
          "f31  =  b1Freq+O1/1e6+sliceOffSet3",
          "f32  =  b1Freq+O1/1e6",
          "f33  =  b1Freq+O1/1e6-sliceOffSet3",
          "totPnts = nrPnts*nrStepsP*3",
          "totTime = echoTime*nrStepsP*3"]
   var = [""]
   pp_list = ["f11","n30","n31a","n31","n300","d300","d101","t1","t2","p1","n600","d600","f13","d44","f12","n32","d11","n10","n11a","n11","d3","d4","t21","t22","n1","l1","d102","t3","t4","p2","d54","d5","n20","n21a","d6","d7","d8","n2","d9","n22a","d10","f21","f23","f22","l2","f31","f33","f32","l3"]
   pp_name = "RARE_2D_Multislice.p"
   phase_list = [0,2;1,1;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

