#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)
   wvPP->multiplot(1,1)
   wvPP2->multiplot(2,2)

#Checks
   :checkDelays(guipar)
   durSPRITE=repTimeSPRITE*nrStepsP1*nrStepsP2
   if(durSPRITE>repTime); 
      pr "\n The time required by the sequence is larger than the repetition time. \n"; 
      message("Warning","The time required by the sequence \r is larger than the repetition time. \r Increase tR > $durSPRITE + 1$","warning")
      abort(""); 
   endif;
   :checkGradPowerSPRITE_2D(guipar)
   :checkGradDir(guipar)

   sumData = cmatrix(totPnts)

# Calculate suitable time and frequency axes
   totalTime = ([0:1:totPnts-1]/totPnts)*totTime*1000
   f = ([0:1:totPnts-1]-totPnts/2+1)/totTime
# Reset the timer
   time(0)

   kSpace2D = cmatrix(nrStepsP1,nrStepsP2)        
   sumData = cmatrix(totPnts)    
                     
      # Accumulate scan
            for(scan = 0 to nrScans-1)
           
             # Note the time at scan start
               t1 = time()   
         
             # Set phases for this scan
               (ppList,pAcq) = keaNMR:setPPPhase(ppList,scan,pcList,pcIndex)
         
             # Send phase parameters to DSP
               dspwrite("x",0x00,ppList)
         
             # Collect the data
               (status,data) = keaNMR:getData(totPnts,guipar)
               if(status != "ok")
                  keaNMR:enableButtons()
                  abort("")
               endif
         
             # Accumlate the data
               sumData = keaNMR:accumulate(accumulate,pAcq,sumData,data)

               if(accumulate=="yes")
                  sf = 1/(scan+1)
               else
                  sf = 1
               endif
         
               pd = wvPP->subplot(1,1)
               pd->draw("false")
               pd->plot(totalTime,sf*real(sumData),"tracecolor",black)
               pd->hold("on")
               pd->plot(totalTime,sf*imag(sumData),"tracecolor",red)
               pd->hold("off")
               pd->title("text","raw data")
               pd->xlabel("text","points")
               pd->ylabel("text","amplitude")
               pd->draw("true")
       
            # Check timing
               check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
               if(check == "abort")
                  return(0)
               elseif(check == "finish")
                  scan = scan+1                 
               exitfor()
               endif
      
            next(scan)
      
         for(yy=0 to nrStepsP2-1)
             for(xx=0 to nrStepsP1-1)
                 kSpace2D[xx,yy] = sumData[xx+yy*nrStepsP1]/sf
             next(xx)
         next(yy)

   image(kSpace2D)

   npxPhase1 =2*:FFTsize(nrStepsP1)
   npxPhase2 =2*:FFTsize(nrStepsP2)

   assign("kSpace2D",kSpace2D,"global")

   idata = fft_local:2d(kSpace2D,npxPhase1,npxPhase2,"sinebell","sinebell","FTEcho","FTEcho","yes")
   image(idata)

   if(saveData == "true")
      :saveData(guipar,kSpace2D,idata)
      keaFiles:incrementExperiment(guipar)
   endif

endproc("execpp")

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,kSpace2D,idata)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")

   export2dpar("ab","binary","xyrc","real","machine","littleend")
   export2d(idata,"rawimage2d.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","complex","machine","littleend")
   export2d(kSpace2D,"rawkSpace2d.2d")  # Save data as an Excel file

   (n1,n2) = size(idata)

   save("$n1$x$n2$.pixels_image","empty")

   (n1,n2) = size(kSpace2D)

   save("$n1$x$n2$.kspace_size","empty")

   temp = getcwd()

   pr "data saved to $temp$"

# Restore cwd
   cd(bak)


endproc("saveData")
#-----------------------------
procedure(setImageGradients,dirPhase1,dirPhase2,FoVPhase1,FoVPhase2,phDur,xshim,yshim,zshim,xcal,ycal,zcal)

   guipar = getctrlvalues(0)
   lst = keaNMR:loadPref()
   guipar = guipar + lst
   assignlist(guipar)

   FoVPhase1 = FoVPhase1/1000           # change from mm to m
   FoVPhase2 = FoVPhase2/1000           # change from mm to m

   xshim = xshim/1000
   yshim = yshim/1000 
   zshim = zshim/1000  


# phase1
   bandwidthPhase1 =  1e6*0.5*nrStepsP1/(phDur)
   
   if(FoVPhase1==0)
      gPhaseAmpTperM1=0
   else
      gPhaseAmpTperM1 =  bandwidthPhase1/42.57e6/FoVPhase1
   endif
  
   if(dirPhase1 == "x"); ampPhase1 = gPhaseAmpTperM1*xcal; ampPhaseShim1 = xshim*xcal;  endif
   if(dirPhase1 == "y"); ampPhase1 = gPhaseAmpTperM1*ycal; ampPhaseShim1 = yshim*ycal; endif 
   if(dirPhase1 == "z"); ampPhase1 = gPhaseAmpTperM1*zcal; ampPhaseShim1 = zshim*zcal;  endif

# phase2
   bandwidthPhase2 =  1e6*0.5*nrStepsP2/(phDur)
   
   if(FoVPhase2==0)
      gPhaseAmpTperM2=0
   else
      gPhaseAmpTperM2 =  bandwidthPhase2/42.57e6/FoVPhase2
   endif
  
   if(dirPhase2 == "x"); ampPhase2 = gPhaseAmpTperM2*xcal; ampPhaseShim2 = xshim*xcal;  endif
   if(dirPhase2 == "y"); ampPhase2 = gPhaseAmpTperM2*ycal; ampPhaseShim2 = yshim*ycal;  endif 
   if(dirPhase2 == "z"); ampPhase2 = gPhaseAmpTperM2*zcal; ampPhaseShim2 = zshim*zcal;  endif

   if(abs(ampPhase1)>20800); ampPhase1 = 0; pr "Phase 1 gradient too high"; endif
   if(abs(ampPhase2)>20800); ampPhase2 = 0; pr "Phase 2 gradient too high"; endif

endproc(round(ampPhase1),round(ampPhaseShim1),round(ampPhase2),round(ampPhaseShim2))
#-----------------------------
procedure(convertDirToChannel,dir)

   if(dir == "x")
        return 3
   endif
   if(dir == "y")
        return 2
   endif
   if(dir == "z")
        return 1
   endif

   if(dir == 3)
        return 3
   endif
   if(dir == 2)
        return 2
   endif
   if(dir == 1)
        return 1
   endif
  
endproc(0)
#-----------------------------
procedure(getPhaseTable,gPhaseAmp,gPhaseAmpShim,nrStepsP)

   ta  =  ([0:1:nrStepsP]-nrStepsP/2+1/2)*gPhaseAmp/((nrStepsP-1)/2) + gPhaseAmpShim 
  # pr ta       
endproc(ta)

#-----------------------------
procedure(checkGradPowerSPRITE_2D,guipar)

   assignlist(guipar)
   refPower=700
   
   #PHASE1 Channel
   t11=:getPhaseTable(gPhaseAmp1,gPhaseAmpShim1,nrStepsP1)
   p_temp=t11.*t11 *(d1+d2+2*d100+2*rampDur)*1e-6
   p_P1=sum(p_temp)

   #PHASE2 Channel
   t21=:getPhaseTable(gPhaseAmp2,gPhaseAmpShim2,nrStepsP2)
   p_temp=t21.*t21*(d1+d2+2*d100+2*rampDur)*1e-6
   p_P2=sum(p_temp)
  
   p_mean=(p_P1+p_P2)/repTime  
   
   if (p_mean>refPower)
      pr "Power requirement too high. Increase repetition time. \n"
      message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)+1$ ms","warning")
      abort("")
   endif

endproc()
#-----------------------------
procedure(checkDelays,guipar)
   assignlist(guipar)
   for (k=1 to 1000)
      try
         d_temp=eval("d$k$")
         if(d_temp<=0); pr "\n d$k$<0 \n"; abort(""); endif;  
      catch
      endtry         
   next
endproc()
#-----------------------------
procedure(checkGradDir,guipar)
assignlist(guipar)
if(dirPhase1==dirPhase2)
      message("Waring","Phase dir. 1 should be \r different from Phase dir. 2.","warning")
      abort("")
endif
endproc()

#-----------------------------
procedure(FFTsize,nrPnts)

  m=1
  a = nrPnts
  while(a>1)
     a = nrPnts/2^m
     m = m+1
  endwhile
  r = 2^(m-1)

endproc(r)