procedure(SPRITE_2D, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,32,33,56,57,70,71,91,92,101] # Control groups
   wv_shift = [-14,122,258,394,397] # Amount to shift control groups
   wv_other = [100,204,595]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"SPRITE_2D",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d1 = PulseLength90",
          "rampDur = 100",
          "d300 = 2.5",
          "n300 = round(rampDur/d300)",
          "d100 = 50",
          "d2   = phDur-d1/2",
          "d3   = repTimeSPRITE*1000-4*rampDur-phDur-2*d100",
          "n10  = SPI_2D:convertDirToChannel(dirPhase1)",
          "n20  = SPI_2D:convertDirToChannel(dirPhase2)",
          "(gPhaseAmp1,gPhaseAmpShim1,gPhaseAmp2,gPhaseAmpShim2) = SPRITE_2D:setImageGradients(dirPhase1,dirPhase2,FoVPhase1,FoVPhase2,phDur,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n11  =  gPhaseAmp1+gPhaseAmpShim1",
          "n11a =  gPhaseAmpShim1",
          "n21  =  gPhaseAmp2+gPhaseAmpShim2",
          "n21a =  gPhaseAmpShim2",
          "t11  =  SPRITE_2D:getPhaseTable(gPhaseAmp1,gPhaseAmpShim1,nrStepsP1)",
          "t21  =  SPRITE_2D:getPhaseTable(gPhaseAmp2,gPhaseAmpShim2,nrStepsP2)",
          "n0  = nrDummyScans",
          "n1  = nrStepsP1",
          "n2  = nrStepsP2",
          "n3  = nrPnts",
          "totPnts = nrStepsP1*nrStepsP2",
          "totTime = nrStepsP1*nrStepsP2*repTimeSPRITE"]
   var = [""]
   pp_list = ["n0","l0","n10","n11a","n300","d300","n20","n21a","d100","a1","p1","d1","d2","d3","t21","n2","l2","t11","n1","l1","n3"]
   pp_name = "SPRITE_2D.p"
   phase_list = [0,2;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

