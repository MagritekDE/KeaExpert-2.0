procedure(loadValues)

   lst = keaNMR:loadPref()
   assignlist(lst)

   par = ["xshim = $xshim$",
          "yshim = $yshim$",
          "zshim = $zshim$",
          "oshim = $oshim$"]
   

endproc(par)
#----------------------------------------
procedure(saveValues,newshims)

   lst = keaNMR:loadPref()
   assignlist(newshims)

   lst = setlistvalue(lst,"xshim","$xshim$")
   lst = setlistvalue(lst,"yshim","$yshim$") 
   lst = setlistvalue(lst,"zshim","$zshim$") 
   lst = setlistvalue(lst,"oshim","$oshim$") 

   keaNMR:savePref(lst)

endproc()
