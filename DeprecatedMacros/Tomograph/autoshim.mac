#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)

   wvPP->multiplot(4,1)
   winNr1d = wvPP->parent()->winnr()
   winNr2d = wvPP2->parent()->winnr()

   time(0)  

   shimMode = 10

   bufferLW50 = matrix(nrScans)
   bufferLW10 = matrix(nrScans)

   shimLst =:loadValues()
   assignlist(shimLst)

   xshim0    = xshim
   yshim0    = yshim
   zshim0    = zshim
   oshim0    = oshim

   dummyScans = 4
   nrPntsShim = 3
   nrChannels = 4 

   shimAxis= matrix(nrPntsShim)

   count = 0
   for(m=0 to nrLoops-1)

      if(m>0) ;dummyScans = 0; endif

      k = -1
      while(k<nrChannels+1)
   
         LWAxis  = matrix(nrPntsShim)
   
         if(k==-1)
            scanIni = -dummyScans
            scanFin = -1
         endif
         if(k==0)  
            channel  = "x"
            if eval("$channel$Enable") == "no"; k=k+1;endif
            scanIni = 0
            scanFin = nrPntsShim-1
         endif
         if(k==1)
            channel  = "y"
            if eval("$channel$Enable") == "no"; k=k+1;endif
         endif
         if(k==2)
            channel  = "z"
            if eval("$channel$Enable") == "no"; k=k+1;endif
         endif
         if(k==3)
            channel  = "o"
            if eval("$channel$Enable") == "no"; k=k+1;endif
         endif
           if(k==4)
            scanIni = -100
            scanFin = -99
         endif
            
            bestLW = 0
            dir = 1
            scans = scanIni
   
            if (k>-1)
               nextShimVal = eval("$channel$shim0")
               shimStep    = eval("$channel$step")
               shim0       = eval("$channel$shim0")
            endif
   
            while(scans<scanFin+1)

             # Note the time at scan start
               t1 = time()
   
               if(scans>-1)
                  shimLst = setlistvalue(shimLst,"$channel$shim","$nextShimVal$")
               endif
             
               (LW50,LW10) = :runExp(shimLst,guipar,ppList,pcList,pcIndex,varIndex)
   
               if((scans==-dummyScans)&(m==0)); bufferLW50 = bufferLW50+LW50; endif
               if((scans==-dummyScans)&(m==0)); bufferLW10 = bufferLW10+LW10; endif

               bufferLW50[0] =  LW50; bufferLW50  = rotate(bufferLW50,-1);# bufferLW50[0] = 0
               bufferLW10[0] =  LW10; bufferLW10  = rotate(bufferLW10,-1);# bufferLW10[0] = 0
         
            # plots line width at 50%
               pd = curplot("1d",2,1)
               if(shimMode==50)
                  lb = pd->title()
                  lb->color(blue)
                  lb->size(16)
               endif      
               pd->draw("false")
               pd->plot(bufferLW50,"tracewidth",1.5)
               if((scans>-1)&(shimMode==50))
                     pd->title("LW_(50) = $0.01*round(100*bufferLW50[size(bufferLW50)-1])$ Hz, $channel$shim:$nextShimVal$")
               else
                     pd->title("LW_(50) = $0.01*round(100*bufferLW50[size(bufferLW50)-1])$ Hz")
               endif
               pd->xlabel("text","n")
               pd->ylabel("text","LW(Hz)")
               pd->draw("true")

            # plots line width at 10%
               pd = curplot("1d",3,1)
               if(shimMode==10)
                  lb = pd->title()
                  lb->color(blue)
                  lb->size(16)
               endif         
               pd->draw("false")
               pd->plot(bufferLW10,"tracewidth",1.5)
               if((scans>-1)&(shimMode==10))
                  pd->title("text","LW_(10) = $0.1*round(10*bufferLW10[size(bufferLW10)-1])$ Hz, $channel$shim:$0.001*round(1000*nextShimVal)$")
               else
                  pd->title("text","LW_(10) = $0.1*round(10*bufferLW10[size(bufferLW10)-1])$ Hz")
               endif
               pd->xlabel("text","n")
               pd->ylabel("text","LW(Hz)")
               pd->draw("true")
   
               if(shimMode==50)
                  LW = LW50
               endif
               if(shimMode==10)
                  LW = LW10
               endif
            #------------------------------------------
               if(scans==0)
                  bestLW      = LW
                  LWAxis[1]   = LW
                  shimAxis[1] = nextShimVal
                  nextShimVal = nextShimVal + dir*shimStep
               endif
            #------------------------------------------
               if(scans==1)
                  LWAxis[2]   = LW
                  shimAxis[2] = nextShimVal
                  if(LW<bestLW)
                     bestLW      = LW
                     shimAxis = rotate(shimAxis,-1)
                     LWAxis = rotate(LWAxis,-1)
                     nextShimVal = nextShimVal + dir*shimStep
                  else
                     dir = -dir
                     nextShimVal = nextShimVal + 2*dir*shimStep
                  endif
               endif
            #------------------------------------------
               if(scans==2)  
                  LWAxis[1+dir]   = LW
                  shimAxis[1+dir] = nextShimVal             
                  if(LW>bestLW)

                  else
                     bestLW = LW 
                     shimAxis = rotate(shimAxis,-dir)
                     LWAxis   = rotate(LWAxis,-dir)
                     nextShimVal = nextShimVal + dir*shimStep 
                     scans = scans-1
                  endif
               endif
               scans = scans+1
               count = count+1

   
               szBufLW = size(bufferLW50)
   
               if(count> szBufLW-2)
                 bufferLWcopy = bufferLW50
                 bufferLW50 = matrix(szBufLW+nrScans)
                 bufferLW50 = bufferLW50 + bufferLWcopy[0]
                 for l=0 to szBufLW-1 
                   bufferLW50[l+nrScans] = bufferLWcopy[l]
                 next l
               endif

               szBufLW = size(bufferLW10)
   
               if(count> szBufLW-2)
                 bufferLWcopy = bufferLW10
                 bufferLW10 = matrix(szBufLW+nrScans)
                 bufferLW10 = bufferLW10 + bufferLWcopy[0]
                 for l=0 to szBufLW-1 
                   bufferLW10[l+nrScans] = bufferLWcopy[l]
                 next l
               endif
 
               check = keaRun:checkTimeAndAbort(guipar,t1,scans,pcList)
               if(check == "abort")
                  return(0)
               elseif(check == "finish")
                  scans = scans+1
                  k = nrChannels +100
                  exitwhile()
               endif
   
            endwhile()
   
            if((-1<k)&(k<nrChannels))
               newshim = :fitShim(shimAxis,LWAxis,shim0,channel,shimMode)
               shimLst = setlistvalue(shimLst,"$channel$shim","$newshim$")       
            endif
   
            k = k+1

         endwhile()

         :saveValues(shimLst)

   #  best shim values
   
         xshim0    = eval(getlistvalue(shimLst,"xshim"))
         yshim0    = eval(getlistvalue(shimLst,"yshim"))
         zshim0    = eval(getlistvalue(shimLst,"zshim"))
         oshim0    = eval(getlistvalue(shimLst,"oshim"))


         pr "\n"
         pr "loop = $m$, L50 = $0.01*round(100*LW50)$ Hz, L10 = $0.1*round(10*LW10)$ Hz\n"

         if(saveData == "true")
            :saveData(guipar,shimLst)
         endif

      next(m)

endproc("execpp")
#--------------------------------------------------------------------
procedure(saveData,guipar,shimLst)

   assignlist(guipar)
   name = getmacroname()
   name = rmext(name)

   str = getmacropath()
   sz = size(str)
   nada = "c\\a"
   for k = sz-1 to 0 step -1
      if str[k] == nada[1]
       kini = k 
       exitfor
      endif
   next k
   folder = submatrix(str,kini+1,sz-1)

   fullpath = "$prefdir$\\keaParameters\\Experiments\\$folder$\\$name$"
   cd(fullpath)

   lastPar = load("$name$LastExp.par")
   expNr = eval(getlistvalue(lastPar,"expNr"))
   lastPar =  setlistvalue(lastPar,"expNr","$expNr+1$")
   save("$name$LastExp.par",lastPar)

   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")
   save("shims.par",shimLst)
   save("guipar.par",guipar)

   cd(bak)

# Increment the experiment number
   keaNMR:incrementExperiment(incExpNr)

endproc("saveData")

#-----------------------------
procedure(measureLineWidth,level,x,y,kmax)

   level = level/100
   amp = y[kmax]
   kL = findindex2(y,kmax,"left",amp*level)

   if(y[kL]>amp*level)
      xL = :findRoot(x[kL],y[kL],x[kL-1],y[kL-1],amp*level)
   else
      xL = :findRoot(x[kL],y[kL],x[kL+1],y[kL+1],amp*level)
   endif

   kR = findindex2(y,kmax,"right",amp*level)

   if(y[kR]>amp*level)
      xR = :findRoot(x[kR],y[kR],x[kR+1],y[kR+1],amp*level)
   else
      xR = :findRoot(x[kR],y[kR],x[kR-1],y[kR-1],amp*level)
   endif

   linewidth = (xR-xL)

endproc(linewidth)
#----------------------------------------------------------
procedure(findRoot,x1,y1,x2,y2,y0)
     x0 = x1 + (y0-y1)*(x2-x1)/(y2-y1)
endproc(x0)
#-------------------------------------------------------------------------------
procedure(runExp,shimsLst,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)
   assignlist(shimsLst)

   sumData = cmatrix(totPnts)
   
   zf = 16*:FFTsize(nrPnts)
   f = ([0:1:zf-1]-zf/2)*bandwidth/zf
  (fIni,fFin) = findindex(f,-dispRange/2,dispRange/2)

   ppList = keaRun:setPPNumber(ppList,varIndex[0],xshim*xcal/1000)
   ppList = keaRun:setPPNumber(ppList,varIndex[1],yshim*ycal/1000)
   ppList = keaRun:setPPNumber(ppList,varIndex[2],zshim*zcal/1000)
   ppList = keaRun:setPPNumber(ppList,varIndex[3],oshim*ocal/1000)
#pr xshim*ocal/1000
#pr yshim*ocal/1000
#pr zshim*ocal/1000

# Accumulate scans
   nrScans = 1
   for(scans = 0 to nrScans-1)

    # Note the time at scan start
      t1 = time()

    # Set phases for this scan
      (ppList,pAcq) = keaRun:setPPPhase(ppList,scans,pcList,pcIndex)

    # Send phase parameters to DSP
      dspwrite("x",0x00,ppList)
       
    # Collect the data
      (status,data) = keaRun:getData(totPnts,guipar)

      if(status != "ok")
         keaRun:enableButtons()
         abort("")
      endif
      data = rotate(data,1)
      data[nrPnts-1]=0
      
      # Accumlate the data
      sumData = keaRun:accumulate(accumulate,pAcq,sumData,data)


   # get cordinates of the peak, freq and amplitude
      (y2,x2)=  max(mag(spectrum))

       a_m = y2
       f_m = f[x2]

   # measure linewidth 
      LW50 = 1000*:measureLineWidth(50,f,real(spectrum),x2)
      LW10 = 1000*:measureLineWidth(10,f,real(spectrum),x2)

   # plots spectrum

      pd = curplot("1d",1,1)

      pd->draw("false")
      if(freqMag=="yes") 
          pd->plot(f,mag(spectrum))
      else
          pd->plot(f,spectrum,"realcolor",[0,0,0],"imagcolor",[255,0,0])
      endif
      pd->zoom(f_m-dispRange/2,f_m+dispRange/2)
      pd->title("text","spectrum")
      pd->xlabel("text","frequency (kHz)")
      pd->ylabel("text","amplitide")
      pd->draw("true")

   next(scans)

endproc(LW50,LW10)
#------------------------------------------------------------

procedure(fitShim,dx,Ax,shim0,channel,shimMode)
      
   nrPntsX = size(dx)
   center = (dx[nrPntsX-1]+dx[0])/2
   range = dx[nrPntsX-1]-dx[0]
   dx = dx-center
   
   (fit,a0,a1,a2,e0,e1,chq) = polyfit(dx,Ax,2,1,1,"false")        
   fac = 8
   dxNew = [-(fac*nrPntsX-1)/2:1:(fac*nrPntsX-1)/2]*range/(fac*nrPntsX)
   
   fit2 = a0 + a1*dxNew + a2*dxNew^2
   (nada,ind) = min(fit2)
   newxshim = dxNew[ind]

   pd = curplot("1d",4,1)
   lb = pd->title()
   lb->color(blue)
   lb->size(14)
   pd->draw("false")
   pd->plot(dx,Ax,"tracetype","none","symbolshape","square","symbolcolor",black)
   pd->hold("on")
   pd->plot(dxNew,fit2,"tracecolor",red)
   pd->title("text","$channel$shim   OLD:$0.001*round(1000*shim0)$,   NEW:$0.001*round(1000*(newxshim+center))$")
   pd->xlabel("text","\G(D) $channel$shim")
   pd->ylabel("text","LW_($shimMode$)(Hz)")
   pd->hold("off")
   pd->draw("true")

endproc(newxshim+center)
#----------------------------------------------------
procedure(updateShimController,prefLst)

   n = ShimsController:ShimsController() 
   pause(1)
   assignlist(prefLst)
   newPar = ["g0Slider = $xshim$","g0Text = $xshim$"]
   newPar = setlistvalue(newPar,"g1Slider","$yshim$")
   newPar = setlistvalue(newPar,"g1Text"  ,"$yshim$")
   newPar = setlistvalue(newPar,"g2Slider","$zshim$")
   newPar = setlistvalue(newPar,"g2Text"  ,"$zshim$")
   newPar = setlistvalue(newPar,"g3Slider","$z2shim$")
   newPar = setlistvalue(newPar,"g3Text"  ,"$z2shim$")
   newPar = setlistvalue(newPar,"g4Slider","$xzshim$")
   newPar = setlistvalue(newPar,"g4Text"  ,"$xzshim$")
   newPar = setlistvalue(newPar,"g5Slider","$yzshim$")
   newPar = setlistvalue(newPar,"g5Text"  ,"$yzshim$")
   newPar = setlistvalue(newPar,"g6Slider","$x2y2shim$")
   newPar = setlistvalue(newPar,"g6Text"  ,"$x2y2shim$")
   newPar = setlistvalue(newPar,"g7Slider","$xyshim$")
   newPar = setlistvalue(newPar,"g7Text"  ,"$xyshim$")
   setctrlvalues(n,newPar)
   pause(1)
   ShimsController:saveShims()
   closewindow(n)

endproc()
#--------------------------------------------------------
procedure(closeShimController)

# close shim controller
   for k =1 to 100
     try
         if (getwindowpar(k,"title")=="Shims Controller")
           closewindow(k)
         endif
     catch
         exitfor
     endtry
   next k

endproc()
#-----------------------------
procedure(FFTsize,nrPnts)

  m=1
  a = nrPnts
  while(a>1)
     a = nrPnts/2^m
     m = m+1
  endwhile
  r = 2^(m-1)

endproc(r)

