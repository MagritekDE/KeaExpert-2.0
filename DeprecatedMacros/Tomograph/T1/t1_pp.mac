
procedure(pulse_program,dir,mode)


# Interface description (name, label, x, y, control_type, variable_type)
  interface = ["b1Freq",        "B1 Frequency (MHz)",       "0","0",  "tbwv", "freq",
               "repTime",       "Repetition time (ms)",     "0","1.6", "tbwv", "reptime",
               "O1",            "Offset (Hz)",              "0","3",   "tbwv",   "float",
               "a1",            "90 amplitude (dB)",        "1","0", "tb",  "pulseamp",
               "pulseLength",   "rf pulse length (us)",     "1","1", "tb",  "pulselength",
               "deadTime",      "DeadTime (us)",            "1","2", "tb",  "sdelay",
               "gxSpoil",       "Spoil grad x (mT/m)",      "2","0", "tb",  "integer,[-10,10]",
               "gySpoil",       "Spoil grad y (mT/m)",      "2","1", "tb",  "integer,[-10,10]",
               "gzSpoil",       "Spoil grad z (mT/m)",      "2","2", "tb",  "integer,[-10,10]",
               "durSpoil",      "Spoil grad dur (us)",      "2","3", "tb",  "sdelay",
               "t1Est",         "T1 estimation [ms]",       "3","0", "tb",  "sdelay",
               "tMax",          "Max. recov. time [ms]",    "3","1", "tb",  "sdelay",
               "nrPntsT1",      "No of t1 points",          "3","2", "tb",  "integer",
               "index",         "Sampling",                 "3","3", "tm",  "[\"lin\",\"exp\"]"]


# Relationships to determine remaining variable values
   relationships = ["d1 = pulseLength",
                    "rampDur = 200", 
                    "d300 = 4",
                    "n300 = round(rampDur/d300)",
                    "d100 = durSpoil",
                    "n10 = xshim*xcal/1000",
                    "n20 = yshim*ycal/1000",
                    "n30 = zshim*zcal/1000",
                    "n11 = gxSpoil*xcal/1000",
                    "n21 = gySpoil*ycal/1000",
                    "n31 = gzSpoil*zcal/1000",
                    "d2 = deadTime",
                    "w1 = 300",
                    "w3 = round(repTime*1000)",
                    "n2 = nrPnts",
                    "totPnts = nrPnts",
                    "totTime = acqTime"]

# Define the tabs and their order
   tabs = ["Pulse sequence","Acquisition","Processing+Display","File Settings"]

# These parameters will be changed between experiments
   variables = ["w1"]

# dx,dy
   dim = [170,26]

# Pulse sequence
   initpp(dir) # Reset internal parameter list

#------saturation-------
   pulse(mode,a1,p1,d1)    # 90 pulse
   gradramp(x,n10,n11,n300,d300)
   gradramp(y,n20,n21,n300,d300) 
   gradramp(z,n30,n31,n300,d300)   
   delay(d100)
   gradramp(x,n11,n10,n300,d300)
   gradramp(y,n21,n20,n300,d300) 
   gradramp(z,n31,n30,n300,d300) 
   
   wait(w1)                    # recovering delay

#-----detection-------
   pulse(mode,a1,p2,d1)
   delay(d2)
   acquire("overwrite",n2)
   wait(w3)

   lst = endpp() # Return parameter list

# Phase cycle list
    phaseList = [0,0;
                 2,0;
                 2,0]


endproc(lst,tabs,interface,relationships,variables,dim,phaseList)