#########################################################
# 
# SE_2D_DWI
# 
# Slice selective spin-echo imaging
#
# Copyright (c) Magritek Ltd 2014
#
# U.I. V3
#########################################################

procedure(SE_2D_DWI, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   n = :windowdefinition()

   windowvar(wv_dispMode,wv_ctrls,wv_shift,wv_other,wv_rel,
             wv_pp_list,wv_pp_name,wv_var,wv_tabs,wv_phase_list)

   wv_tabs  = ["Pulse Sequence","acquisition","processing+display","File settings"] # Tab names
   wv_ctrls = [2,56,57,80,81,94,95,115,116,125] # Control groups
   wv_shift = [-14,226,466,706,709] # Amount to shift control groups
   wv_other = [124,308,1011]  # Collapse control and window size
   wv_saved = "false"

   (wv_rel,wv_var,wv_pp_list,wv_pp_name,wv_phase_list) = :getseqpar()

   if(nrArgs == 0)
      guipar = "show"
   endif

   keaCtrl:setUp(n,"SE_2D_DWI",getmacropath(),guipar)
   if(guipar == "hide")
      return(n)
   elseif(guipar == "show")
      try; :initGUI(n); catch; endtry;
      showwindow(n)
      return(n)
   else
      setwindowpar(n,"type","dialog")
      guipar = showdialog(n)
      return(guipar)
   endif

endproc()

#########################################################
# 
# Returns important pulse sequence parameters
#
# rel ......... relationship between pulse sequence parameters
# var ......... variable which change during the pulse sequence
# pp_list ..... list of pulse sequence parameters sent to DSP
# pp_name ..... name of DSP pulse program to run
# phase_list .. phase cycling information
#
#########################################################

procedure(getseqpar)

   rel = ["d1 = PulseLength90",
          "d500 = 2",
          "n500 = round(PulseLength90/d500)",
          "(t1,t2,gfac) = B1NutSoft:getRFPulse(SPType,a1,n500)",
          "d2 = PulseLength180",
          "rampDur = 200",
          "d300 = 2.5",
          "n300 = round(rampDur/d300)",
          "d400 = 2.5",
          "n400 = round(rampDiff/d400)",
          "d100 = 100",
          "d101 = 100",
          "d20 = tauDiff",
          "(del9,del99) = SE_2D_DWI:getRewindSliceDelay(PulseLength90,sliceComp,rampDur)",
          "d99=del99",
          "d9=del9",
          "d6   = estTimeR",
          "d3   = 1000*acqTime/2 + d6 - 1.5*rampDur - acqShiftRead",
          "phDur = d3+rampDur+2*0.5*rampDur",
          "d4   = echoTime/2-PulseLength90/2-d101-d9-d99-d3-PulseLength180/2-pgo-7*rampDur-2*rampDiff-d20",
          "d5   = bDelta-4*rampDur-d3-d4-pgo-PulseLength180-2*rampDiff-d20",
          "d7   = echoTime/2-1000*acqTime/2-d6-PulseLength180/2-1*rampDur+rxLat+acqShift-2*rampDiff-d20-d5",
          "n10  = SE_2D_DWI:convertDirToChannel(dirRead)",
          "n20  = SE_2D_DWI:convertDirToChannel(dirPhase)",
          "n30  = SE_2D_DWI:convertDirToChannel(dirSlice)",
          "n40  = SE_2D_DWI:convertDirToChannel(dirDiff)",
          "(gReadAmp,gReadAmpShim,gPhaseAmp,gPhaseAmpShim,gSliceAmp,gSliceAmpShim,sliceOffSet,gDiffAmp,gDiffAmpShim) = SE_2D_DWI:setImageGradients(dirRead,dirPhase,dirSlice,dirDiff,FoVRead,FoVPhase,gradDiffTpm,phDur,sliceTickness,sliceShift,gfac,xshim,yshim,zshim,xcal,ycal,zcal)",
          "n31 =  gSliceAmp+gSliceAmpShim",
          "n31a = gSliceAmpShim",
          "n32  = -gSliceAmp+gSliceAmpShim",
          "n11  =  gReadAmp+gReadAmpShim",
          "n11a =  gReadAmpShim",
          "n12  =  gReadAmp+gReadAmpShim",
          "n12a =  gReadAmpShim",
          "n21  =  -gPhaseAmp+gPhaseAmpShim",
          "n21a =  gPhaseAmpShim",
          "n41  =  gDiffAmp+gDiffAmpShim",
          "n41a =  gDiffAmpShim",
          "f1  =  b1Freq+O1/1e6+sliceOffSet",
          "f2  =  b1Freq+O1/1e6",
          "n1  = nrPnts",
          "totPnts = nrPnts",
          "totTime = acqTime"]
   var = ["n21"]
   pp_list = ["f1","n30","n31a","n31","n300","d300","d100","t1","t2","p1","n500","d500","d99","d101","f2","n32","d9","n40","n41a","n41","n400","d400","d20","n10","n11a","n11","n20","n21a","n21","d3","d4","a2","p2","d2","d5","d7","n12a","n12","d6","n1"]
   pp_name = "SE_2D_DWI.p"
   phase_list = [0,2;1,1;0,2]

endproc(rel,var,pp_list,pp_name,phase_list)


#########################################################
# 
# Provide an interface to this macro which does not
# require the use of the window interface
#
# User must supply a list of parameter (see help file)
# and the pulse program name if different from 
# "$macro$_ext.p"
#
#########################################################

procedure(backdoor, guipar)

   keaCtrl:checkVersion(2.15,1.1)

   (rel,var,pp_list,pp_name,phase_list) = :getseqpar()
  
   (guipar,ppList,pcList,pcIndex,varList) = keaCtrl:initialisePP(getmacropath(),getmacroname(),guipar,rel,var,pp_list,pp_name,phase_list)
   
   r = keaCtrl:runBDPP(guipar,ppList,pcList,pcIndex,varList)

endproc(r)

