#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)

#Checks
   :checkDelays(guipar)
   :checkGradPowerSE_2D_DWI(guipar)
   :checkGradDir(guipar)

# Calculate suitable time and frequency axes
   totalTime = ([0:1:totPnts-1]/totPnts)*totTime*1000
   f = ([0:1:totPnts-1]-totPnts/2+1)/totTime

# Make subplots
   wvPP->multiplot(1,1)
   wvPP2->multiplot(2,2)

# Reset the timer
   time(0)

   kSpace2D = cmatrix(nrPnts,nrStepsP)   


for(nPh= 0 to nrStepsP-1)
 #  pr nPh

   sumData = cmatrix(totPnts)

   grPh =  -round(2*gPhaseAmp/(nrStepsP)*(-(nrStepsP-1)/2+nPh)) + gPhaseAmpShim

   ppList = keaNMR:setPPNumber(ppList,varIndex[0],grPh)

               
# Accumulate scan
      for(scan = 0 to nrScans-1)
     
       # Note the time at scan start
         t1 = time()   
   
       # Set phases for this scan
         (ppList,pAcq) = keaNMR:setPPPhase(ppList,scan,pcList,pcIndex)
   
       # Send phase parameters to DSP
         dspwrite("x",0x00,ppList)
   
       # Collect the data
         (status,data) = keaNMR:getData(totPnts,guipar)

         if(status != "ok")
            keaNMR:enableButtons()
            abort("")
         endif
   
       # Accumlate the data
         sumData = keaNMR:accumulate(accumulate,pAcq,sumData,data)

         if(accumulate=="yes")
            sf = 1/(scan+1)
         else
            sf = 1
         endif

         pd = wvPP->subplot(1,1)
         pd->draw("false")
         pd->plot(totalTime,sf*real(sumData),"tracecolor",black)
         pd->hold("on")
         pd->plot(totalTime,sf*imag(sumData),"tracecolor",red)
         pd->hold("off")
         pd->title("text","Phase step ($nPh+1$/$nrStepsP$)")
         pd->xlabel("text","time (us)")
         pd->ylabel("text","amplitude")
         pd->draw("true")

      # Check timing
         check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
         if(check == "abort")
            return(0)
         elseif(check == "finish")
            scan = scan+1
            nPh = 10000000000
            exitfor()
         endif

      next(scan)

      kSpace2D[~,nPh] = sumData/sf
      image(kSpace2D)

   next(nPh)

   assign("kSpace2D",kSpace2D,"global")



   npxRead  =2*:FFTsize(nrPnts)
   npxPhase =2*:FFTsize(nrStepsP)
   npxPhase = npxRead    

   idata = fft_local:2d(kSpace2D,npxRead,npxPhase,"sinebell","sinebell","FTEcho","FTEcho","yes")
   curplot("2d",2,1)
   image(idata)

   if(saveData == "true")
      :saveData(guipar,kSpace2D,idata)
      keaFiles:incrementExperiment(guipar)
   endif

endproc("execpp")

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,kSpace2D,idata)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")

   export2dpar("ab","binary","xyrc","real","machine","littleend")
   export2d(idata,"rawimage2d.2d")  # Save data as an Excel file

   export2dpar("ab","binary","xyrc","complex","machine","littleend")
   export2d(kSpace2D,"rawkSpace2d.2d")  # Save data as an Excel file

   (n1,n2) = size(idata)

   save("$n1$x$n2$.pixels_image","empty")

   (n1,n2) = size(kSpace2D)

   save("$n1$x$n2$.kspace_size","empty")

   temp = getcwd()

   pr "data saved to $temp$"

# Restore cwd
   cd(bak)

endproc("saveData")
#-----------------------------

procedure(getRewindSliceDelay,PulseLength90,sliceComp,rampDur)
   d99=2
   d9=PulseLength90/2+sliceComp+d99-0.5*rampDur
   if(d9<=0.25)
      d9=2
      d99=d9+0.5*rampDur-PulseLength90/2-sliceComp
   endif
endproc(d9,d99)
#-----------------------------

procedure(setImageGradients,dirRead,dirPhase,dirSlice,dirDiff,FoVRead,FoVPhase,gradDiffTpm,phDur,sliceTickness,sliceShift,gfac,xshim,yshim,zshim,xcal,ycal,zcal)

   guipar = getctrlvalues(0)
   lst = keaNMR:loadPref()
   guipar = guipar + lst
   assignlist(guipar)

   FoVRead = FoVRead/1000             # change from mm to m
   FoVPhase = FoVPhase/1000           # change from mm to m
   sliceTickness = sliceTickness/1000 # change from mm to m
   sliceShift = sliceShift/1000       # change from mm to m


   xshim = xshim/1000
   yshim = yshim/1000 
   zshim = zshim/1000  

   bandwidthRead =  bandwidth*1e3
   if(FoVRead==0)
      gReadAmpTperM=0
   else
      gReadAmpTperM =  bandwidthRead/42.57e6/FoVRead
   endif


   if(dirRead == "x"); ampRead = gReadAmpTperM*xcal; ampReadShim = xshim*xcal; endif
   if(dirRead == "y"); ampRead = gReadAmpTperM*ycal; ampReadShim = yshim*ycal; endif 
   if(dirRead == "z"); ampRead = gReadAmpTperM*zcal; ampReadShim = zshim*zcal; endif 

   bandwidthPhase =  1e6*0.5*nrStepsP/(phDur)
   
   if(FoVPhase==0)
      gPhaseAmpTperM=0
   else
      gPhaseAmpTperM =  bandwidthPhase/42.57e6/FoVPhase
   endif
  
   if(dirPhase == "x"); ampPhase = gPhaseAmpTperM*xcal; ampPhaseShim = xshim*xcal;  endif
   if(dirPhase == "y"); ampPhase = gPhaseAmpTperM*ycal; ampPhaseShim = yshim*ycal; endif 
   if(dirPhase == "z"); ampPhase = gPhaseAmpTperM*zcal; ampPhaseShim = zshim*zcal;  endif

   bandwidthSlice =  gfac*1e6/(PulseLength90)

   if(sliceTickness == 0)
      gSliceTperM =0
   else
      gSliceTperM    =  bandwidthSlice/42.57e6/sliceTickness
   endif

   if(dirSlice == "x"); ampSlice = gSliceTperM*xcal; ampSliceShim = xshim*xcal; endif
   if(dirSlice == "y"); ampSlice = gSliceTperM*ycal; ampSliceShim = yshim*ycal; endif 
   if(dirSlice == "z"); ampSlice = gSliceTperM*zcal; ampSliceShim = zshim*zcal; endif

   sliceOffSet = gSliceTperM*42.57*sliceShift # in MHz


   if(dirDiff == "x"); ampDiff = gradDiffTpm*xcal; ampDiffShim = xshim*xcal; endif
   if(dirDiff == "y"); ampDiff = gradDiffTpm*ycal; ampDiffShim = yshim*ycal; endif 
   if(dirDiff == "z"); ampDiff = gradDiffTpm*zcal; ampDiffShim = zshim*zcal; endif 

#pr ampRead
#pr ampPhase
#pr ampSlice
#
#pr ampReadShim
#pr ampPhaseShim
#pr ampSliceShim
# 
   if(abs(ampRead)>20800);   ampRead = 0; pr "Read gradient too high"; endif
   if(abs(ampPhase)>20800); ampPhase = 0; pr "Phase gradient too high"; endif
   if(abs(ampSlice)>20800); ampSlice = 0; pr "Slice gradient too high"; endif
   if(abs(ampDiff)>23000); ampDiff = 0; pr "Diff gradient too high"; endif


#endproc(0,0,0,0,0,0,0)


endproc(round(ampRead),round(ampReadShim),round(ampPhase),round(ampPhaseShim),round(ampSlice),round(ampSliceShim),sliceOffSet,round(ampDiff),round(ampDiffShim))

procedure(convertDirToChannel,dir)

   if(dir == "x")
        return 3
   endif
   if(dir == "y")
        return 2
   endif
   if(dir == "z")
        return 1
   endif

   if(dir == 3)
        return 3
   endif
   if(dir == 2)
        return 2
   endif
   if(dir == 1)
        return 1
   endif
  
endproc(0)
#-----------------------------
procedure(checkGradPowerSE_2D_DWI,guipar)

   assignlist(guipar)
   refPower=700

   #READ Channel
   p_R=gReadAmp*gReadAmp*((d6+acqTime*1000+rampDur)+(d3+2*rampDur))*1e-6
   
   #PHASE Channel
   p_P=gPhaseAmp*gPhaseAmp*(d3+2*rampDur)*1e-6

   #SLICE Channel
   p_S=gSliceAmp*gSliceAmp*((PulseLength90+d100+d99+rampDur)+(d9+rampDur))*1e-6
   
   #DIFFUSION Channel
   p_D=gDiffAmp*gDiffAmp*2*(d20+rampDiff)*1e-6


   p_mean=(p_R+p_P+p_S+p_D)/repTime  
   

   if (p_mean>refPower)
      pr "Power requirement too high. Increase repetition time. \n"; 
      message("Waring","Power requirement too high.\r Increase repetition time tR > $round(p_mean/refPower*repTime)+1$ ms","warning")
      abort("")
   endif

endproc()
#-----------------------------
procedure(checkDelays,guipar)
   assignlist(guipar)
   for (k=1 to 1000)
      try
         d_temp=eval("d$k$")
         if(d_temp<=0); pr "\n d$k$<0 \n"; abort(""); endif;  
      catch
      endtry         
   next
endproc()
#-----------------------------
procedure(checkGradDir,guipar)
assignlist(guipar)
if(dirPhase==dirRead)
      message("Waring","Phase direction should be \r different from Read direction.","warning")
      abort("")
endif
endproc()

#-----------------------------
procedure(FFTsize,nrPnts)

  m=1
  a = nrPnts
  while(a>1)
     a = nrPnts/2^m
     m = m+1
  endwhile
  r = 2^(m-1)

endproc(r)

procedure(calc_b)

   guipar = getctrlvalues(0)
   assignlist(guipar)

   ee = rampDiff/1e6
   ld = (tauDiff+rampDiff)/1e6
   bd = bDelta/1e6
   b = (gamma*gradDiffTpm)^2*(ld^2*(bd-ld/3)+(1/30)*ee^3-ld*ee^2/6)
   pr b
   
endproc()
