#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)

# Make all gui parameters available
   assignlist(guipar)

# Check for HPA overload
  if((d1 + acqTime*1000)/d2 > 0.05)
     message("error","RF duty cycle > 2%%\rReduce dwell-time","error")
     return
   endif

# Storage for output data
   try
      windowvar(freqAxis,response)
   catch
   endtry

# Calculate suitable frequency axes
  freqAxis = linvec(lowFreq,upFreq,freqSteps)

# Storage for accumulated data
   sumData = cmatrix(totPnts)

# Allocate space for output waveform
  fdata = cmatrix(nrPnts)
  response = matrix(freqSteps)

# Make one subplot
   multiplot("1d",1,1)

# Reset the timer
   time(0)  

# Accumulate scan
   for(n = -1 to nrScans-1)

    # Note the time at scan start
      t1 = time()  

      dspwrite("x",0x00,ppList)

    # Collect the data
      (status,data) = keaNMR:getData(totPnts,guipar)
      if(status != "ok")
         :exitProc()
         return(0)
      endif
   
      if(n >= 0) # The first scan won't be displayed as this sets the relay

       # Accumlate the data
         sumData = mag(keaNMR:accumulate(accumulate,0,sumData,data))

       # Graph the data
         :graphData(sumData/nrPnts,single(freqAxis),n,guipar)
   
      # Check timing
         check = keaRun:checkTimeAndAbort(guipar,t1,n,pcList,"ignoreLastScan")
         if(check == "abort")
            :exitProc()
            return(0)
         elseif(check == "finish")
            n = n+1
            exitfor()
         endif

      endif

   next(n)

   keaNMR:titleReset()

# Save the data
   if(saveData == "true")
     :saveData(guipar,single(freqAxis),response)
   endif

# Increment the experiment number
   keaNMR:incrementExperiment(incExpNr)

# Reset directional coupler relay (if any)
   :exitProc()

   return(freqAxis,response)

endproc("execpp")


#######################################################
# Save the accumulated time domain data.
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,freqAxis,response)

# Extract GUI parameters
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")
   save("plot.pt1")       # Save plot
   export1dpar("ab","ascii","xyrc","xydata","delimiter","comma")
   response = response/(nrPnts*nrScans)
   export1d(freqAxis,response,"response.csv")  # Save fid as an excel file
   save("data.emf","emf1d")

# Output information to the CLI
   pr "\n   1D plot saved to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\plot.pt1"
   pr "\n   1D ascii file saved to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\response.csv"
   pr "\n   Picture file saved to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\data.emf\n"

# Restore cwd
   cd(bak)

endproc("saveData")


#######################################################
# Reset the directional coupler relays to normal mode
#######################################################

procedure(exitProc,guipar)

   dir = getcwd()
   cd("$appdir$\\Macros\\Kea-Core\\resetDSP")
   pp = dspreadpp("reset.p")
   dspwrite("p",0x2000,pp,wvPort)
   dsprunpp(0x2000,wvPort)
   cd(dir)

endproc()


###################################################################
#
# Graph the signal in the time domain
#
# Input: fidData ........ signal
#        t .............. time domain vector
#        n .............. number of scans accumulated
#        guipar ......... parameters extracts from dialog 
#
###################################################################

procedure(graphData,fidData,f,n,guipar)

   assignlist(guipar)

# Allow for accumulations
   if(accumulate == "yes")
      sf = 1/(n+1)
   else
      sf = 1
   endif

# Select units
   if(wvUnits == "uV")
      sf = sf * 1000
      timeUnits = "\G(m)V"
      freqUnits = "\G(m)V/kHz"
      ampMin = wvTimeMin
      ampMax = wvTimeMax
   else
      timeUnits = "mV"
      freqUnits = "mV/kHz"
      ampMin = wvTimeMin/1000
      ampMax = wvTimeMax/1000
   endif

# Select y label
   if(wvApplyPreampFactor == "yes")
      yTxt = "Probe output amplitude"
   elseif(wvApplyRxampFactor == "yes")
      yTxt = "Rx Amp input amplitude"
   else
      yTxt = "Transceiver input amplitude"
   endif

   drawplot("false")

    # Display time domain data
      curplot("1d",1,1)  

    # Find minimum
      dat = mag(fidData*sf)
      (val,x) = min(dat)
      plot(f,mag(fidData*sf))
      title("text","Frequency sweep response (minimum at $f[x],2.2f$ MHz)","size",12)
      xlabel("text","Frequency (MHz)","size",12)
      ylabel("text","$yTxt$ ($timeUnits$)","size",12)
      axes("fontsize",11)

      if(fixedAmp == "yes")
         if(logScale == "no")
            axes("ymapping","lin")
            zoom1d(min(f),max(f),0,maxAmp)
         else
            axes("ymapping","log")
            zoom1d(min(f),max(f),maxAmp/(10^nrDecades),maxAmp)
         endif
      endif

   drawplot("true")


endproc()


