procedure(profiles)

   n = :windowdefinition()
   setwindowpar(n,"exit_procedure",":saveLastPar()")
   :loadLastPar(n)
   :enableContrastPar(n)
   :enableNorm(81,82,83)

# Cache all proc calls
   keaNMR:initCache(getmacropath(),"CPMGFast")

   showwindow(n) 

endproc()
#--------------------------------------

procedure(windowdefinition)

   # Automatically generated window definition procedure.
   # Any code added manually will be removed if layout modified interactively
   n = window("Profiles", -1, -1, 485, 286)

      # Define all controls with basic parameters
      statictext(1, 410, 195, "right", "Warn")
      statictext(2, 234, 37, "right", "Contrast1")
      checkbox(3, 424, 160, "no,yes", "no")
      button(4, 176, 238, 47, 21, "Help",
         help("Kea");)
      statictext(5, 52, 199, "right", "directory")
      statictext(6, 60, 215, "right", "Exp. name")
      textbox(7, 240, 34, 60,
        :setParContrast1();)
      statictext(8, 234, 62, "right", "Contrast2")
      textbox(9, 240, 58, 60,
        :setParContrast2();)
      textbox(10, 240, 82, 60,
        :setParContrast3();)
      statictext(11, 234, 86, "right", "Contrast3")
