      groupbox(37, "", 5, 0, 464, 182)
      button(38, 62, 238, 47, 21, "Stop")
      statictext(39, 285, 116, "right", "Weight function")
      textbox(40, 240, 130, 60,
        :setParAmpIni();)
      textbox(41, 424, 58, 40)
      statictext(42, 416, 62, "right", "Step size (um)")
      statictext(43, 230, 134, "right", "Amp. ini.")
      statictext(44, 230, 158, "right", "Amp. fin.")
      textbox(45, 240, 155, 60,
        :setParAmpFin();)
      statictext(46, 249, 315, "right", "Number of points")
