procedure(setParContrast1,n)

     if(nrArgs==0);  n=0; endif
     if (n==-1); return;  endif

     guipar = getctrlvalues(n)
     assignlist(guipar)

     (echoIni,echoFin)=:extractEchoIniFin(parContrast1)

     if((echoIni==-1)|(echoFin==-1))
        message("Error!!!","Wrong value for contrast parameters 1.","error")
        return(1)
     endif

     obj = findobj(n,"name","parContrast1")
    
     if(echoIni > nrEchoes)
       setpar(n,obj,"enable","false")
       message("Error!!!","Initial echo > total number of echoes.","error")
       echoIni = 1 
       templist = [" parContrast1 = 1,$echoFin$"]
       assignlist(templist)
       setctrlvalues(n,templist)
       setpar(n,obj,"enable","true")
       return(1)
     endif

     if(echoFin > nrEchoes)
       setpar(n,obj,"enable","false")
       message("Error!!!","Final echo > total number of echoes.","error")
       echoFin = nrEchoes
       templist = [" parContrast1 = $echoIni$,$nrEchoes$"]
       assignlist(templist)
       setctrlvalues(n,templist)
       setpar(n,obj,"enable","true")
       return(1)
     endif

     if(echoIni > echoFin)
       setpar(n,obj,"enable","false")
       message("Error!!!","Final echo < initial echo.","error")
       echoIni = 1
       templist = [" parContrast1 = 1,$echoFin$"]
       assignlist(templist)
       setctrlvalues(n,templist)
       setpar(n,obj,"enable","true")
       return(1)
     endif
   
endproc(0)
