#----------------------------------------------
procedure(extractEchoIniFin,parContrast)

# seachs for the comma     
     stringSize = 0
     c          = 1
     commaPos   = 0 

     while(c==1)
       try
         a = parContrast[stringSize]
         if(a==","); commaPos = stringSize; endif;
         stringSize=stringSize+1  
       catch
         c=0
       endtry
     endwhile

# calculates Echo initial
    
    echoIni=0
    try
     for(m=0 to commaPos-1 )
       echoIni = echoIni + eval(parContrast[m])*10^((commaPos-1)-m)
     next(m)
    catch
      echoIni = -1
    endtry
 
# calculates Echo final
     echoFin=0
   try
     for(m=commaPos+1 to stringSize-1 )
       echoFin = echoFin + eval(parContrast[m])*10^((stringSize-1)-m)
     next(m)
   catch
      echoFin = -1
   endtry

endproc(echoIni,echoFin)

#-----------------------
procedure(enableContrastPar,n)

      obj = findobj(n,"name","enableContrast2")
       if(0==getpar(n,obj,"value"))
           obj = findobj(n,"name","parContrast2")
           setpar(n,obj,"enable","false") 
       endif

       obj = findobj(n,"name","enableContrast3")
       if(0==getpar(n,obj,"value"))
           obj = findobj(n,"name","parContrast3")
           setpar(n,obj,"enable","false") 
       endif
 
       obj = findobj(n,"name","enableW")
       if(0==getpar(n,obj,"value"))
           obj = findobj(n,"name","parAmpIni")
           setpar(n,obj,"enable","false")
           obj = findobj(n,"name","parAmpFin")
           setpar(n,obj,"enable","false")  
       endif
endproc()

#-----------------------
procedure(Move,y)

   bak = getcwd()
   cd(getmacropath())
   cd("LiftControl")

   if(y > 0)
      slowSteps = trunc((y-50*trunc(y/50))/10)
      MoveUpFast(trunc(y/50),70,0)
      MoveUp(slowSteps,70,0)
   else
      slowSteps = trunc((-y-50*trunc(-y/50))/10)
      MoveDownFast(trunc(-y/50),70,0)
      MoveDown(slowSteps,70,0)
   endif

   cd(bak)
  
endproc()
#--------------------------------------------------
procedure(saveLastPar)

    guipar = getctrlvalues(0)
    assignlist(guipar)
    dir = getmacropath()
    name = getwindowpar(0,"macroname")
    name = rmext(name)
    back =  getcwd()
    cd(dir)
    save("$name$LastExp.par",guipar)
   
    cd(back)
   

endproc()
#----------------------------------------------------
procedure(loadLastPar,n)
   
    name = getwindowpar(n,"macroname")
    name = rmext(name)
    dir = getwindowpar(n,"macropath")
    back =  getcwd()
    cd(dir)

    if(isfile("$name$LastExp.par"))
       guipar = load("$name$LastExp.par")
       setctrlvalues(n,guipar)  
    else
       message("Warning!!!","File with initital parameters not found","info")
    endif

    dir = getwindowpar(n,"macropath")
    spacerDir=dir+"\probeHeads"
       
    setcwd(spacerDir)
    probeHeadPar = load("selectedProbeHead.par")
    assignlist(probeHeadPar)
    setpar(n,22,"text",Spacer)
    setctrlvalues(n,probeHeadPar)
    setcwd(back)

endproc()

#-----------------------
procedure(checkOverwrite)

   guipar = getctrlvalues(0)
   assignlist(guipar)
 
   if (warnOverwrite=="no"); return 0; endif

   back = getcwd()
   cd(dataDirectory)
   cd(expName)
   cd("$expNr$")



   if ((fileinfo("$expName$.dat"  ,"age")<1e20)
     |(fileinfo("$expName$.txt"  ,"age")<1e20)
     |(fileinfo("$expName$.1d"   ,"age")<1e20)
     |(fileinfo("$expName$.2d"   ,"age")<1e20)
     |(fileinfo("$expName$01.txt","age")<1e20)
     |(fileinfo("$expName$01.1d" ,"age")<1e20)
     |(fileinfo("$expName$01.2d" ,"age")<1e20))

      if( "no"== query("Warning","The file $expName$ already exits, would you like to overwrite it?")) 
        cd(back)
        return(1)
      endif
   endif 

   cd(back)
   
endproc(0)
#--------------------------------------------
procedure(enableNorm,start,end,check)

   status = getpar(0,check,"value")

   if(status==1)
      for(k = start to end)
         setpar(0,k,"enable","true")
      next(k)
   else
      for(k = start to end)
         setpar(0,k,"enable","false")
      next(k)
   endif

endproc()
