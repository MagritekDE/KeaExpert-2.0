      checkbox(13, 303, 63, "no,yes", "no",
           :setEnableContrast2();)
      checkbox(14, 303, 88, "no,yes", "no",
           :setEnableContrast3();)
      checkbox(15, 302, 116, "no,yes", "no",
           :setEnableW();)
      statictext(16, 107, 315, "right", "best resolution")
      textbox(17, 113, 310, 40)
      statictext(18, 249, 287, "right", "Echotime0")
      textbox(19, 260, 282, 40)
      textbox(20, 121, 10, 40,
        :setResolution();)
