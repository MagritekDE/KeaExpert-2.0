procedure(selectProbeHead)
   
    if(nrArgs==0);  n=0; endif
    if (n==-1); return;  endif
    

   back = getcwd()

   dir = getwindowpar(n,"macropath")
   spacerDir=dir+"\probeHeads"
       
   setcwd(spacerDir)
   probeHeadPar = load("selectedProbeHead.par")
   assignlist(probeHeadPar)
   
   setctrlvalues(n,probeHeadPar)
   setpar(n,22,"text",Spacer)

   setcwd(back)
   message("","New probe head parameters has been loaded","info") 

endproc()
#------------------------
procedure(setResolution,n)

    if(nrArgs==0);  n=0; endif
    if (n==-1); return;  endif    
 
    guipar = getctrlvalues(n)
    assignlist(guipar)
    obj = findobj(n,"name","resolution")
    
    try
     a = resolution/1
    catch
       setpar(n,obj,"enable","false")
       message("Error !!!","Resolution must be a number.","error")
       templist = [" resolution = $bestResol$"]
       assignlist(templist)
       setctrlvalues(n,templist)
       setpar(n,obj,"enable","true")
       return(1)
    endtry
 
    if (resolution < bestResol)
       setpar(n,obj,"enable","false")
       message("Warning !!!","Resolution < resolution limit ($bestResol$ um)","info")
       templist = [" resolution = $bestResol$"]
       assignlist(templist)
       setctrlvalues(n,templist)
       setpar(n,obj,"enable","true")
       return(1)
    endif

   sliceThickness = 10*round(1e6/(pulseLength*gradient)/10)
   if (resolution > sliceThickness)
       setpar(n,obj,"enable","false")
       message("Warning !!!","Resolution > excited slice thickness ($sliceThickness$ um).","info")
       templist = [" resolution = $sliceThickness$"]
       assignlist(templist)
       setctrlvalues(n,templist)
       setpar(n,obj,"enable","true")
       return(1)
   endif



   dw       = 0.5
   nrPnts   = round(1e6/(gradient*dw*resolution))
   echoTime = echoTime0 + round(dw*nrPnts)-pulseLength
   
   templist = mkparlist()
   setctrlvalues(n,templist)

endproc(0)
