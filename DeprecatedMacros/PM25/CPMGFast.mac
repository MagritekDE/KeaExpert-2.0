#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)
 guipar = guipar + "timeMag = \"no\""

# Make all gui parameters available
   assignlist(guipar)

# Do some safety checks
   if(d1 < 1 | d2 < 1 | d3 < 0.1)
      message("Error","Pulse sequence timing error!\rReduce acquisition time or increase echotime.","error")
      return(0)
   endif

   if(d4-keaRun:getAcqTime(guipar)<0.1)
      message("Error","Pulse sequence timing error!\rReduce acquisition time or increase echotime.","error")
      return(0)
   endif

# Check for total RF duty cycle
# for PM25----------------------------------------------
      # if(pulseLength*nrEchoes/repTime>1.6)
# for PM5----------------------------------------------
        if(pulseLength*nrEchoes/repTime>3)
      message("Error","RF duty cycle is too high, reduce nrEchoes or increase repTime","error") 
      return(0)
     endif
# Check for p.s. duty cycle should be < 20%
  if(d1/(echoTime) > 0.30)
      message("Error","Duty cycle is too high in pulse sequence!\rshould be < 30%\rIncrease echo time\ror reduce pulse length.","error")
      return(0)
   endif

# Allocate data for outputs
   sumData = cmatrix(totPnts)
   sumDataAP = cmatrix(totPnts)
   fitTxt = ""

# Calculate a suitable time axis
   tAxis = ([0:1:totPnts-1]/totPnts)*totTime + echoTime

# Make plot regions. wvPP is the current-plot's parent
  try
  if(excecutedBackdoor=="yes")
  ppBack = curplot("1d")->parent()
  prt  = ppBack->subplot(1,1)
  nrExp=1
   nrEchoesCut=0
  endif
  catch
   excecutedBackdoor="no"   
   

   pri = null
   prn = null
   if(fitType == "nnls")
    (prt,pri,prn) = wvPP->multiplot(3,1)
   elseif(fitType == "none")
     prt = wvPP->multiplot(1,1)
   else
     (prt,pri) = wvPP->multiplot(2,1)
   endif

  endtry

#-- Loop for Nr of Exp ----------------
for(nexp=0 to nrExp-1)
    # reset sumData
        echoData = cmatrix(totPnts)
        sumData = cmatrix(totPnts)
 guipar = setlistvalue(guipar,"expNr","$expNr$")

 

# Reset the timer
   time(0)  

# Accumulate scan
   for(scan = 0 to nrScans-1)

    # Note the time at scan start
      t1 = time()   
     
    # Set phases for this scan
      (ppList,pAcq) = keaRun:setPPPhase(ppList,scan,pcList,pcIndex)

    # Send phase parameters to DSP
      dspwrite("x",0x00,ppList,wvPort)

    # Collect the data
      (status,data) = keaRun:getData(totPnts,guipar)
      if(status != "ok")
         return(0)
      endif

   # Accumlate the data
         sumData = keaRun:accumulate(accumulate,pAcq,sumData,data)

            if(autoPhase == "yes")
               (ph,sumDataAP) = keaRun:autoPhase(sumData/nrPnts,phaseMethod)
            else
               sumDataAP = sumData/nrPnts
            endif
            sumDataAP=sumDataAP/refSignal



 # remove first points if desired
     
        nrEchoesFit = nrEchoes-nrEchoesCut
        tAxisFit    = submatrix(tAxis,nrEchoesCut,nrEchoes-1)
        sumDataAPFit = submatrix(sumDataAP,nrEchoesCut,nrEchoes-1)
  

   # Plot the integrals
        if(fitType == "none" | fitMode == "manual")
   
           
              keaPlot:graphTime(prt,tAxisFit/1000,sumDataAPFit,scan,guipar,
                               "Echo integrals SCANS","Time (ms)","Average echo amplitude (\G(m)V)")

         else
   
            if(scan >= 0  & ((scan+1) % size(pcList) == 0)) # Only display fit after full phase cycle.
           
         
               keaPlot:graphTime(prt,tAxisFit/1000,sumDataAPFit,scan,guipar,
                                "Echo integrals","Time (ms)","Average echo amplitude (\G(m)V)")
   
            # Do a fit if requested
               rData = real(sumDataAPFit)/(scan+1)
               fitTxt = :DisplayFit(pri,prn,tAxisFit,rData,nrEchoesFit,guipar)
   
            endif # Full phase cycle
   
         endif # Fit type

    

   # Check timing
     check = keaRun:checkTimeAndAbort(guipar,t1,scan,pcList)
     if(check == "abort")
        return(0)
     elseif(check == "finish")
        scan = scan + 1
        exitfor()
     endif

   next(scan)


# Print result
   if(fitTxt != "")
     pr("$fitTxt$")
   endif
 setpar
# Save the data
   keaFiles:save1DData(guipar,tAxis/1000,sumDataAP/scan)
   keaFiles:incrementExperiment(guipar)
   expNr=expNr+1
next(nexp)
# Return result structure when called from backdoor
   result = struct()
   result->tx = tAxisFit/1000
   result->ty = sumDataAPFit/scan

   return(result)

endproc("execpp") # Don't remove argument


###################################################################
#
# Display the passed data points and a fitted t2 curve
#
# Parameters are:
# x ........ the time array
# y ........ the amplitude arrays
# N ........ the number of data points to plot
# guipar ... GUI parameter list
#
###################################################################
 

procedure(DisplayFit,pri,prn,x,y,N,guipar)

  assignlist(guipar)

   if(fitType == "nnls")
      result = :ILFit(pri,prn,x/1000,y,N,guipar)
   else
      result = keaPlot:fitAndGraph(pri,x/1000,real(y),N,fitType,null,
                                   "Time (ms)","Echo integral (UNITS)",
                                   "Echo attenuation data",
                                   "Fit result: RESULT",guipar)

  endif

endproc(result)


###################################################################
#
# Display the passed data points and a fitted relaxation curve
# and relaxation spectrum
#
# Parameters are:
# x ....... the time array
# y ....... the amplitude arrays
# N ....... the number of data points to plot
# guipar ... GUI parameter list
#
###################################################################
 
procedure(ILFit,pri,prn,x,y,N,guipar)

   assignlist(guipar)

   if(N > 100)
     x_steps = 100    
     (timeDat,yData) = pseudologbin(x,y,100)
   else
     timeDat = x
     yData   = y
     x_steps = N-1
   endif


# Invert meaning of alpha and reduce range
   alpha = 10^(8-log10(alpha))

   guipar = guipar + ["exp_type = \"exp(-t/T)\"",
          "designMat = \"exp(-xData'*(1/xSpec))\"",
          "alpha = $alpha$",
          "logBin = \"true\"",
          "weightBins = \"true\"",
          "x_steps = $x_steps$"]

# Invert using Lawson and Hanson inverstion
   (specX,specY) = LHInvert(x,y,guipar)

# Get fit parameters
  (fit,chisq) = LHInvert:calcFit("exp(-t/T)",specX,specY,x,y)

# Plot original data with L&H fit
   keaPlot:graphXYFit(pri,x,y,fit,null,size(x),
                      "Time (ms)","Average echo amplitude (UNITS)","Echo attenuation data (with IL fit)",guipar)

   guipar = guipar + ["xMap = \"log\"",
                      "traceCol = $wvSpectrumColor$",
                      "symbolShape = \"none\""]

# Plot the spectrum
   keaPlot:graphXY(prn,specX,specY,null,size(specX),
                      "log_(10)(T) ms","Amplitude","Relaxation Spectrum",guipar)

endproc("")


###################################################################
#
# Apply a fit to the data set by pressing the fit button
#
###################################################################
 
procedure(applyFit)

   guipar = getctrlvalues(0)
   assignlist(guipar)

# If GUI has been run without collecting data first
# then need to load in various Kea parameters
   if(isvar("wvPP") == 0)
      wvPP = curplot("1d")->parent
      par = keaFiles:loadPref()
      assignlist(par)
      wvDataSymbolColor = dataSymbolColor
      wvDataSymbolShape = dataSymbolShape
      wvFitCurveColor = fitColor
      wvSpectrumColor = spectrumColor
      wvUnits = units
      guipar = mergelists(guipar,par)    
   endif

   curplot("1d",1,1)

# Get raw CPMG data
   (x,y) = getplotdata("1d")

# Autophase if requested
   if(autoPhase == "yes")
     (txt,lx,ly) = 1dpar:get()
      (ph,y) = keaRun:autoPhase(y,phaseMethod)
      plot(x,y)
      1dpar:set(txt,lx,ly)
      n = findobj(0,"name","rxPhase")
      phOld = getpar(0,n,"value")
      setpar(0,n,"text",phOld+ph)
   endif

   N = size(x)

# Get the current plot organisation
   (dim,nx,ny) = multiplot()

# Do the requested fit
   if(fitType == "nnls")
      if(nx != 3)
        plotData = :savePlots(nx)
        multiplot("1d",3,1)
        :restorePlots(plotData,nx)
      endif
      pri = curplot("1d",2,1)
      prn = curplot("1d",3,1)
      result = :ILFit(pri,prn,x,real(y),N,guipar)
   elseif(fitType == "none")
        plotData = :savePlots(1)
        multiplot("1d",1,1)
        :restorePlots(plotData,1)
        result = ""
   else
      if(nx != 2)
        plotData = :savePlots(nx)
        multiplot("1d",2,1)
        :restorePlots(plotData,nx)
      endif
      pri = curplot("1d",2,1)
      result = keaPlot:fitAndGraph(pri,x,real(y),N,fitType,null,
                                   "Time (ms)","Echo integral (UNITS)",
                                   "Echo attenuation data",
                                    "Fit result: RESULT",guipar)
   endif

# Print result
  if(result != "")
    pr("$result$")
   endif

endproc()

# Save first two plots
procedure(savePlots,n)

   curplot("1d",1,1)
   (x1,y1) = getplotdata("1d")
   (txt1,lx1,ly1) = 1dpar:get()

   if(n > 1)
      curplot("1d",2,1)
      (x2,y2) = getplotdata("1d")
      (txt2,lx2,ly2) = 1dpar:get()
   endif
   plotData = struct("local")

endproc(plotData)

# Restore first two plots
procedure(restorePlots,plotData,n)

   assignstruct(plotData,"local")
   
   draw1d("false")
   curplot("1d",1,1)
   plot(x1,y1)
   1dpar:set(txt1,lx1,ly1)
   if(n > 1)
      try
         curplot("1d",2,1)
         plot(x2,y2)
         1dpar:set(txt2,lx2,ly2) 
      catch
      endtry
   endif
   draw1d("true")

endproc()
