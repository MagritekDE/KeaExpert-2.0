      textbox(39, 103, 106, 40)
      statictext(40, 225, 49, "right", "Exp.")
      statictext(40, 225, 62, "right", "number")
      textbox(41, 235, 54, 58)
      button(42, 307, 54, 21, 20, "...",
         keaFiles:setExpNr();)
