      statictext(20, 287, 213, "right", "Max")
      textbox(21, 136, 210, 43)
      statictext(22, 214, 215, "right", "Min")
      textbox(23, 138, 244, 43)
      groupbox(24, "Alpha Loop", 192, 146, 150, 122)
      statictext(25, 47, 168, "right", "Alpha")
      textbox(26, 54, 163, 44)
      textbox(27, 134, 163, 45)
      statictext(28, 127, 168, "right", "Beta")
      button(29, 273, 161, 60, 29, "Run Loop",
