###################################################################
# Perform a 1D non-negative least squares fit on an ascii x-y data set
# (Fits to an exp(-at) type distribution)
####################################################################

procedure(nnls1dfede)

   n = :windowdefinition()
   :load_parameters()

   showwindow(n)

endproc()


procedure(windowdefinition)

   # Automatically generated window definition procedure.
   # Any code added manually will be removed if layout modified interactively
   n = window("NNLS 1D", -1, -1, 451, 312)

      # Define all controls with basic parameters
      windowvar(dir,wv_xdata,wv_ydata,wv_xlabel,wv_ylabel,wv_title,wvExpDir,wv_relaxAxis,wv_spectrum,wv_fit,wv_error)
      statictext(1, 55, 17, "right", "Working")
      statictext(1, 55, 30, "right", "Directory")
      textbox(2, 69, 22, 220)
      button(3, 307, 22, 21, 20, "...",
         :setWorkingDir();)
      statictext(4, 55, 49, "right", "Exp.")
      statictext(4, 55, 62, "right", "Name")
      textbox(5, 69, 54, 82)
      button(6, 165, 54, 21, 20, "...",
         :setExpName();)
      textbox(7, 293, 237, 43)
      textbox(8, 293, 210, 43)
      textbox(9, 221, 210, 43)
      button(10, 362, 110, 51, 29, "Execute",
         :process_data();)
