#######################################################
# Execute the pulse program, collecting nrScans of 
# data and displaying the result in the 1D plot. 
#
# This procedure can be modified to perform more
# complex functions using the passed parameters:
#
# guipar ..... all parameters from the user interface
# ppList ..... the pulse program parameter list
# pcList ..... phase-cycle list
# pcIndex .... indices of phase parameters in ppList
# varIndex ... indices of variable parameters in ppList
#
#######################################################

procedure(execpp,guipar,ppList,pcList,pcIndex,varIndex)


# Make all gui parameters available
   assignlist(guipar)

   try
    a = steps
   catch
    steps = 1
   endtry
   try
    a = totPnts
   catch
    totPnts = 1
   endtry

   try
    a = n
   catch
    n = -1
   endtry

       # Set phases for this scan
     #    (ppList,pAcq) = keaNMR:setPPPhase(ppList,0,pcList,pcIndex)
      
       # Send phase parameters to DSP
         dspwrite("x",0x00,ppList)
for(s = 0 to steps-1)

        status = dsprunpp(0x2000,1)

   modir=getlistvalue(guipar,"modir")
   
   d50=0.35   #old 0.85
   d10=0.25   #old 0.25

   if(modir=="1") 
      p=p + 50
      pause(d50)  
   endif
   if(modir=="2")
      p=p + 10 
      pause(d10)
   endif
   if(modir=="3")
      p=p - 50 
      pause(d50)
   endif
   if(modir=="4") 
      p=p - 10 
      pause(d10)
   endif

    if(n!=-1) 
           setpar(0,n,"text","position = $p$ um")
    endif
 

next(s)
  

endproc("execpp")

#######################################################
# Save the accumulated data
# Either pass the parameters to save or use
# window variables of the same name.
#######################################################

procedure(saveData,guipar,scans,totalTime,sumData)

# Make all gui parameters available
   assignlist(guipar)

# Save data and plot in chosen folder
   bak = getcwd()
   cd(dataDirectory)
   mkdir(expName)
   cd(expName)
   mkdir("$expNr$")
   cd("$expNr$")
   save("data.1d",sumData/(scans+1))    # Save data in Prospa format
   save("data.pt1")                     # Save plot
   save("data.emf","emf1d")             # Save plot as picture
   n = size(sumData)
   m = matrix(3,n)
   m[0,~] = (totalTime/1000)'
   m[1,~] = real(sumData/(scans+1))'
   m[2,~] = imag(sumData/(scans+1))'
   export2dpar("ab","ascii","xyrc","real","delimiter","comma")
   export2d(m,"data.csv")  # Save data as an Excel file

# Output information to the CLI
   pr "\n   Binary Echo data saved to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\data.1d"
   pr "\n   Ascii Echo data saved to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\data.csv"
   pr "\n   1D plot save to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\data.pt1\n"
   pr "\n   1D plot picture save to:"
   pr "\n     $dataDirectory$\\$expName$\\$expNr$\\data.emf\n"

# Restore cwd
   cd(bak)

# Increment the experiment number
   keaNMR:incrementExperiment(incExpNr)

endproc("saveData")


